<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adrianwedd.youtube-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/adrian/repos/adrianwedd.com/scripts/check-youtube-operations.py</string>
    <string>--json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/adrian/repos/adrianwedd.com</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/adrian/Library/Logs/adrianwedd-youtube-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adrian/Library/Logs/adrianwedd-youtube-monitor.err.log</string>
</dict>
</plist>
