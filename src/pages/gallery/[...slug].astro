---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ShareButton from '../../components/islands/ShareButton';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';
import { slug, imageSlug, ogSafeImage } from '../../lib/utils';
import { getImageDimensions } from '../../lib/image-dimensions';

export async function getStaticPaths() {
  const galleries = (await getCollection('gallery')).filter((g) => !g.data.draft);
  return galleries.map((gallery) => ({
    params: { slug: slug(gallery.id) },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const collectionSlug = slug(gallery.id);
const { Content } = await render(gallery);

// OG image: swap .webp -> .jpg (FB / X / LinkedIn / iMessage don't reliably
// render WebP og:image scrapes) and read the real dimensions at build time.
const ogImage = gallery.data.coverImage ? ogSafeImage(gallery.data.coverImage) : undefined;
const ogDimensions = ogImage ? getImageDimensions(ogImage) : null;

const allGalleries = (await getCollection('gallery'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = allGalleries.findIndex((g) => g.id === gallery.id);
const prevGallery = currentIndex < allGalleries.length - 1 ? allGalleries[currentIndex + 1] : null;
const nextGallery = currentIndex > 0 ? allGalleries[currentIndex - 1] : null;
---

<BaseLayout
  title={gallery.data.title}
  description={gallery.data.description || `Gallery: ${gallery.data.title}`}
  image={ogImage}
  imageWidth={ogDimensions?.width}
  imageHeight={ogDimensions?.height}
  type="article"
  tags={gallery.data.tags}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ImageGallery',
      name: gallery.data.title,
      description: gallery.data.description || `Gallery: ${gallery.data.title}`,
      url: new URL(Astro.url.pathname, Astro.site).href,
      datePublished: gallery.data.date.toISOString(),
      image: gallery.data.images.map((img: { src: string; alt: string; caption?: string }) => ({
        '@type': 'ImageObject',
        contentUrl: new URL(img.src, Astro.site).href,
        name: img.alt,
        ...(img.caption ? { caption: img.caption } : {}),
      })),
      keywords: gallery.data.tags,
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
    })}
  />
  <article class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Gallery', href: '/gallery/' }, { label: gallery.data.title }]}
    />
    <header class="mb-10 max-w-3xl">
      <h1 class="text-text">{gallery.data.title}</h1>
      {
        gallery.data.description && (
          <p class="text-text-muted mt-4 text-lg leading-relaxed">{gallery.data.description}</p>
        )
      }
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {
          gallery.data.tags.map((tag: string) => (
            <a
              href={`/gallery/tag/${tag}/`}
              class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent rounded-full px-2.5 py-0.5 text-xs no-underline transition-colors"
            >
              {tag}
            </a>
          ))
        }
        <span class="ml-auto">
          <ShareButton title={gallery.data.title} url={`/gallery/${collectionSlug}/`} client:idle />
        </span>
      </div>
    </header>

    {/* Narrative text */}
    <div
      class="prose prose-headings:text-text prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-strong:text-text prose-code:text-text-accent prose-li:text-text mb-10 max-w-3xl"
    >
      <Content />
    </div>

    {/* Image grid */}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="gallery-grid">
      {
        gallery.data.images.map((image: { src: string; alt: string; caption?: string }, index: number) => (
          <a
            href={`/gallery/${collectionSlug}/${imageSlug(image.alt)}/`}
            class="gallery-trigger hover:border-accent/50 group border-border block w-full overflow-hidden rounded-lg border no-underline transition-all"
            data-index={index}
          >
            <div class="img-placeholder aspect-[4/3] overflow-hidden">
              <Picture
                src={image.src}
                width={600}
                height={450}
                widths={[300, 600, 900]}
                formats={['avif', 'webp']}
                alt={image.alt}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            {image.caption && <p class="text-text-muted p-2 text-xs">{image.caption}</p>}
          </a>
        ))
      }
    </div>

    <Lightbox images={gallery.data.images} />

    <RelatedContent
      currentTags={gallery.data.tags}
      currentId={gallery.id}
      currentDate={gallery.data.date}
      contentType="gallery"
    />

    <nav class="border-border mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2" aria-label="Previous and next collections">
      {
        prevGallery ? (
          <a
            href={`/gallery/${slug(prevGallery.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors"
          >
            <span class="text-text-muted text-xs">&larr; Previous</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {prevGallery.data.title}
            </span>
          </a>
        ) : (
          <a href="/gallery/" class="text-text-muted hover:text-accent flex items-center text-sm transition-colors">
            &larr; All collections
          </a>
        )
      }
      {
        nextGallery && (
          <a
            href={`/gallery/${slug(nextGallery.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors sm:text-right"
          >
            <span class="text-text-muted text-xs">Next &rarr;</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {nextGallery.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
