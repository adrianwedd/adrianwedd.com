---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ShareButton from '../../../components/islands/ShareButton';
import { getCollection } from 'astro:content';
import { slug, imageSlug, ogSafeImage, tagSlug } from '../../../lib/utils';
import { getImageDimensions } from '../../../lib/image-dimensions';

interface ImageData {
  src: string;
  alt: string;
  caption?: string;
}

export async function getStaticPaths() {
  const galleries = (await getCollection('gallery')).filter((g) => !g.data.draft);
  const paths: Array<{
    params: { collection: string; image: string };
    props: {
      gallery: (typeof galleries)[0];
      image: ImageData;
      imageIndex: number;
      total: number;
      prevSlug: string | null;
      nextSlug: string | null;
    };
  }> = [];

  for (const gallery of galleries) {
    const collectionSlug = slug(gallery.id);
    const images = gallery.data.images;

    for (let i = 0; i < images.length; i++) {
      const img = images[i];
      paths.push({
        params: {
          collection: collectionSlug,
          image: imageSlug(img.alt),
        },
        props: {
          gallery,
          image: img,
          imageIndex: i,
          total: images.length,
          prevSlug: i > 0 ? imageSlug(images[i - 1].alt) : null,
          nextSlug: i < images.length - 1 ? imageSlug(images[i + 1].alt) : null,
        },
      });
    }
  }

  return paths;
}

const { gallery, image, imageIndex, total, prevSlug, nextSlug } = Astro.props;
const collectionSlug = slug(gallery.id);

// Real intrinsic dimensions for the displayed image (gallery images live in
// public/, so read the file header) — hardcoding 1200x900 mis-sized anything
// that isn't 4:3 and caused layout shift. Fall back if the file is unreadable.
const imageDimensions = getImageDimensions(image.src);
const imageWidth = imageDimensions?.width ?? 1200;
const imageHeight = imageDimensions?.height ?? 900;

// OG image: swap .webp -> .jpg for scraper compatibility.
const ogImage = ogSafeImage(image.src);
const ogDimensions = getImageDimensions(ogImage);

// Astro 7 scopes the Astro global to the frontmatter; capture what the
// template's JSON-LD needs.
const site = Astro.site;
---

<BaseLayout
  title={`${image.alt} — ${gallery.data.title}`}
  description={image.caption || image.alt}
  image={ogImage}
  imageWidth={ogDimensions?.width}
  imageHeight={ogDimensions?.height}
  imageAlt={image.alt}
  type="article"
  siteNameInTitle={false}
  tags={gallery.data.tags}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      name: image.alt,
      contentUrl: new URL(image.src, site).href,
      ...(image.caption ? { caption: image.caption } : {}),
      isPartOf: {
        '@type': 'ImageGallery',
        name: gallery.data.title,
        url: new URL(`/gallery/${collectionSlug}/`, site).href,
      },
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
    })}
  />
  <article class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Gallery', href: '/gallery/' },
        { label: gallery.data.title, href: `/gallery/${collectionSlug}/` },
        { label: image.alt },
      ]}
    />

    {
      /* The alt text names the piece, so it doubles as the page's <h1>. Without
        this the only heading on 58 image pages was the keyboard-shortcuts
        dialog's <h2>. */
    }
    <h1 class="text-text mt-6 mb-6 text-2xl font-semibold text-balance">{image.alt}</h1>

    {/* Image */}
    <figure class="mb-8">
      <div class="border-border bg-surface-alt overflow-hidden rounded-lg border">
        <Picture
          src={image.src}
          width={imageWidth}
          height={imageHeight}
          widths={[640, 1200, 1920]}
          formats={['avif', 'webp']}
          alt={image.alt}
          class="w-full"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {image.caption && <figcaption class="text-text-muted mt-3 text-sm">{image.caption}</figcaption>}
    </figure>

    {/* Metadata */}
    <div class="text-text-muted mb-8 flex flex-wrap items-center gap-3 text-sm">
      <span>{imageIndex + 1} of {total}</span>
      <span aria-hidden="true">&middot;</span>
      <span
        >Collection: <a href={`/gallery/${collectionSlug}/`} class="text-accent hover:underline">{gallery.data.title}</a
        ></span
      >
      {
        gallery.data.medium && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{gallery.data.medium}</span>
          </>
        )
      }
      <span class="ml-auto">
        <ShareButton title={image.alt} url={`/gallery/${collectionSlug}/${imageSlug(image.alt)}/`} client:idle />
      </span>
    </div>

    {/* Tags */}
    <div class="mb-8 flex flex-wrap gap-2">
      {
        gallery.data.tags.map((tag: string) => (
          <a
            href={`/gallery/tag/${tagSlug(tag)}/`}
            class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent rounded-full px-2.5 py-0.5 text-xs no-underline transition-colors"
          >
            {tag}
          </a>
        ))
      }
    </div>

    {/* Prev/Next navigation */}
    <nav class="border-border grid gap-4 border-t pt-8 sm:grid-cols-2" aria-label="Previous and next images">
      {
        prevSlug ? (
          <a
            href={`/gallery/${collectionSlug}/${prevSlug}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors"
          >
            <span class="text-text-muted text-xs">&larr; Previous</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {gallery.data.images[imageIndex - 1].alt}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextSlug && (
          <a
            href={`/gallery/${collectionSlug}/${nextSlug}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors sm:text-right"
          >
            <span class="text-text-muted text-xs">Next &rarr;</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {gallery.data.images[imageIndex + 1].alt}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
