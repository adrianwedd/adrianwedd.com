---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Adrian Wedd — consulting, research collaboration, advisory, or a conversation about a real problem.">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-text">Contact</h1>
    <p class="mt-4 max-w-prose text-text-muted">Based in Cygnet, Tasmania. Best reached by email — or book a call directly below.</p>

    <div class="mt-8 rounded-lg border border-border bg-surface-alt p-5">
      <h2 class="text-base font-semibold text-text">I'm available for</h2>
      <ul class="mt-3 space-y-2 text-sm text-text-muted">
        <li>Client projects — AI integration, automation, systems architecture, infrastructure</li>
        <li>Consulting engagements where the problem is real and the approach needs to be honest</li>
        <li>Research collaboration on AI safety, multi-agent systems, and adversarial evaluation</li>
        <li>Technical advisory on AI risk, governance, and responsible deployment</li>
        <li>Speaking or writing on demonstrated risk, failure analysis, and what actually works</li>
      </ul>
      <p class="mt-4 text-sm text-text-muted">
        See the full <a href="/services/" class="text-accent hover:underline">services overview →</a> for domains, case studies, and pricing.
      </p>
    </div>

    {/* Booking widget */}
    <div class="mt-12">
      <h2 class="text-xl font-semibold text-text">Book a call</h2>
      <p class="mt-1 text-sm text-text-muted">Pick a time that works. Hobart time (AEST/AEDT). 30 minutes.</p>

      <div id="booking-widget" class="mt-6">
        {/* Date picker */}
        <div id="booking-step-date">
          <div class="flex items-center justify-between">
            <button id="cal-prev" type="button" class="rounded border border-border px-3 py-1 text-sm text-text-muted transition-colors hover:border-accent hover:text-accent" aria-label="Previous week">&larr;</button>
            <span id="cal-week-label" class="text-sm font-medium text-text"></span>
            <button id="cal-next" type="button" class="rounded border border-border px-3 py-1 text-sm text-text-muted transition-colors hover:border-accent hover:text-accent" aria-label="Next week">&rarr;</button>
          </div>
          <div id="cal-days" class="mt-4 grid grid-cols-7 gap-2"></div>
        </div>

        {/* Slot picker */}
        <div id="booking-step-slots" class="hidden mt-6">
          <div class="flex items-center gap-3">
            <button id="slots-back" type="button" class="text-sm text-text-muted transition-colors hover:text-accent">&larr; Back</button>
            <span id="slots-date-label" class="text-sm font-medium text-text"></span>
          </div>
          <div id="slots-grid" class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-4"></div>
          <p id="slots-empty" class="hidden mt-4 text-sm text-text-muted">No slots available on this day.</p>
          <p id="slots-error" class="hidden mt-4 text-sm text-red-400">Couldn't load slots. Try again.</p>
        </div>

        {/* Booking form */}
        <div id="booking-step-form" class="hidden mt-6">
          <div class="flex items-center gap-3">
            <button id="form-back" type="button" class="text-sm text-text-muted transition-colors hover:text-accent">&larr; Back</button>
            <span id="form-slot-label" class="text-sm font-medium text-text"></span>
          </div>
          <form id="booking-form" class="mt-4 space-y-4" novalidate>
            <div>
              <label for="book-name" class="block text-xs text-text-muted">Name</label>
              <input id="book-name" name="name" type="text" required autocomplete="name"
                class="mt-1 w-full rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none" placeholder="Your name" />
            </div>
            <div>
              <label for="book-email" class="block text-xs text-text-muted">Email</label>
              <input id="book-email" name="email" type="email" required autocomplete="email"
                class="mt-1 w-full rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none" placeholder="you@example.com" />
            </div>
            <div>
              <label for="book-note" class="block text-xs text-text-muted">What's it about? <span class="text-text-muted">(optional)</span></label>
              <textarea id="book-note" name="note" rows="3"
                class="mt-1 w-full rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none resize-none" placeholder="A sentence or two about what you'd like to talk through."></textarea>
            </div>
            <p id="form-error" class="hidden text-sm text-red-400"></p>
            <button type="submit" id="book-submit"
              class="rounded-lg bg-accent px-5 py-2 text-sm font-medium text-surface transition-opacity hover:opacity-90 disabled:opacity-50">
              Confirm booking
            </button>
          </form>
        </div>

        {/* Confirmation */}
        <div id="booking-step-confirm" class="hidden mt-6 rounded-lg border border-green-700 bg-green-700/10 p-5">
          <p class="font-medium text-green-400">You're booked.</p>
          <p id="confirm-detail" class="mt-1 text-sm text-text-muted"></p>
          <p class="mt-2 text-sm text-text-muted">A calendar invite will arrive shortly.</p>
        </div>
      </div>
    </div>

    <div class="section-divider my-12 max-w-full"></div>

    {/* Contact details — rendered as SVG paths to deter scrapers */}
    <div class="mt-10 space-y-6">
      <div class="flex items-center gap-4">
        <div
          class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border border-border bg-surface-alt"
        >
          <svg
            class="h-5 w-5 text-accent"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            ></path>
          </svg>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">Email</p>
          {/* SVG text rendering — not selectable/indexable as plain text */}
          <svg viewBox="0 0 280 24" class="contact-svg h-5" role="img" aria-label="Email: adrian@adrianwedd.com">
            <text x="0" y="17" class="contact-text">adrian@adrianwedd.com</text>
          </svg>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div
          class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border border-border bg-surface-alt"
        >
          <svg
            class="h-5 w-5 text-accent"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="mb-1 text-xs text-text-muted">Phone</p>
          <svg viewBox="0 0 200 24" class="contact-svg h-5" role="img" aria-label="Phone: +61 407 081 084">
            <text x="0" y="17" class="contact-text">+61 407 081 084</text>
          </svg>
        </div>
      </div>
    </div>

    <div class="section-divider my-12 max-w-full"></div>

    {/* Social links */}
    <h2 class="text-xl font-semibold text-text">Elsewhere</h2>
    <div class="mt-6 flex flex-wrap gap-4">
      <a
        href="https://github.com/adrianwedd"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:border-accent/50 card-hover inline-flex items-center gap-3 rounded-xl border border-border bg-surface-alt px-5 py-3 no-underline transition-all hover:shadow-card"
      >
        <svg class="h-5 w-5 text-text" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        <span class="text-sm text-text-muted">GitHub</span>
      </a>

      <a
        href="https://linkedin.com/in/adrianwedd"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:border-accent/50 card-hover inline-flex items-center gap-3 rounded-xl border border-border bg-surface-alt px-5 py-3 no-underline transition-all hover:shadow-card"
      >
        <svg class="h-5 w-5 text-text" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        <span class="text-sm text-text-muted">LinkedIn</span>
      </a>

      <a
        href="https://x.com/adrianwedd"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:border-accent/50 card-hover inline-flex items-center gap-3 rounded-xl border border-border bg-surface-alt px-5 py-3 no-underline transition-all hover:shadow-card"
      >
        <svg class="h-5 w-5 text-text" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
        <span class="text-sm text-text-muted">X / Twitter</span>
      </a>
    </div>

    <div class="section-divider my-12 max-w-full"></div>

    {/* Map */}
    <h2 class="text-xl font-semibold text-text">Location</h2>
    <p class="mt-2 text-sm text-text-muted">Cygnet, Tasmania, Australia</p>
    <div class="mt-6 overflow-hidden rounded-xl border border-border shadow-subtle">
      <iframe
        title="Map showing Cygnet, Tasmania"
        width="100%"
        height="350"
        style="border:0"
        loading="lazy"
        class="map-embed"
        src="https://www.openstreetmap.org/export/embed.html?bbox=147.05%2C-43.17%2C147.19%2C-43.10&layer=mapnik&marker=-43.135932%2C147.120761"
      ></iframe>
    </div>
    <p class="mt-2 text-xs text-text-muted">
      <a
        href="https://www.openstreetmap.org/?mlat=-43.135932&mlon=147.120761#map=14/-43.1359/147.1208"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent"
      >
        View larger map &nearr;
      </a>
    </p>
  </section>
</BaseLayout>

<script>
  function initBookingWidget() {
  const API = 'https://api.book.adrianwedd.com';

  let weekOffset = 0;
  let selectedSlot: string | null = null;

  const stepDate = document.getElementById('booking-step-date');
  const stepSlots = document.getElementById('booking-step-slots');
  const stepForm = document.getElementById('booking-step-form');
  const stepConfirm = document.getElementById('booking-step-confirm');
  const calDays = document.getElementById('cal-days');
  const calWeekLabel = document.getElementById('cal-week-label');
  const slotsGrid = document.getElementById('slots-grid');
  const slotsEmpty = document.getElementById('slots-empty');
  const slotsError = document.getElementById('slots-error');
  const slotsDateLabel = document.getElementById('slots-date-label');
  const formSlotLabel = document.getElementById('form-slot-label');
  const confirmDetail = document.getElementById('confirm-detail');
  const bookingForm = document.getElementById('booking-form') as HTMLFormElement | null;
  const formError = document.getElementById('form-error');
  const bookSubmit = document.getElementById('book-submit') as HTMLButtonElement | null;

  // Guard: only run on contact page
  if (!stepDate || !calDays || !bookingForm) return;

  // Sentinel: prevent duplicate listener registration on VT re-visits
  if (bookingForm.dataset.bookingInit) return;
  bookingForm.dataset.bookingInit = '1';

  function isoDate(d: Date) {
    return d.toISOString().slice(0, 10);
  }

  function getWeekDates(offset: number) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const monday = new Date(today);
    monday.setDate(today.getDate() - ((today.getDay() + 6) % 7) + offset * 7);
    return Array.from({ length: 7 }, (_, i) => {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      return d;
    });
  }

  function renderWeek() {
    const days = getWeekDates(weekOffset);
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
    calWeekLabel!.textContent = `${fmt(days[0])} – ${fmt(days[6])}`;
    calDays!.textContent = '';
    const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    days.forEach((d, i) => {
      const isPast = d < today;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.disabled = isPast;
      btn.dataset.date = isoDate(d);
      btn.className = [
        'flex flex-col items-center rounded-lg border py-2 text-xs transition-colors',
        isPast
          ? 'border-border text-text-muted opacity-40 cursor-not-allowed'
          : 'border-border text-text hover:border-accent hover:text-accent cursor-pointer',
      ].join(' ');
      const daySpan = document.createElement('span');
      daySpan.className = 'font-medium';
      daySpan.textContent = dayNames[i];
      const numSpan = document.createElement('span');
      numSpan.className = 'mt-0.5 text-lg font-semibold leading-none';
      numSpan.textContent = String(d.getDate());
      btn.appendChild(daySpan);
      btn.appendChild(numSpan);
      if (!isPast) {
        const dateCopy = new Date(d);
        btn.addEventListener('click', () => selectDate(isoDate(dateCopy), dateCopy));
      }
      calDays.appendChild(btn);
    });
  }

  async function selectDate(dateStr: string, d: Date) {
    slotsDateLabel!.textContent = d.toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' });
    stepDate!.classList.add('hidden');
    stepSlots!.classList.remove('hidden');
    slotsGrid!.textContent = '';
    const loading = document.createElement('p');
    loading.className = 'col-span-4 text-xs text-text-muted';
    loading.textContent = 'Loading…';
    slotsGrid!.appendChild(loading);
    slotsEmpty!.classList.add('hidden');
    slotsError!.classList.add('hidden');
    try {
      const res = await fetch(`${API}/slots?date=${dateStr}`);
      if (!res.ok) throw new Error();
      const data = await res.json() as { slots: string[] };
      slotsGrid!.textContent = '';
      if (!data.slots.length) { slotsEmpty!.classList.remove('hidden'); return; }
      data.slots.forEach((time: string) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = time;
        btn.className = 'rounded-lg border border-border px-3 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent cursor-pointer';
        // Derive the correct UTC offset for this date in Australia/Hobart (DST-aware)
        const slotLocal = new Date(`${dateStr}T${time}:00`);
        const hobartFmt = new Intl.DateTimeFormat('en-AU', {
          timeZone: 'Australia/Hobart',
          timeZoneName: 'shortOffset',
        });
        const offsetStr = hobartFmt.formatToParts(slotLocal)
          .find((p) => p.type === 'timeZoneName')?.value ?? 'GMT+11';
        // offsetStr is e.g. "GMT+11" or "GMT+10" — convert to ±HH:MM
        const offsetMatch = offsetStr.match(/GMT([+-]\d+)/);
        const offsetHours = offsetMatch ? parseInt(offsetMatch[1], 10) : 11;
        const offsetSign = offsetHours >= 0 ? '+' : '-';
        const offsetAbs = Math.abs(offsetHours).toString().padStart(2, '0');
        const slotIso = `${dateStr}T${time}:00${offsetSign}${offsetAbs}:00`;
        const slotLabel = `${slotsDateLabel!.textContent} at ${time}`;
        btn.addEventListener('click', () => selectSlot(slotIso, slotLabel));
        slotsGrid!.appendChild(btn);
      });
    } catch {
      slotsGrid!.textContent = '';
      slotsError!.classList.remove('hidden');
    }
  }

  function selectSlot(iso: string, label: string) {
    selectedSlot = iso;
    formSlotLabel!.textContent = label;
    stepSlots!.classList.add('hidden');
    stepForm!.classList.remove('hidden');
  }

  document.getElementById('cal-prev')?.addEventListener('click', () => { weekOffset = Math.max(weekOffset - 1, 0); renderWeek(); });
  document.getElementById('cal-next')?.addEventListener('click', () => { weekOffset++; renderWeek(); });
  document.getElementById('slots-back')?.addEventListener('click', () => {
    stepSlots!.classList.add('hidden');
    stepDate!.classList.remove('hidden');
  });
  document.getElementById('form-back')?.addEventListener('click', () => {
    stepForm!.classList.add('hidden');
    stepSlots!.classList.remove('hidden');
  });

  bookingForm!.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError!.classList.add('hidden');
    const name = (document.getElementById('book-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('book-email') as HTMLInputElement).value.trim();
    const note = (document.getElementById('book-note') as HTMLTextAreaElement).value.trim();
    if (!name || !email || !selectedSlot) {
      formError!.textContent = 'Please fill in your name and email.';
      formError!.classList.remove('hidden');
      return;
    }
    bookSubmit!.disabled = true;
    bookSubmit!.textContent = 'Booking…';
    try {
      const res = await fetch(`${API}/book`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, slot: selectedSlot, note }),
      });
      if (!res.ok) throw new Error();
      stepForm!.classList.add('hidden');
      stepConfirm!.classList.remove('hidden');
      confirmDetail!.textContent = `${name} · ${formSlotLabel!.textContent}`;
    } catch {
      formError!.textContent = 'Something went wrong. Try emailing directly.';
      formError!.classList.remove('hidden');
      bookSubmit!.disabled = false;
      bookSubmit!.textContent = 'Confirm booking';
    }
  });

  renderWeek();
  } // end initBookingWidget

  // Run on initial load and after View Transitions
  initBookingWidget();
  document.addEventListener('astro:after-swap', initBookingWidget);
</script>

<style>
  .contact-text {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 16px;
    fill: var(--color-text);
  }
  .contact-svg {
    width: auto;
  }
  /* Invert map tiles in dark mode for readability */
  :root:not(.light) .map-embed {
    filter: invert(90%) hue-rotate(180deg);
  }
</style>
