        class="transition-colors hover:text-accent"
      >
        View larger map &nearr;
      </a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var API = 'https://api.book.adrianwedd.com';
    var weekOffset = 0;
    var selectedSlot = null;

    function el(id) {
      return document.getElementById(id);
    }

    function isoDate(d) {
      var y = d.getFullYear();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }

    function getWeekDates(offset) {
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var monday = new Date(today);
      monday.setDate(today.getDate() - ((today.getDay() + 6) % 7) + offset * 7);
      return Array.from({ length: 7 }, function (_, i) {
        var d = new Date(monday);
        d.setDate(monday.getDate() + i);
        return d;
      });
    }

    function renderWeek() {
      var calDays = el('cal-days');
      var calWeekLabel = el('cal-week-label');
      if (!calDays || !calWeekLabel) return;
      var days = getWeekDates(weekOffset);
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var fmt = function (d) {
        return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
      };
      calWeekLabel.textContent = fmt(days[0]) + ' \u2013 ' + fmt(days[6]);
      calDays.textContent = '';
      var dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      var buttons = [];
      days.forEach(function (d, i) {
        var isPast = d < today;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.disabled = isPast;
        btn.dataset.date = isoDate(d);
        btn.className =
          'flex flex-col items-center rounded-lg border py-2 text-xs transition-colors ' +
          (isPast
            ? 'border-border text-text-muted opacity-40 cursor-not-allowed'
            : 'border-border text-text hover:border-accent hover:text-accent cursor-pointer');
        var daySpan = document.createElement('span');
        daySpan.className = 'font-medium';
        daySpan.textContent = dayNames[i];
        var numSpan = document.createElement('span');
        numSpan.className = 'mt-0.5 text-lg font-semibold leading-none';
        numSpan.textContent = String(d.getDate());
        btn.appendChild(daySpan);
        btn.appendChild(numSpan);
        if (!isPast) {
          var dateCopy = new Date(d);
          btn.addEventListener('click', function () {
            selectDate(isoDate(dateCopy), dateCopy);
          });
        }
        calDays.appendChild(btn);
        buttons.push({ btn: btn, date: d, isPast: isPast });
      });

      // Pre-fetch slot availability to grey out days with no slots
      buttons.forEach(function (item) {
        if (item.isPast) return;
        var dateStr = isoDate(item.date);
        fetch(API + '/slots?date=' + dateStr)
          .then(function (r) {
            return r.ok ? r.json() : { slots: [] };
          })
          .then(function (data) {
            var slots = data.slots || data || [];
            if (Array.isArray(slots) && slots.length === 0) {
              item.btn.disabled = true;
              item.btn.className =
                'flex flex-col items-center rounded-lg border py-2 text-xs transition-colors border-border text-text-muted opacity-40 cursor-not-allowed';
              item.btn.title = 'No slots available';
            }
          })
          .catch(function () {
            /* leave day clickable on fetch failure */
          });
      });
    }

    function selectDate(dateStr, d) {
      var slotsDateLabel = el('slots-date-label');
      var stepDate = el('booking-step-date');
      var stepSlots = el('booking-step-slots');
      var slotsGrid = el('slots-grid');
      var slotsEmpty = el('slots-empty');
      var slotsError = el('slots-error');
      if (!slotsDateLabel || !stepDate || !stepSlots || !slotsGrid) return;
      slotsDateLabel.textContent = d.toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long' });
      stepDate.classList.add('hidden');
      stepSlots.classList.remove('hidden');
      slotsGrid.textContent = '';
      var loading = document.createElement('p');
      loading.className = 'col-span-4 text-xs text-text-muted';
      loading.textContent = 'Loading\u2026';
      slotsGrid.appendChild(loading);
      if (slotsEmpty) slotsEmpty.classList.add('hidden');
      if (slotsError) slotsError.classList.add('hidden');
      fetch(API + '/slots?date=' + dateStr)
        .then(function (res) {
          if (!res.ok) throw new Error();
          return res.json();
        })
        .then(function (data) {
          slotsGrid.textContent = '';
          if (!data.slots.length) {
            if (slotsEmpty) slotsEmpty.classList.remove('hidden');
            return;
          }
          data.slots.forEach(function (time) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = time;
            btn.className =
              'rounded-lg border border-border px-3 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent cursor-pointer';
            var slotLocal = new Date(dateStr + 'T' + time + ':00');
            var hobartFmt = new Intl.DateTimeFormat('en-AU', {
              timeZone: 'Australia/Hobart',
              timeZoneName: 'shortOffset',
            });
            var offsetStr =
              (
                hobartFmt.formatToParts(slotLocal).find(function (p) {
                  return p.type === 'timeZoneName';
                }) || {}
              ).value || 'GMT+11';
            var offsetMatch = offsetStr.match(/GMT([+-]\d+)/);
            var offsetHours = offsetMatch ? parseInt(offsetMatch[1], 10) : 11;
            var offsetSign = offsetHours >= 0 ? '+' : '-';
            var offsetAbs = Math.abs(offsetHours).toString().padStart(2, '0');
            var slotIso = dateStr + 'T' + time + ':00' + offsetSign + offsetAbs + ':00';
            var slotLabel = slotsDateLabel.textContent + ' at ' + time;
            btn.addEventListener('click', function () {
              selectSlot(slotIso, slotLabel);
            });
            slotsGrid.appendChild(btn);
          });
        })
        .catch(function () {
          slotsGrid.textContent = '';
          if (slotsError) slotsError.classList.remove('hidden');
        });
    }

    function selectSlot(iso, label) {
      selectedSlot = iso;
      var formSlotLabel = el('form-slot-label');
      var stepSlots = el('booking-step-slots');
      var stepForm = el('booking-step-form');
      if (formSlotLabel) formSlotLabel.textContent = label;
      if (stepSlots) stepSlots.classList.add('hidden');
      if (stepForm) stepForm.classList.remove('hidden');
    }

    function initBooking() {
      var bookingForm = el('booking-form');
      if (!bookingForm || bookingForm.dataset.bookingInit) return;
      bookingForm.dataset.bookingInit = '1';
      weekOffset = 0;
      selectedSlot = null;
      renderWeek();
    }

    // Event delegation on document for booking widget buttons
    if (!document.documentElement.dataset.bookingDelegateInit) {
      document.documentElement.dataset.bookingDelegateInit = '1';

      document.addEventListener('click', function (e) {
        var target = e.target;
        if (!target || typeof target.closest !== 'function') return;

        if (target.closest('#cal-prev')) {
          weekOffset = Math.max(weekOffset - 1, 0);
          renderWeek();
          return;
        }
        if (target.closest('#cal-next')) {
          weekOffset++;
          renderWeek();
          return;
        }
        if (target.closest('#slots-back')) {
          var stepSlots = el('booking-step-slots');
          var stepDate = el('booking-step-date');
          if (stepSlots) stepSlots.classList.add('hidden');
          if (stepDate) stepDate.classList.remove('hidden');
          return;
        }
        if (target.closest('#form-back')) {
          var stepForm = el('booking-step-form');
          var stepSlots2 = el('booking-step-slots');
          if (stepForm) stepForm.classList.add('hidden');
          if (stepSlots2) stepSlots2.classList.remove('hidden');
          return;
        }
      });

      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || form.id !== 'booking-form') return;
        e.preventDefault();
        var formError = el('form-error');
        var bookSubmit = el('book-submit');
        if (formError) formError.classList.add('hidden');
        var name = (el('book-name') || {}).value || '';
        var email = (el('book-email') || {}).value || '';
        var note = (el('book-note') || {}).value || '';
        name = name.trim();
        email = email.trim();
        note = note.trim();
        if (!name || !email || !selectedSlot) {
          if (formError) {
            formError.textContent = 'Please fill in your name and email.';
            formError.classList.remove('hidden');
          }
          return;
        }
        if (bookSubmit) {
          bookSubmit.disabled = true;
          bookSubmit.textContent = 'Booking\u2026';
        }
        fetch(API + '/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, email: email, slot: selectedSlot, note: note }),
        })
          .then(function (res) {
            if (!res.ok) throw new Error();
            return res;
          })
          .then(function () {
            var stepForm = el('booking-step-form');
            var stepConfirm = el('booking-step-confirm');
            var confirmDetail = el('confirm-detail');
            var formSlotLabel = el('form-slot-label');
            if (stepForm) stepForm.classList.add('hidden');
            if (stepConfirm) stepConfirm.classList.remove('hidden');
            if (confirmDetail)
              confirmDetail.textContent = name + ' \u00b7 ' + (formSlotLabel ? formSlotLabel.textContent : '');
          })
          .catch(function () {
            if (formError) {
              formError.textContent = 'Something went wrong. Try emailing directly.';
              formError.classList.remove('hidden');
            }
            if (bookSubmit) {
              bookSubmit.disabled = false;
              bookSubmit.textContent = 'Confirm booking';
            }
          });
      });

      document.addEventListener('astro:after-swap', initBooking);
    }

    initBooking();
  })();
</script>

<style>
  /* Invert map tiles in dark mode for readability */
  :root:not(.light) .map-embed {
    filter: invert(90%) hue-rotate(180deg);
  }
</style>
