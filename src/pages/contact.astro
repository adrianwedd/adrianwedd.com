    <div class="section-divider my-12 max-w-full"></div>

    {/* Map */}
    <h2 class="text-xl font-semibold text-text">Location</h2>
    <p class="mt-2 text-sm text-text-muted">Cygnet, Tasmania, Australia</p>
    <div class="mt-6 overflow-hidden rounded-xl border border-border shadow-subtle">
      <iframe
        title="Map showing Cygnet, Tasmania"
        width="100%"
        height="350"
        style="border:0"
        loading="lazy"
        class="map-embed"
        src="https://www.openstreetmap.org/export/embed.html?bbox=147.05%2C-43.17%2C147.19%2C-43.10&layer=mapnik&marker=-43.135932%2C147.120761"
      ></iframe>
    </div>
    <p class="mt-2 text-xs text-text-muted">
      <a
        href="https://www.openstreetmap.org/?mlat=-43.135932&mlon=147.120761#map=14/-43.1359/147.1208"
