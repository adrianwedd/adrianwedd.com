          ></path>
        </svg>
        <span class="text-sm text-text-muted">GitHub</span>
      </a>

      <a
        href="https://linkedin.com/in/adrianwedd"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:border-accent/50 card-hover inline-flex items-center gap-3 rounded-xl border border-border bg-surface-alt px-5 py-3 no-underline transition-all hover:shadow-card"
      >
        <svg class="h-5 w-5 text-text" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
