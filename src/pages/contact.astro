---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Adrian Wedd — consulting, research collaboration, advisory, or a conversation about a real problem."
>
  <section class="relative flex min-h-[100dvh] items-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="text-text">
        Let's talk.<br />
        <span class="text-text-muted">30 minutes. No pitch. Just the problem.</span>
      </h1>
      <p class="mt-6 max-w-prose text-text-muted">
        Most of the conversations worth having start with a problem that hasn't been fully named yet.
      </p>
      <p class="mt-2 text-sm text-text-muted">
        Based in Cygnet, Tasmania. Best reached by email — or book a call directly below.
      </p>
    </div>
    <HeroCanvas animation="signal" />
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mt-8 rounded-lg border border-border bg-surface-alt p-5">
      <h2 class="text-base font-semibold text-text">I'm available for</h2>
      <ul class="mt-3 space-y-2 text-sm text-text-muted">
        <li>Client projects — AI integration, automation, systems architecture, infrastructure</li>
        <li>Consulting engagements where the problem is real and the approach needs to be honest</li>
        <li>Research collaboration on AI safety, multi-agent systems, and adversarial evaluation</li>
        <li>Technical advisory on AI risk, governance, and responsible deployment</li>
        <li>Speaking or writing on demonstrated risk, failure analysis, and what actually works</li>
      </ul>
      <p class="mt-4 text-sm text-text-muted">
        See the full <a href="/services/" class="text-accent hover:underline">services overview →</a> for domains, case studies,
        and pricing.
      </p>
    </div>

    {/* Booking widget */}
    <div class="mt-12">
      <h2 class="text-xl font-semibold text-text">Book a call</h2>
      <p class="mt-1 text-sm text-text-muted">Pick a time that works. Hobart time (AEST/AEDT). 30 minutes.</p>
      <p class="mt-1 text-xs text-text-muted">
        Prefer email? <a href="mailto:adrian@adrianwedd.com" class="text-accent hover:underline"
          >adrian@adrianwedd.com</a
        >
      </p>

      <div id="booking-widget" class="mt-6">
        {/* Date picker */}
        <div id="booking-step-date">
          <div class="flex items-center justify-between">
            <button
              id="cal-prev"
              type="button"
              class="rounded border border-border px-3 py-1 text-sm text-text-muted transition-colors hover:border-accent hover:text-accent"
              aria-label="Previous week">&larr;</button
            >
            <span id="cal-week-label" class="text-sm font-medium text-text"></span>
            <button
              id="cal-next"
              type="button"
              class="rounded border border-border px-3 py-1 text-sm text-text-muted transition-colors hover:border-accent hover:text-accent"
              aria-label="Next week">&rarr;</button
            >
          </div>
          <div id="cal-days" class="mt-4 grid grid-cols-7 gap-2"></div>
        </div>

        {/* Slot picker */}
        <div id="booking-step-slots" class="mt-6 hidden">
          <div class="flex items-center gap-3">
            <button id="slots-back" type="button" class="text-sm text-text-muted transition-colors hover:text-accent"
              >&larr; Back</button
            >
            <span id="slots-date-label" class="text-sm font-medium text-text"></span>
          </div>
          <div id="slots-grid" class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-4"></div>
          <p id="slots-empty" class="mt-4 hidden text-sm text-text-muted">No slots available on this day.</p>
          <p id="slots-error" class="mt-4 hidden text-sm text-red-400">Couldn't load slots. Try again.</p>
        </div>

        {/* Booking form */}
        <div id="booking-step-form" class="mt-6 hidden">
          <div class="flex items-center gap-3">
            <button id="form-back" type="button" class="text-sm text-text-muted transition-colors hover:text-accent"
              >&larr; Back</button
            >
            <span id="form-slot-label" class="text-sm font-medium text-text"></span>
          </div>
          <form id="booking-form" class="mt-4 space-y-4" novalidate>
            <div>
              <label for="book-name" class="block text-xs text-text-muted">Name</label>
              <input
                id="book-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-1 w-full rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="book-email" class="block text-xs text-text-muted">Email</label>
              <input
                id="book-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1 w-full rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none"
                placeholder="you@example.com"
              />
            </div>
            <div>
              <label for="book-note" class="block text-xs text-text-muted"
                >What's it about? <span class="text-text-muted">(optional)</span></label
              >
              <textarea
                id="book-note"
                name="note"
                rows="3"
                class="mt-1 w-full resize-none rounded border border-border bg-surface px-3 py-2 text-sm text-text placeholder-text-muted focus:border-accent focus:outline-none"
                placeholder="A sentence or two about what you'd like to talk through."></textarea>
            </div>
            <p id="form-error" class="hidden text-sm text-red-400"></p>
            <button
              type="submit"
              id="book-submit"
              class="btn-primary rounded-lg bg-accent px-5 py-2 text-sm font-medium text-surface hover:opacity-90 disabled:opacity-50"
            >
              Confirm booking
            </button>
          </form>
        </div>

        {/* Confirmation */}
        <div id="booking-step-confirm" class="border-accent/30 bg-accent/10 mt-6 hidden rounded-lg border p-5">
          <p class="font-medium text-accent">You're booked.</p>
          <p id="confirm-detail" class="mt-1 text-sm text-text-muted"></p>
          <p class="mt-2 text-sm text-text-muted">A calendar invite will arrive shortly.</p>
        </div>
      </div>
    </div>

    <div class="section-divider my-12 max-w-full"></div>

    {/* Contact details — real links for usability and accessibility */}
    <div class="mt-10 space-y-6">
      <div class="flex items-center gap-4">
        <div
          class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg border border-border bg-surface-alt"
        >
          <svg
            class="h-5 w-5 text-accent"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
