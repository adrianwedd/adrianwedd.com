---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist.">
  <section class="relative flex min-h-[60dvh] items-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <p class="text-accent text-6xl font-bold">404</p>
      <h1 class="text-text mt-4">Page not found</h1>
      <p class="text-text-muted mx-auto mt-4 max-w-md">
        This page doesn't exist. I'd tell you the same thing regardless of how long you've been looking for it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="btn-primary bg-accent text-surface shadow-subtle hover:bg-accent-hover hover:shadow-card inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium no-underline"
        >
          Back to the workshop
        </a>
        <a
          href="/projects/"
          class="btn-secondary border-border text-text-muted hover:border-accent hover:text-accent inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium no-underline"
        >
          Browse projects
        </a>
      </div>

      <div class="mx-auto mt-12 max-w-md text-left">
        <p class="text-text-muted mb-4 text-sm">Or search for what you were looking for:</p>
        <div id="search-404"></div>
      </div>
    </div>
    <HeroCanvas animation="entropy" />
  </section>

  <script>
    function fire404Event() {
      const w = window as any;
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'page_not_found', {
          page_path: document.location.pathname,
          page_referrer: document.referrer || '',
        });
      }
    }

    function checkConsentAndFire() {
      try {
        const raw = localStorage.getItem('adrianwedd_consent');
        const consent = raw ? JSON.parse(raw) : null;
        if (consent?.analytics) fire404Event();
      } catch {
        // ignore
      }
    }

    // Fire on load if consent already given
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkConsentAndFire);
    } else {
      checkConsentAndFire();
    }

    // Fire if user grants consent while on this page
    if (!(document.documentElement as any).dataset.consent404Init) {
      (document.documentElement as any).dataset.consent404Init = '1';
      window.addEventListener('consent-updated', ((e: CustomEvent) => {
        if ((e as any).detail?.analytics) fire404Event();
      }) as EventListener);
    }
  </script>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline>
    (function () {
      function initPagefind404() {
        var container = document.getElementById('search-404');
        if (!container || container.dataset.pagefindInit) return;
        container.dataset.pagefindInit = '1';
        var script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onload = function () {
          new PagefindUI({
            element: '#search-404',
            showSubResults: false,
            showImages: false,
            autofocus: false,
          });
        };
        document.head.appendChild(script);
      }
      initPagefind404();
      if (!document.documentElement.dataset.pagefind404Init) {
        document.documentElement.dataset.pagefind404Init = '1';
        document.addEventListener('astro:page-load', initPagefind404);
      }
    })();
  </script>
</BaseLayout>
