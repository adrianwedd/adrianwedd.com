---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageUrl = '/case-studies/bottom-pub-project/';
const ogImage = '/og/case-studies/bottom-pub-project.png';
const meta = {
  title: 'There was no brief. There was a pub.',
  description:
    'How an ill-defined community acquisition effort became a functioning digital operation in three months.',
};

const expansion = [
  { phase: '01', need: 'Make the idea real', built: 'Public site · campaign identity · credible information' },
  { phase: '02', need: 'Find out what Cygnet wanted', built: 'Research · surveys · forms · structured data' },
  {
    phase: '03',
    need: 'Turn interest into an operation',
    built: 'EOIs · pledges · financial material · stakeholder briefings',
  },
  {
    phase: '04',
    need: 'Handle the consequences',
    built: 'Privacy controls · publishing gates · automation · verification',
  },
  {
    phase: '05',
    need: 'Survive the ending',
    built: 'State transition · corrections · preserved research · public archive',
  },
];

const facts = [
  ['3 months', 'from live question to functioning digital operation'],
  ['543 responses', 'across four instruments—not a toy dataset'],
  ['56 artefacts', 'preserved as a verified public record'],
  ['1 failed bid', 'without the system becoming rubble'],
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  siteNameInTitle={false}
  heroAnimation="pulse"
  publishedDate="2026-08-20T00:00:00.000Z"
  tags={['case-study', 'systems', 'privacy-engineering', 'community']}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: meta.title,
      description: meta.description,
      url: new URL(pageUrl, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: '2026-08-20',
      keywords: ['case-study', 'systems', 'privacy-engineering', 'community'],
      author: { '@type': 'Person', name: 'Adrian Wedd', url: 'https://adrianwedd.com' },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pageUrl, Astro.site).href },
    })}
  />

  <div class="bp-case">
    <Breadcrumb crumbs={[{ label: 'Case Studies', href: '/case-studies/' }, { label: meta.title }]} />

    <header class="bp-hero" aria-label="Case study introduction">
      <p class="bp-kicker">Case study · Cygnet, Tasmania · May–August 2026</p>
      <h1>{meta.title}</h1>
      <p class="bp-deck">
        A community campaign to buy a pub went from idea to functioning digital operation in weeks. I built the
        machinery around it as the problem unfolded.
      </p>
      <p class="bp-thesis">The specification was reality, arriving continuously.</p>

      <div class="bp-signal" aria-label="The forces shaping the project">
        <span>commercial deadline</span><span>community politics</span><span>private data</span><span
          >money in motion</span
        ><span>no stable requirements</span><strong>working system</strong>
      </div>
    </header>

    <main class="bp-body" data-pagefind-body>
      <section class="bp-act bp-act--opening" aria-labelledby="act-one">
        <p class="bp-act-number">01 / No brief</p>
        <h2 id="act-one">There was a live commercial situation and no time for discovery theatre.</h2>
        <div class="bp-copy">
          <p>
            The Commercial Hotel—the Bottom Pub to anyone local—was for sale. People in Cygnet wanted to know whether
            the town could buy it together. That simple question concealed almost everything that had not yet been
            decided: ownership structure, money, governance, appetite, legal boundaries, operating model, and even what
            could honestly be said in public.
          </p>
          <p>
            The campaign needed a credible public face immediately. Then it needed ways to listen, organise, publish,
            protect people, test claims, move information between systems, and keep all of that aligned while the facts
            changed underneath it.
          </p>
          <p>
            There was no finished specification to implement. Each answer exposed the next missing piece. The work was
            to understand the problem quickly enough that the infrastructure could appear before its absence became the
            bottleneck.
          </p>
        </div>

        <dl class="bp-facts">
          {
            facts.map(([value, label]) => (
              <div>
                <>
                  <dt>{value}</dt>
                  <dd>{label}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="bp-act" aria-labelledby="act-two">
        <p class="bp-act-number">02 / Velocity + range</p>
        <h2 id="act-two">The system grew as fast as the problem did.</h2>
        <p class="bp-lede">
          Not as a roadmap executed in order. As a chain reaction: every new fact created a new operational need, and
          each need had to join the same working system.
        </p>

        <ol class="bp-expansion" aria-label="How the system expanded">
          {
            expansion.map((item) => (
              <li>
                <span class="bp-phase">{item.phase}</span>
                <div>
                  <>
                    <span class="bp-need">{item.need}</span>
                    <span class="bp-built">{item.built}</span>
                  </>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="bp-punch">
          Website became campaign infrastructure. Campaign infrastructure became research operation. Research became
          public evidence. Public evidence required privacy, governance, automation, and verification. All of it
          happened while the acquisition itself kept moving.
        </p>
      </section>

      <section class="bp-act" aria-labelledby="act-three">
        <p class="bp-act-number">03 / Judgement under pressure</p>
        <h2 id="act-three">Speed didn’t mean cowboy shit.</h2>
        <p class="bp-lede">
          Moving quickly only mattered if the system remained trustworthy. Three moments show what that required.
        </p>

        <div class="bp-cases">
          <article>
            <p class="bp-case-index">01</p>
            <h3>Removing names does not make a small town anonymous.</h3>
            <p>
              A business, family relationship, health circumstance, or recognisable anecdote can identify someone just
              as effectively as a name. Free text was therefore reviewed by hand before publication. Proper nouns were
              examined, risky details generalised or removed, and small counts suppressed. Private words went in; only
              safe aggregates came out.
            </p>
            <p class="bp-proof">The constraint wasn’t “strip identifiers.” It was “do not expose a neighbour.”</p>
          </article>

          <article>
            <p class="bp-case-index">02</p>
            <h3>Fourteen people quietly became one.</h3>
            <p>
              Fourteen survey responses shared the same placeholder in the name field. An early linkage pass interpreted
              that shared value as one identity and produced a single, wildly prolific respondent. The error was caught
              before publication; identity matching was narrowed to exact email, and the failure became a permanent
              check.
            </p>
            <p class="bp-proof">Fast analysis is useless if the system invents a person who never existed.</p>
          </article>

          <article>
            <p class="bp-case-index">03</p>
            <h3>The bid died. Every public claim changed with it.</h3>
            <p>
              On 13 August the offer failed. Copy that had been accurate days earlier was suddenly asking people to
              support something that was no longer happening. The site had to change state across the homepage, forms,
              footer, structured data, and thirteen briefing pages—not merely publish a sad update and leave stale
              promises behind.
            </p>
            <p class="bp-proof">Truth was not a page. It was a property of the whole information surface.</p>
          </article>
        </div>
      </section>

      <section class="bp-act bp-act--coda" aria-labelledby="act-four">
        <p class="bp-act-number">04 / Designed for reality</p>
        <h2 id="act-four">The deal failed. The infrastructure survived.</h2>
        <div class="bp-coda-copy">
          <p>Three months after the work began, the acquisition failed.</p>
          <p>The system didn’t.</p>
          <p>
            It stopped soliciting support for a dead bid. It preserved the research, structured information, community
            knowledge, and public record. It could tell the truth about what had happened without erasing the useful
            work or trapping the next group inside the previous campaign’s assumptions.
          </p>
          <p>
            That is the deeper test of a system built inside ambiguity: not whether reality follows the plan, but
            whether the work remains coherent when reality changes its mind.
          </p>
        </div>

        <p class="bp-final">Enter the chaos. Find the shape. Build the missing machinery.</p>
        <p class="bp-links">
          <a href="https://bottom.pub/">Visit the project that survived →</a><br />
          <a href="/case-studies/bottom-pub-co-op/">Read how the first guardrails were built →</a>
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .bp-case {
    --bp-rust: var(--color-accent);
    --bp-line: var(--color-border);
    padding-bottom: 5rem;
  }
  .bp-hero,
  .bp-body {
    width: min(1120px, calc(100% - 2.5rem));
    margin-inline: auto;
  }
  .bp-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 3rem;
  }
  .bp-kicker,
  .bp-act-number,
  .bp-phase,
  .bp-case-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bp-kicker,
  .bp-act-number,
  .bp-case-index {
    color: var(--bp-rust);
  }
  .bp-hero h1 {
    max-width: 13ch;
    margin: 1rem 0;
    color: var(--color-text);
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .bp-deck {
    max-width: 54ch;
    margin: 1.5rem 0 0;
    color: var(--color-text);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.55;
  }
  .bp-thesis {
    max-width: 40ch;
    margin: 1rem 0 3rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-style: italic;
  }
  .bp-signal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: 900px;
  }
  .bp-signal span,
  .bp-signal strong {
    border: 1px solid var(--bp-line);
    border-radius: 999px;
    padding: 0.42rem 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
  }
  .bp-signal strong {
    border-color: var(--bp-rust);
    color: var(--bp-rust);
  }
  .bp-signal strong::before {
    content: '→ ';
  }
  .bp-act {
    padding: clamp(4rem, 9vw, 8rem) 0;
    border-top: 1px solid var(--bp-line);
  }
  .bp-act h2 {
    max-width: 18ch;
    margin: 0.75rem 0 2rem;
    color: var(--color-text);
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .bp-copy,
  .bp-lede,
  .bp-coda-copy {
    max-width: 68ch;
  }
  .bp-copy p,
  .bp-lede,
  .bp-coda-copy p,
  .bp-punch,
  .bp-cases article > p:not(.bp-case-index):not(.bp-proof) {
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .bp-copy p,
  .bp-coda-copy p {
    margin: 0 0 1rem;
  }
  .bp-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: 3rem 0 0;
    background: var(--bp-line);
    border: 1px solid var(--bp-line);
  }
  .bp-facts div {
    min-height: 9rem;
    padding: 1.25rem;
    background: var(--color-surface);
  }
  .bp-facts dt {
    color: var(--bp-rust);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
  }
  .bp-facts dd {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .bp-expansion {
    position: relative;
    margin: 3rem 0;
    padding: 0;
    list-style: none;
  }
  .bp-expansion::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1.15rem;
    width: 1px;
    background: linear-gradient(var(--bp-line), var(--bp-rust));
  }
  .bp-expansion li {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 1.25rem;
    padding: 0 0 clamp(2rem, 5vw, 4rem);
  }
  .bp-phase {
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--bp-line);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
  }
  .bp-expansion li:last-child .bp-phase {
    border-color: var(--bp-rust);
    color: var(--bp-rust);
  }
  .bp-need,
  .bp-built {
    display: block;
  }
  .bp-need {
    margin-bottom: 0.55rem;
    color: var(--color-text);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 700;
  }
  .bp-built {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .bp-punch {
    max-width: 52ch;
    margin: 1rem 0 0 clamp(3.65rem, 8vw, 7rem);
    padding-left: 1.25rem;
    border-left: 3px solid var(--bp-rust);
    font-size: clamp(1.15rem, 2.5vw, 1.55rem);
  }
  .bp-cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--bp-line);
    border: 1px solid var(--bp-line);
  }
  .bp-cases article {
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-surface);
  }
  .bp-cases h3 {
    margin: 1rem 0;
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.1;
  }
  .bp-proof {
    margin: auto 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bp-line);
    color: var(--bp-rust);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.55;
  }
  .bp-act--coda h2 {
    max-width: 14ch;
  }
  .bp-coda-copy p:nth-child(1),
  .bp-coda-copy p:nth-child(2) {
    margin-bottom: 0;
    font-size: clamp(1.5rem, 3.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.25;
  }
  .bp-coda-copy p:nth-child(2) {
    margin-bottom: 2rem;
    color: var(--bp-rust);
  }
  .bp-final {
    max-width: 22ch;
    margin: clamp(4rem, 10vw, 8rem) 0 3rem;
    color: var(--color-text);
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .bp-links {
    margin: 0;
    line-height: 2;
  }
  .bp-links a {
    color: var(--bp-rust);
  }

  @media (max-width: 800px) {
    .bp-hero {
      min-height: auto;
      padding-top: 3rem;
    }
    .bp-facts,
    .bp-cases {
      grid-template-columns: 1fr 1fr;
    }
    .bp-cases article:last-child {
      grid-column: 1 / -1;
      min-height: auto;
    }
  }
  @media (max-width: 520px) {
    .bp-hero,
    .bp-body {
      width: min(100% - 2rem, 1120px);
    }
    .bp-facts,
    .bp-cases {
      grid-template-columns: 1fr;
    }
    .bp-cases article:last-child {
      grid-column: auto;
    }
    .bp-cases article {
      min-height: auto;
    }
    .bp-punch {
      margin-left: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bp-signal span,
    .bp-signal strong {
      animation: bp-arrive 500ms ease-out both;
    }
    .bp-signal :nth-child(2) {
      animation-delay: 70ms;
    }
    .bp-signal :nth-child(3) {
      animation-delay: 140ms;
    }
    .bp-signal :nth-child(4) {
      animation-delay: 210ms;
    }
    .bp-signal :nth-child(5) {
      animation-delay: 280ms;
    }
    .bp-signal :nth-child(6) {
      animation-delay: 420ms;
    }
  }
  @keyframes bp-arrive {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }
</style>
