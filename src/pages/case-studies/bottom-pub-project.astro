---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageUrl = '/case-studies/bottom-pub-project/';
const ogImage = '/og/case-studies/bottom-pub-project.png';
const meta = {
  title: 'There was no brief. There was a pub.',
  description:
    'How an ill-defined community acquisition effort became a functioning digital operation in three months.',
};

// Dates and times are from the bottom.pub repository's commit history, Australia/Hobart.
type Moment = {
  date: string;
  time?: string;
  built: string;
  world: string;
  commits?: number;
  quiet?: boolean;
};

const chronology: Moment[] = [
  {
    date: 'May 9',
    time: '19:01',
    built: 'Claim scanner, research vault, proposal drafts and a public site—four commits in the same minute.',
    world:
      'By midnight the briefings rendered as pages and the legal hedging had been replaced with cited legislation.',
    commits: 9,
  },
  {
    date: 'May 10',
    time: '14:58',
    built: 'Expression-of-interest form wired to a database.',
    world: 'Security headers, SEO, structured data and an offline-capable shell followed before midnight.',
    commits: 36,
  },
  {
    date: 'May 18',
    time: '17:35',
    built: 'Contact intake: form, database, triage, email and issue tracker—landed inside three minutes.',
    world:
      'The working group needed somewhere to put what people were telling them. The admin vault and members area arrived the same evening.',
    commits: 57,
  },
  {
    date: 'May 19',
    built:
      'EOI admin panel and CSV export. Property watchdog. CI. Public status page. Admin cockpit. Public and admin search.',
    world: 'Each one working before the next began; the last of them landed at 23:18.',
    commits: 83,
  },
  {
    date: 'Jun 2',
    time: '13:23',
    built: 'Financial feasibility survey: public form, endpoint, schema, consent handling, notifications.',
    world:
      'By 16:31 the EOI flow and news archive had their own pages, the media section was rebuilt and the navigation changed site-wide.',
    commits: 19,
  },
  {
    date: 'Jun 4',
    time: '01:16',
    built: 'Community survey. Admin result pages for both surveys by 02:31.',
    world: 'The financial survey was renamed the Bottom Pub Pledge—the word the campaign would live on for two months.',
    commits: 39,
  },
  {
    date: 'Jun 8–10',
    built:
      'In-house mailing list merged at 15:06. Full site replatform started at 15:18; cutover merged two days later.',
    world: 'Live site, live forms, live database—none of it paused.',
  },
  {
    date: 'Jun 12',
    time: '13:05',
    built: 'Brief, assumptions and CI changed state.',
    world: 'The Commercial Hotel was formally listed. The research stopped being hypothetical.',
  },
  {
    date: 'Jun 24',
    built:
      'Eight-day acquisition sprint kit: feasibility study, adviser memos, finance figures, guardrail checklist, supporters strategy.',
    world: 'Pledges passed $1 million the same day.',
    commits: 18,
  },
  {
    date: 'Jun 28',
    time: '13:48',
    built: 'Final pledge system: worker, database, admin panel, homepage call to action, community loan tier.',
    world: 'Drafted for review at 13:48; live with launch copy by 19:19.',
    commits: 27,
  },
  {
    date: 'Jul 7 – Aug 17',
    built: 'One automated commit a day.',
    world: 'Six weeks of waiting on other people’s decisions.',
    quiet: true,
  },
  {
    date: 'Aug 13',
    built: '',
    world: 'The offer failed.',
    quiet: true,
  },
  {
    date: 'Aug 18',
    time: '18:26',
    built: 'Outcome published. Intake endpoints closed at 18:52. Public archive—two tranches—by 21:25.',
    world: 'Every page that had been asking for support now had to say so honestly.',
    commits: 19,
  },
  {
    date: 'Aug 19',
    time: '17:42',
    built:
      'Community findings brief specified. Rendered at build time, with suppression rules and privacy tests, at 18:13.',
    world: 'Thirty-one minutes. The linkage bug that turned fourteen people into one was found and fixed before 23:00.',
    commits: 82,
  },
];

const facts = [
  ['3 months', 'idea → live campaign → acquisition attempt → archive'],
  ['543 responses', 'across four instruments'],
  ['56 artefacts', 'in the verified public archive'],
  ['13 August', 'the bid failed. The research, the record and the system persisted.'],
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  siteNameInTitle={false}
  heroAnimation="pulse"
  publishedDate="2026-08-20T00:00:00.000Z"
  tags={['case-study', 'systems', 'privacy-engineering', 'community']}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: meta.title,
      description: meta.description,
      url: new URL(pageUrl, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: '2026-08-20',
      keywords: ['case-study', 'systems', 'privacy-engineering', 'community'],
      author: { '@type': 'Person', name: 'Adrian Wedd', url: 'https://adrianwedd.com' },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pageUrl, Astro.site).href },
    })}
  />

  <div class="bp-case">
    <Breadcrumb crumbs={[{ label: 'Case Studies', href: '/case-studies/' }, { label: meta.title }]} />

    <header class="bp-hero" aria-label="Case study introduction">
      <p class="bp-kicker">Case study · Cygnet, Tasmania · May–August 2026</p>
      <h1>{meta.title}</h1>
      <p class="bp-deck">
        A community campaign to buy a pub went from idea to functioning digital operation in weeks. I built the
        machinery around it as the problem unfolded.
      </p>
      <div class="bp-signal" aria-label="The forces shaping the project">
        <span>commercial deadline</span><span>community politics</span><span>private data</span><span
          >money in motion</span
        ><span>no stable requirements</span><strong>working system</strong>
      </div>
    </header>

    <main class="bp-body" data-pagefind-body>
      <section class="bp-act bp-act--opening" aria-labelledby="act-one">
        <p class="bp-act-number">01 / No brief</p>
        <h2 id="act-one">Discovery and delivery had to happen at the same time.</h2>
        <div class="bp-copy">
          <p>
            The Commercial Hotel—the Bottom Pub to anyone local—was closed. People in Cygnet wanted to know whether
            the town could buy it together. That simple question concealed almost everything that had not yet been
            decided: ownership structure, money, governance, appetite, legal boundaries, operating model, and even what
            could honestly be said in public.
          </p>
          <p>
            The campaign needed a credible public face immediately. Then it needed ways to listen, organise, publish,
            protect people, test claims, move information between systems, and keep all of that aligned while the facts
            changed underneath it.
          </p>
          <p>
            There was no finished specification to implement. Each answer exposed the next missing piece. The work was
            to understand the problem quickly enough that the infrastructure could appear before its absence became the
            bottleneck.
          </p>
        </div>

        <dl class="bp-facts">
          {
            facts.map(([value, label]) => (
              <div>
                <>
                  <dt>{value}</dt>
                  <dd>{label}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="bp-act" aria-labelledby="act-two">
        <p class="bp-act-number">02 / What appeared, and when</p>
        <h2 id="act-two">The requirements changed repeatedly, sometimes within hours.</h2>
        <p class="bp-lede">
          Not every commit. Fourteen moments where the problem changed and working infrastructure appeared behind it.
        </p>

        <ol class="bp-chron" aria-label="Build chronology">
          {
            chronology.map((m) => (
              <li class:list={['bp-moment', { 'bp-moment--quiet': m.quiet }]}>
                <div class="bp-when">
                  <span class="bp-date">{m.date}</span>
                  {m.time && <span class="bp-time">{m.time}</span>}
                </div>
                <div class="bp-what">
                  {m.built && <p class="bp-built">{m.built}</p>}
                  <p class="bp-world">{m.world}</p>
                </div>
                <span class="bp-commits">{m.commits ? `${m.commits} commits` : ''}</span>
              </li>
            ))
          }
        </ol>

        <p class="bp-source">
          Dates and times from the project’s commit history, Hobart time. Commit counts are per day.
        </p>
      </section>

      <section class="bp-act" aria-labelledby="act-three">
        <p class="bp-act-number">03 / Judgement</p>
        <h2 id="act-three">Three moments from the same months.</h2>

        <div class="bp-cases">
          <article>
            <p class="bp-case-index">01</p>
            <h3>Fourteen people quietly became one.</h3>
            <p>
              Fourteen survey responses shared the same placeholder in the name field. An early linkage pass interpreted
              that shared value as one identity and produced a single, wildly prolific respondent. The error was caught
              before publication; identity matching was narrowed to exact email, and the failure became a permanent
              check.
            </p>
            <p class="bp-proof">Fast analysis is useless if the system invents a person who never existed.</p>
          </article>

          <article>
            <p class="bp-case-index">02</p>
            <h3>Removing names does not make a small town anonymous.</h3>
            <p>
              A business, family relationship, health circumstance, or recognisable anecdote can identify someone just
              as effectively as a name. Free text was therefore reviewed by hand before publication. Proper nouns were
              examined, risky details generalised or removed, and small counts suppressed. Private words went in; only
              safe aggregates came out.
            </p>
            <p class="bp-proof">The constraint wasn’t “strip identifiers.” It was “do not expose a neighbour.”</p>
          </article>

          <article>
            <p class="bp-case-index">03</p>
            <h3>The bid died. Every public claim changed with it.</h3>
            <p>
              On 13 August the offer failed. Copy that had been accurate days earlier was suddenly asking people to
              support something that was no longer happening. The site could not publish a sad update and leave stale
              promises behind; it had to change state.
            </p>
            <p class="bp-proof">
              Homepage, forms, footer, structured data and thirteen briefing pages changed in the same pass.
            </p>
          </article>
        </div>
      </section>

      <section class="bp-act bp-act--coda" aria-labelledby="act-four">
        <p class="bp-act-number">04 / After</p>
        <h2 id="act-four">The offer failed on 13 August.</h2>
        <div class="bp-coda-copy">
          <p>
            The research still exists. The community record still exists. The infrastructure changed state and kept
            working.
          </p>
        </div>

        <p class="bp-final">Three months earlier, none of it existed.</p>
        <p class="bp-links">
          <a href="https://bottom.pub/">Visit the project that survived →</a><br />
          <a href="/case-studies/bottom-pub-co-op/">Read how the first guardrails were built →</a>
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .bp-case {
    --bp-rust: var(--color-accent);
    --bp-line: var(--color-border);
    padding-bottom: 5rem;
  }
  .bp-hero,
  .bp-body {
    width: min(1120px, calc(100% - 2.5rem));
    margin-inline: auto;
  }
  .bp-hero {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 3rem;
  }
  .bp-kicker,
  .bp-act-number,
  .bp-date,
  .bp-commits,
  .bp-case-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bp-kicker,
  .bp-act-number,
  .bp-case-index {
    color: var(--bp-rust);
  }
  .bp-hero h1 {
    max-width: 13ch;
    margin: 1rem 0;
    color: var(--color-text);
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .bp-deck {
    max-width: 54ch;
    margin: 1.5rem 0 3rem;
    color: var(--color-text);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.55;
  }
  .bp-signal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: 900px;
  }
  .bp-signal span,
  .bp-signal strong {
    border: 1px solid var(--bp-line);
    border-radius: 999px;
    padding: 0.42rem 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
  }
  .bp-signal strong {
    border-color: var(--bp-rust);
    color: var(--bp-rust);
  }
  .bp-signal strong::before {
    content: '→ ';
  }
  .bp-act {
    padding: clamp(4rem, 9vw, 8rem) 0;
    border-top: 1px solid var(--bp-line);
  }
  .bp-act h2 {
    max-width: 18ch;
    margin: 0.75rem 0 2rem;
    color: var(--color-text);
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .bp-copy,
  .bp-lede,
  .bp-coda-copy {
    max-width: 68ch;
  }
  .bp-copy p,
  .bp-lede,
  .bp-coda-copy p,
  .bp-cases article > p:not(.bp-case-index):not(.bp-proof) {
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .bp-copy p,
  .bp-coda-copy p {
    margin: 0 0 1rem;
  }
  .bp-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: 3rem 0 0;
    background: var(--bp-line);
    border: 1px solid var(--bp-line);
  }
  .bp-facts div {
    min-height: 9rem;
    padding: 1.25rem;
    background: var(--color-surface);
  }
  .bp-facts dt {
    color: var(--bp-rust);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
  }
  .bp-facts dd {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .bp-chron {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--bp-line);
  }
  .bp-moment {
    display: grid;
    grid-template-columns: 9.5rem 1fr 6.5rem;
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--bp-line);
  }
  .bp-when {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .bp-date {
    color: var(--color-text);
    font-weight: 700;
  }
  .bp-time {
    color: var(--bp-rust);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .bp-what p {
    margin: 0;
    line-height: 1.55;
  }
  .bp-built {
    color: var(--color-text);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    font-weight: 600;
  }
  .bp-world {
    margin-top: 0.35rem !important;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .bp-commits {
    align-self: start;
    padding-top: 0.3rem;
    color: var(--color-text-muted);
    text-align: right;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .bp-moment--quiet {
    padding: 1rem 0;
    background: transparent;
  }
  .bp-moment--quiet .bp-date {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .bp-moment--quiet .bp-built {
    color: var(--color-text-muted);
    font-weight: 400;
    font-style: italic;
  }
  .bp-moment--quiet .bp-world {
    color: var(--color-text);
    font-weight: 600;
  }
  .bp-source {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .bp-cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--bp-line);
    border: 1px solid var(--bp-line);
  }
  .bp-cases article {
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-surface);
  }
  .bp-cases h3 {
    margin: 1rem 0;
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.1;
  }
  .bp-proof {
    margin: auto 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bp-line);
    color: var(--bp-rust);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.55;
  }
  .bp-act--coda h2 {
    max-width: 14ch;
  }
  .bp-coda-copy p {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.5;
  }
  .bp-final {
    max-width: 18ch;
    margin: clamp(3rem, 8vw, 6rem) 0 3rem;
    color: var(--color-text);
    font-size: clamp(1.75rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .bp-links {
    margin: 0;
    line-height: 2;
  }
  .bp-links a {
    color: var(--bp-rust);
  }

  @media (max-width: 800px) {
    .bp-hero {
      min-height: auto;
      padding-top: 3rem;
    }
    .bp-moment {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .bp-when {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
    .bp-commits {
      text-align: left;
      padding-top: 0;
    }
    .bp-facts,
    .bp-cases {
      grid-template-columns: 1fr 1fr;
    }
    .bp-cases article:last-child {
      grid-column: 1 / -1;
      min-height: auto;
    }
  }
  @media (max-width: 520px) {
    .bp-hero,
    .bp-body {
      width: min(100% - 2rem, 1120px);
    }
    .bp-facts,
    .bp-cases {
      grid-template-columns: 1fr;
    }
    .bp-cases article:last-child {
      grid-column: auto;
    }
    .bp-cases article {
      min-height: auto;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bp-signal span,
    .bp-signal strong {
      animation: bp-arrive 500ms ease-out both;
    }
    .bp-signal :nth-child(2) {
      animation-delay: 70ms;
    }
    .bp-signal :nth-child(3) {
      animation-delay: 140ms;
    }
    .bp-signal :nth-child(4) {
      animation-delay: 210ms;
    }
    .bp-signal :nth-child(5) {
      animation-delay: 280ms;
    }
    .bp-signal :nth-child(6) {
      animation-delay: 420ms;
    }
  }
  @keyframes bp-arrive {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }
</style>
