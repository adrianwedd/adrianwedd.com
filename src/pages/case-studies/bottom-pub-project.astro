---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import cohortRaw from '../../data/bottom-pub-cohort-findings.json';
import manifestRaw from '../../data/bottom-pub-release-manifest.json';
import {
  computePairs,
  a3Position,
  a3ThreadWidth,
  a1x,
  b2Radius,
  B2_RINGS,
  goldenAnglePack,
  type ComputedPair,
} from '../../lib/bottom-pub-charts';

const cohort = cohortRaw as typeof cohortRaw & {
  meta: {
    financial_survey_n: number;
    pledge_linked_n: number;
    no_linked_pledge_n: number;
    eoi_n: number;
    community_survey_n: number;
  };
  pairs: Array<{
    slug: string;
    label: string;
    group: 'conditions' | 'info';
    pledged: number;
    not_pledged: number;
  }>;
  eoi_skills: {
    published: Array<{ slug: string; label: string; count: number }>;
    zero: Array<{ slug: string; label: string }>;
    suppressed: Array<{ slug: string; label: string | null; disposition: string; reason: string }>;
    suppressed_note: string;
  };
};
const manifest = manifestRaw as typeof manifestRaw;

const allPairs = computePairs(cohort.pairs, cohort.meta);
const conditions = allPairs.filter((p) => p.group === 'conditions');
const infoNeeds = allPairs.filter((p) => p.group === 'info');
const fmt = (v: number) => v.toFixed(1);
const grant = allPairs.find((p) => p.slug === 'grant-cofunding')!;

/* -------------------------------------------------------------------------
 * A3 tension field — the hero. Only grant co-funding is labelled; everything
 * else is desaturated field. x = Δpp / 16 × half-width; y = pooled prevalence,
 * linear max→min. Thread stroke = cohort% / 18.
 * ---------------------------------------------------------------------- */
const pooledMax = Math.max(...conditions.map((p) => p.pooled));
const pooledMin = Math.min(...conditions.map((p) => p.pooled));
const HERO_FRAME = { cx: 500, half: 380, yTop: 70, yBot: 330 };
const heroNodes = conditions.map((p, i) => ({
  ...p,
  idx: i + 1,
  ...a3Position(p, pooledMax, pooledMin, HERO_FRAME),
}));
const heroPole = {
  pledge: { x: HERO_FRAME.cx + HERO_FRAME.half + 40, y: (HERO_FRAME.yTop + HERO_FRAME.yBot) / 2 },
  noLink: { x: HERO_FRAME.cx - HERO_FRAME.half - 40, y: (HERO_FRAME.yTop + HERO_FRAME.yBot) / 2 },
};
const heroA3Alt = `A tension field of eleven conditions from the financial survey, computed at build time. Most sit near a shared zero-difference line. One stands apart: grant co-funding, ${fmt(grant.p90)} percent among pledge-linked respondents versus ${fmt(grant.p55)} percent among those with no linked pledge.`;

/* -------------------------------------------------------------------------
 * Exhibit 8 — A3 explained, numbered legend (no per-node label collision
 * layout; the full pair is printed in the table twin below instead).
 * ---------------------------------------------------------------------- */
const A3E_FRAME = { cx: 340, half: 260, yTop: 60, yBot: 460 };
const a3eNodes = conditions.map((p, i) => ({ ...p, idx: i + 1, ...a3Position(p, pooledMax, pooledMin, A3E_FRAME) }));
const a3ePole = {
  pledge: { x: A3E_FRAME.cx + A3E_FRAME.half + 60, y: (A3E_FRAME.yTop + A3E_FRAME.yBot) / 2 },
  noLink: { x: A3E_FRAME.cx - A3E_FRAME.half - 60, y: (A3E_FRAME.yTop + A3E_FRAME.yBot) / 2 },
};

/* -------------------------------------------------------------------------
 * Exhibit 9 — A1, all twenty options on a shared 0–100% axis, dumbbell pairs,
 * descending by pledged % within CONDITIONS then INFORMATION NEEDED.
 * ---------------------------------------------------------------------- */
const A1_AXIS = { x0: 0, x1: 560 };
const rowH = 30;
const headH = 26;
const groupGap = 20;
type A1Row = { kind: 'head'; label: string; y: number } | { kind: 'pair'; p: ComputedPair; y: number };
function a1layout(startY: number): { rows: A1Row[]; height: number } {
  const rows: A1Row[] = [];
  let y = startY;
  for (const [label, group] of [
    ['Conditions people set', [...conditions].sort((a, b) => b.p90 - a.p90)],
    ['Information people needed', [...infoNeeds].sort((a, b) => b.p90 - a.p90)],
  ] as const) {
    rows.push({ kind: 'head', label, y });
    y += headH;
    for (const p of group) {
      rows.push({ kind: 'pair', p, y });
      y += rowH;
    }
    y += groupGap;
  }
  return { rows, height: y };
}
const a1 = a1layout(30);
const a1ticks = [0, 25, 50, 75, 100];

/* -------------------------------------------------------------------------
 * B2 — the capacity weather map. r(count) = 172 − (count/9) × 108. Angle is
 * evenly spaced by descending count (declared arbitrary, carries no data);
 * dots within a cluster use golden-angle packing (decorative swarm only).
 * ---------------------------------------------------------------------- */
const B2_CENTER = { cx: 210, cy: 210 };
const b2Clusters = [...cohort.eoi_skills.published, ...cohort.eoi_skills.zero.map((z) => ({ ...z, count: 0 }))].sort(
  (a, b) => b.count - a.count,
);
const b2Layout = b2Clusters.map((c, i) => {
  const angle = -90 + i * (360 / b2Clusters.length);
  const rad = (angle * Math.PI) / 180;
  const r = b2Radius(c.count);
  const cx = B2_CENTER.cx + r * Math.cos(rad);
  const cy = B2_CENTER.cy + r * Math.sin(rad);
  const dots = c.count > 0 ? goldenAnglePack(c.count, 3.6).map((o) => ({ x: cx + o.dx, y: cy + o.dy })) : [];
  return { ...c, angle, r, cx, cy, dots };
});

/* -------------------------------------------------------------------------
 * Movement I — chronological spine (public, dated facts only).
 * ---------------------------------------------------------------------- */
const spine = [
  {
    date: '2026-05 → 2026-08-13',
    label: 'Community campaign to buy the Commercial Hotel, Cygnet, Tasmania',
    grey: false,
  },
  { date: '2026-06-03 → 2026-07-23', label: 'Community survey fielding window (frozen snapshot, n=32)', grey: false },
  {
    date: '2026-06-28',
    label: 'The financial survey closes and the pledges instrument opens — the same day',
    grey: false,
  },
  {
    date: '2026-08-13',
    label: 'Offer unsuccessful; the property is under contract to an undisclosed buyer',
    grey: false,
  },
  {
    date: '2026-08-18',
    label:
      'The outcome and the co-op formation meeting are published on the same page — no gap where the site kept asking for money after the offer had failed',
    grey: false,
  },
  { date: '2026-08-19', label: '"One truthful story" — the site stops telling two timelines at once', grey: false },
  {
    date: '2026-08-23',
    label: 'Cygnet Community Co-operative formation meeting — continuation, not this story’s subject',
    grey: true,
  },
];

/* -------------------------------------------------------------------------
 * Exhibit 6 — the review matrix. Only receipt-supported cells are filled.
 * ---------------------------------------------------------------------- */
type MatrixCol = 'claude' | 'codex' | 'gemini' | 'agy' | 'hostile' | 'self';
const matrixCols: Array<{ key: MatrixCol; label: string }> = [
  { key: 'claude', label: 'Claude session' },
  { key: 'codex', label: 'Codex' },
  { key: 'gemini', label: 'Gemini QA' },
  { key: 'agy', label: 'agy' },
  { key: 'hostile', label: 'Hostile re-read' },
  { key: 'self', label: 'Self-caught' },
];
const matrixRows: Array<{
  incident: string;
  receipt: string;
  marks: Partial<Record<MatrixCol, 'yes' | 'unverified'>>;
}> = [
  {
    incident: 'CSP style= attribute gaps',
    receipt: 'b553b2d',
    marks: { gemini: 'yes' },
  },
  {
    incident: 'Doc claimed one flagged test row when five existed',
    receipt: '634323a',
    marks: { claude: 'yes', codex: 'unverified' },
  },
  {
    incident: 'A sale year, an investor count, an uncited citation set — invented',
    receipt: '90d0200',
    marks: { hostile: 'yes' },
  },
  {
    incident: 'Falsified comparative claim, stale counts, a corpus-fragile test literal',
    receipt: '767ebd0',
    marks: { self: 'yes' },
  },
  {
    incident: 'JSON encoding bug (would have silently escaped non-ASCII on every run)',
    receipt: '1d5b972',
    marks: { agy: 'yes' },
  },
  {
    incident: 'linkage_coverage() bypassing the flagged-row filter',
    receipt: '1d5b972',
    marks: { codex: 'yes' },
  },
  {
    incident: 'Two flagged judgement calls closed (agent-contracts carve-out, market-memo reframe)',
    receipt: '8262679',
    marks: { claude: 'yes' },
  },
];

const pageUrl = '/case-studies/bottom-pub-project/';
const ogImage = '/og/case-studies/bottom-pub-project.png';
const meta = {
  title: "The campaign failed. The system didn't disappear.",
  description:
    'A failed pub bid left behind a frozen civic archive, a privacy pipeline that can’t leak, audited charts and a release system that distrusts its own checks.',
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  siteNameInTitle={false}
  heroAnimation="pulse"
  publishedDate="2026-08-20T00:00:00.000Z"
  tags={['case-study', 'data-visualisation', 'privacy-engineering', 'release-engineering']}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: meta.title,
      description: meta.description,
      url: new URL(pageUrl, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: '2026-08-20',
      keywords: ['case-study', 'data-visualisation', 'privacy-engineering', 'release-engineering'],
      author: { '@type': 'Person', name: 'Adrian Wedd', url: 'https://adrianwedd.com' },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pageUrl, Astro.site).href },
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Bottom Pub Project — financial-survey cohort findings (public derivative)',
      description:
        'Frozen, reproduced counts from a community financial survey (n=145), used to compute the charts on this page.',
      isBasedOn: 'https://bottom.pub/what-cygnet-told-us/',
      dateCreated: cohort.meta ? undefined : undefined,
      license: 'https://bottom.pub/what-cygnet-told-us/',
    })}
  />

  <div class="bp-case">
    <Breadcrumb crumbs={[{ label: 'Case Studies', href: '/case-studies/' }, { label: meta.title }]} />

    {/* ============================= HERO ============================= */}
    <header class="bp-hero" aria-label="Case study introduction">
      <p class="bp-kicker">Case file · The Bottom Pub Project · Cygnet, Tasmania · May–August 2026</p>
      <h1 class="bp-h1">{meta.title}</h1>
      <p class="bp-deck">
        A three-month bid to buy a Tasmanian pub didn't get the building. What it left behind: a byte-frozen civic
        archive, a privacy pipeline that structurally cannot leak, charts that carry their own receipts, and a release
        system that learned not to trust its own green checks.
      </p>
      <svg
        class="bp-hero-field"
        viewBox="0 0 1000 400"
        role="img"
        aria-label={heroA3Alt}
        preserveAspectRatio="xMidYMid meet"
      >
        <line
          x1={HERO_FRAME.cx}
          y1={HERO_FRAME.yTop - 20}
          x2={HERO_FRAME.cx}
          y2={HERO_FRAME.yBot + 20}
          class="bp-hero-axis"></line>
        {
          heroNodes.map((n) => (
            <>
              <line
                x1={heroPole.pledge.x}
                y1={heroPole.pledge.y}
                x2={n.x}
                y2={n.y}
                class={n.slug === 'grant-cofunding' ? 'bp-hero-thread bp-hero-thread--hot' : 'bp-hero-thread'}
                stroke-width={a3ThreadWidth(n.p90)}
              />
              <line
                x1={heroPole.noLink.x}
                y1={heroPole.noLink.y}
                x2={n.x}
                y2={n.y}
                class={n.slug === 'grant-cofunding' ? 'bp-hero-thread bp-hero-thread--hot' : 'bp-hero-thread'}
                stroke-width={a3ThreadWidth(n.p55)}
              />
            </>
          ))
        }
        {
          heroNodes.map((n) => (
            <circle
              cx={n.x}
              cy={n.y}
              r={n.slug === 'grant-cofunding' ? 5 : 3}
              class={n.slug === 'grant-cofunding' ? 'bp-hero-node bp-hero-node--hot' : 'bp-hero-node'}
            />
          ))
        }
        <text
          x={heroNodes.find((n) => n.slug === 'grant-cofunding')!.x}
          y={HERO_FRAME.yTop - 30}
          text-anchor="middle"
          class="bp-hero-label"
        >
          Grant co-funding — {fmt(grant.p90)}% vs {fmt(grant.p55)}%
        </text>
      </svg>
      <p class="bp-provenance">
        Drawn from 20 counts at build time. Nothing on this page is drawn by hand. Manifest digest
        <code>747988bcea7f…</code>
      </p>
      <a href="#evidence" class="bp-skip">Skip to the evidence ↓</a>
    </header>

    <main class="bp-body" data-pagefind-body>
      {/* ============================= MOVEMENT I ============================= */}
      <section class="bp-movement" aria-labelledby="m1-h">
        <p class="bp-movement-label">I · The building</p>
        <h2 id="m1-h" class="bp-movement-title">Every part was true. The relationship between the parts was false.</h2>
        <p class="bp-standfirst">
          After a failed acquisition, a community site's job is to stop selling the thing that didn't happen and start
          being honest about what did.
        </p>
        <p>
          On 13 August 2026 the offer for the Commercial Hotel — "the Bottom Pub" — was unsuccessful. The property went
          to an undisclosed buyer under contract. The working group didn't find out who. The site didn't publish a
          guess.
        </p>
        <p>
          The failure mode a campaign site risks after this point isn't lying outright — it's letting two true-at-
          different-times stories sit on the same page. The homepage kept a pledge CTA live for five days after the
          outcome was known internally; the fix, published 18 August, put the outcome and the next step — a co-operative
          formation meeting, 23 August — on the same page, the same day. A day later, a second pass (<code>51c32e4</code
          >, "one truthful story") swept every remaining surface — the footer, the schema.org identity, thirteen
          briefing pages — that still spoke as though the acquisition were live or a co-operative already existed.
          Neither was true.
        </p>
        <ol class="bp-timeline" aria-label="Corrected chronological spine">
          {
            spine.map((s) => (
              <li class={s.grey ? 'bp-timeline-item bp-timeline-item--grey' : 'bp-timeline-item'}>
                <span class="bp-timeline-date">{s.date}</span>
                <span class="bp-timeline-text">{s.label}</span>
              </li>
            ))
          }
        </ol>
      </section>

      {/* ============================= MOVEMENT II ============================= */}
      <section class="bp-movement" aria-labelledby="m2-h" id="evidence">
        <p class="bp-movement-label">II · Too useful to lose</p>
        <h2 id="m2-h" class="bp-movement-title">What the campaign produced that the sale couldn't take away.</h2>

        <article class="bp-exhibit" aria-labelledby="ex1-h">
          <p class="bp-exhibit-tag">EXHIBIT 1 · 2026-08-19 · <code>c0acca2</code></p>
          <h3 id="ex1-h">The archive</h3>
          <p>
            56 artefacts, byte-frozen. <code>scripts/build_archive_manifest.py</code> records a SHA-256 per artefact plus
            a digest over the whole set, frozen in <code>docs/archive/release-manifest.json</code>, and fails on four
            drift modes: content edited, artefact added, artefact removed, manifest hand-edited. Regenerating the
            manifest is a human review decision, never a build step.
          </p>
          <p>
            <code>/what-cygnet-told-us/</code> is a frozen snapshot (3 Jun–23 Jul 2026); the still-open live survey instrument
            is a separate route. Corrections found after the freeze route through a supersession file, never back into the
            frozen artefact — the correction sits in a band above the document, and the frozen bytes stay true to the day
            they were written.
          </p>
          <div
            class="bp-manifest-strip"
            role="img"
            aria-label={`56 artefact hashes from the release manifest, digest ${manifest.manifest_digest}`}
          >
            {
              Object.entries(manifest.artefacts).map(([name, hash]) => (
                <span class="bp-manifest-cell" title={name}>
                  {(hash as string).slice(0, 8)}
                </span>
              ))
            }
          </div>
          <details class="bp-details">
            <summary>Full manifest — 56 artefacts (table twin)</summary>
            <table class="bp-table">
              <caption>Every artefact in the frozen public archive, with its SHA-256 prefix.</caption>
              <thead><tr><th scope="col">Artefact</th><th scope="col">SHA-256 (first 16 chars)</th></tr></thead>
              <tbody>
                {
                  Object.entries(manifest.artefacts).map(([name, hash]) => (
                    <tr>
                      <>
                        <td>{name}</td>
                        <td>
                          <code>{(hash as string).slice(0, 16)}…</code>
                        </td>
                      </>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </details>
        </article>

        <article class="bp-exhibit" aria-labelledby="ex2-h">
          <p class="bp-exhibit-tag">EXHIBIT 2 · 2026-08-19 · <code>755b48a</code>, <code>283e1ec</code></p>
          <h3 id="ex2-h">The corpus</h3>
          <p>
            543 raw rows across four instruments — community survey, financial survey, EOI submissions, pledges — kept
            as "four distinct evidence types with their own denominators and never pooled." A fifth stream, contact-form
            enquiries, was deliberately excluded: a different reasonable-use expectation than a questionnaire response.
            Five rows confirmed as test data, submitted while testing the live forms, were flagged — not deleted — and
            filtered downstream by every analysis script that touches the corpus.
          </p>
          <p>
            Cross-instrument identity is resolved two ways, and only one is used for anything published: an exact-email
            graph (<code>headline: true</code>) and a name-only "candidate" graph admitted only as a sensitivity check.
            Community-survey email coverage sits at 57.6–59%, so every cross-instrument claim involving it reads "fewer
            than five were linkable by exact email" — never "fewer than five overlapped." That distinction matters
            because the exact-email graph is a lower bound, and the candidate graph is not evidence, it's a check on
            whether the headline number would survive being wrong about identity.
          </p>
          <p>
            The counts published from that corpus were reproduced independently: <code>f0283df</code> pins Pass 1's counts
            as literal values in <code>scripts/test_cohort_findings.py</code>, because the private corpus behind them is
            never present in CI by design — the published derivative has to hold its own line.
          </p>
        </article>

        <article class="bp-exhibit" aria-labelledby="ex3-h">
          <p class="bp-exhibit-tag">EXHIBIT 3 · 2026-08-19 · <code>scripts/corpus_deidentify.py:14-16</code></p>
          <h3 id="ex3-h">The pipeline that can't leak</h3>
          <blockquote class="bp-pullquote">
            "Dropping name, email and phone does NOT de-identify free text. In a town of this size a single sentence can
            identify someone through a business, a family relationship, a health circumstance or an anecdote only one
            person could tell."
          </blockquote>
          <p>
            356 proper nouns were reviewed by hand; 310 (87.1%) were kept. The reviewer of record is Claude Opus 5.
            "Shared-ness is not safety" — a token collision between two respondents' free text is not consent for
            either, so shared nouns queue for review too. An answer over 400 characters is a review trigger, not a
            redaction rule: of twenty long answers, eight were generalised, one redacted, eleven kept as written.
          </p>
          <p>
            Suppression happens in exactly one function, <code>disclose()</code>, on the way to anything tracked,
            published, or charted. Everything upstream of it can see respondent text; nothing downstream of it ever
            does.
          </p>
          <div
            class="bp-oneway"
            role="img"
            aria-label="One-way flow: respondent free text on the left, counts only on the right of the disclose() boundary"
          >
            <div class="bp-oneway-side bp-oneway-side--in">
              <span class="bp-oneway-caption">respondent free text</span>
              <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
              <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
              <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
            </div>
            <div class="bp-oneway-gate">disclose()</div>
            <div class="bp-oneway-side bp-oneway-side--out">
              <span class="bp-oneway-mark bp-oneway-mark--count">12</span>
              <span class="bp-oneway-mark bp-oneway-mark--count">45</span>
              <span class="bp-oneway-mark bp-oneway-mark--count">8</span>
              <span class="bp-oneway-caption">counts only</span>
            </div>
          </div>
          <p>
            The pipeline still let two public pages join into a disclosure risk. A seventh working-group profile went up
            on <code>/people/</code> with a name withheld, at the profile's own request. A later pass (<code
              >f32a063</code
            >) found that the same person had authored the draft funding strategy elsewhere on the public site — joining
            the two public artefacts would have re-identified them, so the conflict-of- interest disclosure was added
            explicitly rather than left implicit. A related fix (<code>011d468</code>) reframed an archive page that had
            described "the town's other licensed venue" as a "potential objector" — identifiable in a town this size —
            as a fact of law that applies to any party with standing, not a claim about a specific business.
          </p>
        </article>
      </section>

      {/* ============================= MOVEMENT III ============================= */}
      <section class="bp-movement" aria-labelledby="m3-h">
        <p class="bp-movement-label">III · Everything was green</p>
        <h2 id="m3-h" class="bp-movement-title">Every part was true. The relationship between the parts was false.</h2>

        <article class="bp-exhibit" aria-labelledby="ex4-h">
          <p class="bp-exhibit-tag">EXHIBIT 4 · 2026-08-19 · <code>c0acca2</code> (PR #134)</p>
          <h3 id="ex4-h">The wrong tree, walked end-to-end</h3>
          <p>
            Two release gates were both green. A frontmatter check proved a reviewer's name was stamped on a page. A
            candidate scanner proved the source text matched no denied pattern. The archive still shipped bytes that
            didn't match what had been reviewed.
          </p>
          <div
            class="bp-gates"
            role="img"
            aria-label="Sequence: two green gates, then a blank third row, then a digest mismatch, then the bound and verified state"
          >
            <div class="bp-gate-frame">
              <span class="bp-gate-num">1</span>
              <code class="bp-gate-row bp-gate-row--pass">frontmatter reviewer stamp ✓</code>
              <code class="bp-gate-row bp-gate-row--pass">candidate scanner ✓</code>
            </div>
            <div class="bp-gate-frame">
              <span class="bp-gate-num">2</span>
              <code class="bp-gate-row bp-gate-row--pass">frontmatter reviewer stamp ✓</code>
              <code class="bp-gate-row bp-gate-row--pass">candidate scanner ✓</code>
              <code class="bp-gate-row bp-gate-row--blank">served bytes == reviewed bytes</code>
            </div>
            <div class="bp-gate-frame">
              <span class="bp-gate-num">3</span>
              <code class="bp-gate-row bp-gate-row--pass">frontmatter reviewer stamp ✓</code>
              <code class="bp-gate-row bp-gate-row--pass">candidate scanner ✓</code>
              <code class="bp-gate-row bp-gate-row--fail">✗ 56 artefacts · digest mismatch</code>
            </div>
            <div class="bp-gate-frame">
              <span class="bp-gate-num">4</span>
              <code class="bp-gate-row bp-gate-row--bound">●━━━━━━━━● bound · 747988bcea7f… printed and checked</code>
            </div>
          </div>
          <blockquote class="bp-pullquote">
            "Every gate we had proved something adjacent to that and not that... Neither notices when the bytes change
            underneath a retained stamp — which is exactly what #126 was."
          </blockquote>
          <p>
            The fix binds the relationship the gates never checked: a SHA-256 per artefact plus a digest over the whole
            set, and a <code>--check</code> pass that cross-validates the attestation against the manifest, refusing to pass
            if <code>publication_state: ready</code> is claimed with items still pending, or if the cited digest has moved.
          </p>
          <p>
            The second half of the incident is the one nobody expected going in: <code>review-attestation.json</code>
            had said <code>quarantined</code> for days after that stopped being true, because nothing checked the
            <em>relationship</em> between the attestation and the manifest — each document, read alone, was internally fine.
            Two true documents. A false relationship between them.
          </p>
        </article>

        <article class="bp-exhibit" aria-labelledby="ex5-h">
          <p class="bp-exhibit-tag">EXHIBIT 5 · The same shape, six more times</p>
          <h3 id="ex5-h">The same shape, six more times</h3>
          <div class="bp-cardgrid">
            <div class="bp-card">
              <p class="bp-card-tie">●╌╌●&nbsp;→&nbsp;●──╳──●</p>
              <h4>Fourteen people, one placeholder name</h4>
              <p>
                14 community-survey rows carried the same placeholder name. Treating it as a name merged 14 people into
                one respondent with 14 responses — fabricating evidence rather than losing it. Caught before
                publication; the fix is regression-locked in <code>scripts/test_corpus_deidentify.py</code> so it can't be
                silently removed. (<code>755b48a</code>, <code>283e1ec</code>)
              </p>
            </div>
            <div class="bp-card">
              <p class="bp-card-tie">✓ local&nbsp;/&nbsp;✗ edge</p>
              <h4>The file existed. The URL still lied</h4>
              <p>
                Astro's <code>format: 'preserve'</code> built <code>what-cygnet-told-us.html</code>. Cloudflare
                308-redirected the trailing-slash canonical URL every internal link pointed to — invisible in the local
                build output, live only at the edge. Fixed by moving to a directory route. (<code>3a236e5</code>, PR
                #141)
              </p>
            </div>
            <div class="bp-card">
              <p class="bp-card-tie">open&nbsp;+&nbsp;closed → frozen&nbsp;|&nbsp;live</p>
              <h4>Open and closed at once</h4>
              <p>
                A semantic site reader caught the same page telling a visitor it was simultaneously open and closed. The
                fix split what had been conflated: the survey is an open instrument; the findings page is a frozen
                snapshot. A live row count must never mutate a published denominator. (<code>088ba16</code>)
              </p>
            </div>
            <div class="bp-card">
              <p class="bp-card-tie">☐☐☐☐☐ five required</p>
              <h4>"I looked" vs "I gave up"</h4>
              <p>
                Precision and recall are independent failure modes, and each needs its own mechanism. Reader v3 requires
                five booleans — read_complete, current_state_checked, historical_frame_checked, metadata_checked,
                cta_checked — so an empty findings list means "I looked," not "I gave up." (<code>0355cc3</code>)
              </p>
            </div>
            <div class="bp-card">
              <p class="bp-card-tie">1 file wrong, 3 still asserting</p>
              <h4>A fact flagged wrong in one file, asserted in three others</h4>
              <p>
                The archive's own case-study register had already flagged a fact as wrong — a sale year, an investor
                count — while three other files in the same archive still asserted it. Caught by a hostile re-read and
                corrected without quietly reinstating the unverified figures. (<code>90d0200</code>) The contrast case,
                same discipline working correctly: on a pledge total with no reconciled figure, the commit body states
                plainly, "No figure was invented." (<code>0355cc3</code>)
              </p>
            </div>
            <div class="bp-card">
              <p class="bp-card-tie">bypass_actors: []</p>
              <h4>A gate after the transition is an alarm, not a gate</h4>
              <p>
                A required <code>CI verify</code> check with an empty bypass-actor list, proven against the live GitHub API
                — <code>--admin</code> cannot override it. Documented lesson, verbatim: "a gate that runs after the protected
                transition is an alarm, not a gate." (<code>6fcd21b</code>, <code>e825bc3</code>)
              </p>
            </div>
          </div>
        </article>

        <article class="bp-exhibit" aria-labelledby="ex6-h">
          <p class="bp-exhibit-tag">EXHIBIT 6 · The reviewers disagreed. That was the point.</p>
          <h3 id="ex6-h">The reviewers disagreed. That was the point.</h3>
          <p>
            "Mechanisms certifying themselves" happened three separate times in three separate systems: a page triaged
            clean by a prior pass that certified its own earlier judgment instead of re-reading the page; an archive
            that had already flagged a fact wrong in one file while three others still asserted it; and the #126
            wrong-tree gates, which certified adjacent properties and never the served bytes. It's not a one-off bug.
            It's a failure class this project learned to name — and the only working defence found was forcing
            independent reviewers to disagree with each other and with the primary session.
          </p>
          <div class="bp-table-wrap">
            <table class="bp-table bp-matrix">
              <caption>Review matrix — who caught what, marked only where the receipt supports it.</caption>
              <thead>
                <tr>
                  <th scope="col">Incident</th>
                  {matrixCols.map((c) => <th scope="col">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  matrixRows.map((row) => (
                    <tr>
                      <th scope="row">
                        {row.incident} <code class="bp-receipt">{row.receipt}</code>
                      </th>
                      {matrixCols.map((c) => {
                        const mark = row.marks[c.key];
                        if (mark === 'yes')
                          return (
                            <td class="bp-mark-yes" aria-label="caught">
                              ✓
                            </td>
                          );
                        if (mark === 'unverified')
                          return (
                            <td class="bp-mark-hatch" aria-label="attribution unverified">
                              △
                            </td>
                          );
                        return <td aria-hidden="true" />;
                      })}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="bp-claimsbox" aria-labelledby="claims-h">
            <h4 id="claims-h">Claims that did not survive checking</h4>
            <p>
              This piece applies its own verification standard to its own story. Three tempting attributions from an
              earlier draft of this evidence pack were checked against the repository and retracted:
            </p>
            <ul>
              <li>
                <strong>"Gemini caught Unicode rewriting."</strong> No repo evidence. Retracted; the real, verified Gemini
                catch used instead is the CSP <code>style=</code> attribute gap above (<code>b553b2d</code>).
              </li>
              <li>
                <strong>"Fable transformed intuition into geometry."</strong> No commit, no file, no repo evidence connects
                Fable to any chart-geometry work. Retracted.
              </li>
              <li>
                <strong>"Codex caught the linkage-coverage bug."</strong> Two different linkage-coverage things exist in the
                record, and the earlier draft conflated them: a doc that undercounted flagged test rows (<code
                  >634323a</code
                >) really was corrected — but its commit trailer credits a Claude session, not Codex. The
                linkage-coverage catch that <em>is</em> genuinely Codex's is a different, later one — a function reading raw
                files independently of the row-flagging filter (<code>1d5b972</code>). Both are shown above, attributed
                to what the receipts actually say, not to what would make a better sentence.
              </li>
            </ul>
          </div>
        </article>
      </section>

