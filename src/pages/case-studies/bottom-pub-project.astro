---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import cohortRaw from '../../data/bottom-pub-cohort-findings.json';
import manifestRaw from '../../data/bottom-pub-release-manifest.json';
import {
  computePairs,
  a3Position,
  a3ThreadWidth,
  a1x,
  b2Radius,
  B2_RINGS,
  goldenAnglePack,
  type ComputedPair,
} from '../../lib/bottom-pub-charts';

const cohort = cohortRaw as typeof cohortRaw & {
  meta: {
    financial_survey_n: number;
    pledge_linked_n: number;
    no_linked_pledge_n: number;
    eoi_n: number;
    community_survey_n: number;
  };
  pairs: Array<{
    slug: string;
    label: string;
    group: 'conditions' | 'info';
    pledged: number;
    not_pledged: number;
  }>;
  eoi_skills: {
    published: Array<{ slug: string; label: string; count: number }>;
    zero: Array<{ slug: string; label: string }>;
    suppressed: Array<{ slug: string; label: string | null; disposition: string; reason: string }>;
    suppressed_note: string;
  };
};
const manifest = manifestRaw as typeof manifestRaw;

const allPairs = computePairs(cohort.pairs, cohort.meta);
const conditions = allPairs.filter((p) => p.group === 'conditions');
const infoNeeds = allPairs.filter((p) => p.group === 'info');
const fmt = (v: number) => v.toFixed(1);
const grant = allPairs.find((p) => p.slug === 'grant-cofunding')!;
const nFin = cohort.meta.financial_survey_n;
const nPledge = cohort.meta.pledge_linked_n;
const nNoPledge = cohort.meta.no_linked_pledge_n;
const nEoi = cohort.meta.eoi_n;
const nCommunity = cohort.meta.community_survey_n;

/* Hero — the conditions field. x = gap between the two groups, y = how many
 * people ticked the condition overall. Only grant co-funding is labelled. */
const pooledMax = Math.max(...conditions.map((p) => p.pooled));
const pooledMin = Math.min(...conditions.map((p) => p.pooled));
const HERO_FRAME = { cx: 500, half: 380, yTop: 70, yBot: 330 };
const heroNodes = conditions.map((p, i) => ({
  ...p,
  idx: i + 1,
  ...a3Position(p, pooledMax, pooledMin, HERO_FRAME),
}));
const heroPole = {
  pledge: { x: HERO_FRAME.cx + HERO_FRAME.half + 40, y: (HERO_FRAME.yTop + HERO_FRAME.yBot) / 2 },
  noLink: { x: HERO_FRAME.cx - HERO_FRAME.half - 40, y: (HERO_FRAME.yTop + HERO_FRAME.yBot) / 2 },
};
const heroAlt = `Eleven conditions from the financial survey, placed by the gap between people who also pledged and people who didn't. Almost all sit near the shared centre line. One stands apart: grant co-funding, ${fmt(grant.p90)} percent among pledge-linked respondents versus ${fmt(grant.p55)} percent among the rest.`;

/* Same field, numbered, for the machinery section. */
const A3E_FRAME = { cx: 340, half: 260, yTop: 60, yBot: 460 };
const a3eNodes = conditions.map((p, i) => ({ ...p, idx: i + 1, ...a3Position(p, pooledMax, pooledMin, A3E_FRAME) }));
const a3ePole = {
  pledge: { x: A3E_FRAME.cx + A3E_FRAME.half + 60, y: (A3E_FRAME.yTop + A3E_FRAME.yBot) / 2 },
  noLink: { x: A3E_FRAME.cx - A3E_FRAME.half - 60, y: (A3E_FRAME.yTop + A3E_FRAME.yBot) / 2 },
};

/* Dumbbell chart — all twenty options, one shared 0–100% axis. */
const A1_AXIS = { x0: 0, x1: 560 };
const rowH = 30;
const headH = 26;
const groupGap = 20;
type A1Row = { kind: 'head'; label: string; y: number } | { kind: 'pair'; p: ComputedPair; y: number };
function a1layout(startY: number): { rows: A1Row[]; height: number } {
  const rows: A1Row[] = [];
  let y = startY;
  for (const [label, group] of [
    ['What people would need to see first', [...conditions].sort((a, b) => b.p90 - a.p90)],
    ['What people wanted to know', [...infoNeeds].sort((a, b) => b.p90 - a.p90)],
  ] as const) {
    rows.push({ kind: 'head', label, y });
    y += headH;
    for (const p of group) {
      rows.push({ kind: 'pair', p, y });
      y += rowH;
    }
    y += groupGap;
  }
  return { rows, height: y };
}
const a1 = a1layout(30);
const a1ticks = [0, 25, 50, 75, 100];

/* Skills map — one dot per recorded offer; distance from the centre is the
 * count, angle carries no data. */
const B2_CENTER = { cx: 210, cy: 210 };
const b2Clusters = [...cohort.eoi_skills.published, ...cohort.eoi_skills.zero.map((z) => ({ ...z, count: 0 }))].sort(
  (a, b) => b.count - a.count,
);
const b2Layout = b2Clusters.map((c, i) => {
  const angle = -90 + i * (360 / b2Clusters.length);
  const rad = (angle * Math.PI) / 180;
  const r = b2Radius(c.count);
  const cx = B2_CENTER.cx + r * Math.cos(rad);
  const cy = B2_CENTER.cy + r * Math.sin(rad);
  const dots = c.count > 0 ? goldenAnglePack(c.count, 3.6).map((o) => ({ x: cx + o.dx, y: cy + o.dy })) : [];
  return { ...c, angle, r, cx, cy, dots };
});
const topSkill = b2Clusters[0];

const spine = [
  { date: 'May 2026', label: 'The campaign to buy the Commercial Hotel begins' },
  { date: '3 June – 23 July', label: `Community survey open (${nCommunity} responses in the frozen findings)` },
  { date: '28 June', label: 'The financial survey closes and the pledge form opens — the same day' },
  {
    date: '13 August',
    label: 'The offer is unsuccessful. The building goes under contract to a buyer we weren’t told about',
  },
  {
    date: '18 August',
    label: 'The homepage stops asking for pledges. The outcome and the next meeting go up together',
  },
  {
    date: '19 August',
    label: 'Footer, structured data and thirteen briefing pages brought into line with the outcome',
  },
  {
    date: '23 August',
    label: 'Cygnet Community Co-operative formation meeting — the next group’s story, not this one’s',
    grey: true,
  },
];

const pageUrl = '/case-studies/bottom-pub-project/';
const ogImage = '/og/case-studies/bottom-pub-project.png';
const meta = {
  title: 'We tried to buy the Bottom Pub. We didn’t.',
  description:
    'A community bid for Cygnet’s Commercial Hotel failed. What survived: 543 responses, a small-town privacy process, and a site that had to stop lying by omission.',
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  siteNameInTitle={false}
  heroAnimation="pulse"
  publishedDate="2026-08-20T00:00:00.000Z"
  tags={['case-study', 'data-visualisation', 'privacy-engineering', 'community']}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: meta.title,
      description: meta.description,
      url: new URL(pageUrl, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: '2026-08-20',
      keywords: ['case-study', 'data-visualisation', 'privacy-engineering', 'community'],
      author: { '@type': 'Person', name: 'Adrian Wedd', url: 'https://adrianwedd.com' },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pageUrl, Astro.site).href },
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Bottom Pub Project — financial-survey cohort findings (public derivative)',
      description: `Frozen, reproduced counts from a community financial survey (n=${nFin}), used to compute the charts on this page.`,
      isBasedOn: 'https://bottom.pub/what-cygnet-told-us/',
      license: 'https://bottom.pub/what-cygnet-told-us/',
    })}
  />

  <div class="bp-case">
    <Breadcrumb crumbs={[{ label: 'Case Studies', href: '/case-studies/' }, { label: meta.title }]} />

    <header class="bp-hero" aria-label="Case study introduction">
      <p class="bp-kicker">Case study · Cygnet, Tasmania · May–August 2026</p>
      <h1 class="bp-h1">{meta.title}</h1>
      <p class="bp-deck">
        For three months in 2026, a group of people in Cygnet tried to bring the Commercial Hotel into community
        ownership. The offer failed. This is about what was left over.
      </p>
      <svg
        class="bp-hero-field"
        viewBox="0 0 1000 400"
        role="img"
        aria-label={heroAlt}
        preserveAspectRatio="xMidYMid meet"
      >
        <line
          x1={HERO_FRAME.cx}
          y1={HERO_FRAME.yTop - 20}
          x2={HERO_FRAME.cx}
          y2={HERO_FRAME.yBot + 20}
          class="bp-hero-axis"></line>
        {
          heroNodes.map((n) => (
            <>
              <line
                x1={heroPole.pledge.x}
                y1={heroPole.pledge.y}
                x2={n.x}
                y2={n.y}
                class={n.slug === 'grant-cofunding' ? 'bp-hero-thread bp-hero-thread--hot' : 'bp-hero-thread'}
                stroke-width={a3ThreadWidth(n.p90)}
              />
              <line
                x1={heroPole.noLink.x}
                y1={heroPole.noLink.y}
                x2={n.x}
                y2={n.y}
                class={n.slug === 'grant-cofunding' ? 'bp-hero-thread bp-hero-thread--hot' : 'bp-hero-thread'}
                stroke-width={a3ThreadWidth(n.p55)}
              />
            </>
          ))
        }
        {
          heroNodes.map((n) => (
            <circle
              cx={n.x}
              cy={n.y}
              r={n.slug === 'grant-cofunding' ? 5 : 3}
              class={n.slug === 'grant-cofunding' ? 'bp-hero-node bp-hero-node--hot' : 'bp-hero-node'}
            />
          ))
        }
        <text
          x={heroNodes.find((n) => n.slug === 'grant-cofunding')!.x}
          y={HERO_FRAME.yTop - 30}
          text-anchor="middle"
          class="bp-hero-label"
        >
          Grant co-funding — {fmt(grant.p90)}% vs {fmt(grant.p55)}%
        </text>
      </svg>
      <p class="bp-caption">
        What {nFin} people said they’d need before investing, placed by how differently pledgers and non-pledgers answered.
        Almost everything sits on the centre line.
      </p>
    </header>

    <main class="bp-body" data-pagefind-body>
      <section class="bp-movement bp-movement--first" aria-label="Introduction">
        <p>
          On 13 August 2026 the offer for the Commercial Hotel — the Bottom Pub, to anyone local — was unsuccessful. The
          building went under contract to a buyer whose name we weren’t told.
        </p>
        <p>
          By then we had something else: hundreds of responses from locals, a working picture of what people wanted from
          the place and what they’d need to see before putting money in, a pile of research and due diligence, and a
          website built around an awkward constraint — <strong
            >in a town this small, “anonymous” data often isn’t anonymous at all.</strong
          >
        </p>
        <p>
          So when the campaign ended, I didn’t want the site to become a digital corpse. I wanted the useful parts to
          survive. This is what that took, and what we found out along the way.
        </p>
      </section>

      {/* ============================= 1 ============================= */}
      <section class="bp-movement" aria-labelledby="s1-h">
        <p class="bp-movement-label">1</p>
        <h2 id="s1-h" class="bp-movement-title">We asked Cygnet.</h2>
        <p>
          Four separate questionnaires ran over the three months: a community survey about what people wanted from the
          pub ({nCommunity} responses), a financial survey about what they’d need to see before investing ({nFin}),
          expressions of interest in helping ({nEoi}), and non-binding pledges. Five hundred and forty-three responses
          in all. Five of those were our own test entries, left in the data but flagged so nothing counts them.
        </p>
        <p>
          The financial survey has the most to say. {nPledge} of its {nFin} respondents could be matched by email to a pledge;
          {nNoPledge} couldn’t. It’s tempting to read those as the believers and the sceptics. The chart at the top of this
          page is what happens when you ask the data: each condition sits where the gap between the two groups puts it, and
          almost all of them sit on the centre line. Both groups wanted the same things in roughly the same proportions —
          clear governance first, a credible business plan, an asset lock, honesty about the risks. The one condition that
          stands apart is grant co-funding: {fmt(grant.p90)}% of the pledge-linked group set it as a condition, against {
            fmt(grant.p55)
          }% of the rest. The people who had already put a number next to their name were the ones most keen that some
          of the money come from somewhere else.
        </p>

        <figure class="bp-figure bp-figure--wide">
          <svg
            class="bp-a1"
            viewBox={`0 0 700 ${a1.height}`}
            role="img"
            aria-label={`All twenty options from the financial survey, comparing the ${nPledge} pledge-linked respondents with the ${nNoPledge} who had no linked pledge, on one shared 0 to 100 percent axis. Every value is printed in the table at the end of the page.`}
          >
            {
              a1ticks.map((t) => (
                <>
                  <line
                    x1={a1x(t, A1_AXIS.x0, A1_AXIS.x1) + 120}
                    y1="12"
                    x2={a1x(t, A1_AXIS.x0, A1_AXIS.x1) + 120}
                    y2={a1.height - 10}
                    class="bp-a1-axis"
                  />
                  <text x={a1x(t, A1_AXIS.x0, A1_AXIS.x1) + 120} y="10" text-anchor="middle" class="bp-a1-ticklabel">
                    {t}%
                  </text>
                </>
              ))
            }
            {
              a1.rows.map((row) =>
                row.kind === 'head' ? (
                  <text x="0" y={row.y - 8} class="bp-a1-grouphead">
                    {row.label.toUpperCase()}
                  </text>
                ) : (
                  <>
                    <text x="0" y={row.y + 4} class="bp-a1-rowlabel">
                      {row.p.label}
                    </text>
                    <line
                      x1={a1x(row.p.p55, A1_AXIS.x0, A1_AXIS.x1) + 120}
                      y1={row.y}
                      x2={a1x(row.p.p90, A1_AXIS.x0, A1_AXIS.x1) + 120}
                      y2={row.y}
                      class="bp-a1-conn"
                    />
                    <circle
                      cx={a1x(row.p.p55, A1_AXIS.x0, A1_AXIS.x1) + 120}
                      cy={row.y}
                      r="4.5"
                      class="bp-a1-dot bp-a1-dot--nolink"
                    />
                    <circle
                      cx={a1x(row.p.p90, A1_AXIS.x0, A1_AXIS.x1) + 120}
                      cy={row.y}
                      r="4.5"
                      class="bp-a1-dot bp-a1-dot--pledge"
                    />
                  </>
                ),
              )
            }
          </svg>
          <figcaption class="bp-legend">
            <span class="bp-legend-swatch bp-legend-swatch--pledge"></span> also pledged ({nPledge}) &nbsp;&nbsp;
            <span class="bp-legend-swatch bp-legend-swatch--nolink"></span> no linked pledge ({nNoPledge}). What people
            wanted to know tells the same story: the total capital required first, then how a co-op works, then what
            happens to the money if it falls over. Full numbers at the end of the page.
          </figcaption>
        </figure>

        <figure class="bp-figure">
          <svg
            class="bp-b2"
            viewBox="0 0 420 420"
            role="img"
            aria-label={`What ${nEoi} people offered to do: one dot per recorded skill. Distance from the centre is the count; angle means nothing.`}
          >
            {
              B2_RINGS.map((tick) => (
                <>
                  <circle
                    cx={B2_CENTER.cx}
                    cy={B2_CENTER.cy}
                    r={b2Radius(tick)}
                    class={tick === 0 ? 'bp-b2-ring bp-b2-ring--absence' : 'bp-b2-ring'}
                  />
                  <text
                    x={B2_CENTER.cx}
                    y={B2_CENTER.cy - b2Radius(tick) - 4}
                    text-anchor="middle"
                    class="bp-b2-ringlabel"
                  >
                    {tick} {tick === 1 ? 'person' : 'people'}
                  </text>
                </>
              ))
            }
            {
              b2Layout.map((c) =>
                c.count === 0 ? (
                  <>
                    <circle cx={c.cx} cy={c.cy} r="7" class="bp-b2-dot bp-b2-dot--zero" />
                    <text x={c.cx} y={c.cy - 12} text-anchor="middle" class="bp-b2-label">
                      {c.label} · 0
                    </text>
                  </>
                ) : (
                  <>
                    {c.dots.map((d) => (
                      <circle cx={d.x} cy={d.y} r="3.4" class="bp-b2-dot" />
                    ))}
                    <text x={c.cx} y={c.cy - (c.count > 6 ? 24 : 18)} text-anchor="middle" class="bp-b2-label">
                      {c.label} · {c.count}
                    </text>
                  </>
                ),
              )
            }
            <circle cx={B2_CENTER.cx} cy={B2_CENTER.cy} r="30" class="bp-b2-core"></circle>
            <text x={B2_CENTER.cx} y={B2_CENTER.cy - 3} text-anchor="middle" class="bp-b2-corelabel">{nEoi} people</text
            >
            <text x={B2_CENTER.cx} y={B2_CENTER.cy + 10} text-anchor="middle" class="bp-b2-corelabel">offered help</text
            >
          </svg>
          <figcaption class="bp-caption">
            {nEoi} people said what they could do. {topSkill.label} was the most-offered skill, then hospitality, then community
            work. Nobody recorded a legal offer — that’s the empty dashed ring at the edge, drawn because zero is an answer
            too. Five more areas were offered by fewer than five people each, and the site doesn’t publish counts that small.
            The next section is about why.
          </figcaption>
        </figure>
      </section>

      {/* ============================= 2 ============================= */}
      <section class="bp-movement" aria-labelledby="s2-h">
        <p class="bp-movement-label">2</p>
        <h2 id="s2-h" class="bp-movement-title">Small-town privacy is weird.</h2>
        <p>
          Dropping names, emails and phone numbers from a survey doesn’t make it anonymous here. A single free-text
          sentence can identify someone through their business, a family relationship, a health circumstance, or an
          anecdote only one person in town could tell.
        </p>
        <p>
          So the free text was read, by hand, before any of it went near a public page. Every proper noun — 356 of them
          — was looked at; 310 were kept, the rest generalised or cut. A long answer was treated as a reason to look
          harder, not a reason to redact: of the twenty answers over 400 characters, eleven were published as written,
          eight were generalised and one was removed. Anything that would come out as a count of fewer than five people
          isn’t published at all, because in a town this size “three people said” is a short list. And the only thing
          that crosses from the private responses to the public site is a number. Free text goes in; counts come out.
        </p>
        <div
          class="bp-oneway"
          role="img"
          aria-label="One-way flow: respondents’ free text on the left, counts only on the right of a single disclosure boundary"
        >
          <div class="bp-oneway-side bp-oneway-side--in">
            <span class="bp-oneway-caption">what people wrote</span>
            <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
            <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
            <span class="bp-oneway-mark bp-oneway-mark--filled"></span>
          </div>
          <div class="bp-oneway-gate">review · count · floor of 5</div>
          <div class="bp-oneway-side bp-oneway-side--out">
            <span class="bp-oneway-mark bp-oneway-mark--count">12</span>
            <span class="bp-oneway-mark bp-oneway-mark--count">45</span>
            <span class="bp-oneway-mark bp-oneway-mark--count">8</span>
            <span class="bp-oneway-caption">what gets published</span>
          </div>
        </div>
        <p>Two things still caught us out.</p>
        <h3>Fourteen people turned into one</h3>
        <p>
          Fourteen community-survey responses had the same placeholder name in the name field. The first attempt to link
          responses across the four questionnaires treated a shared name as a shared person, and quietly merged fourteen
          residents into one very opinionated respondent with fourteen answers. That isn’t losing evidence; it’s
          inventing it. It was caught before anything was published, and the check that caught it is now permanent.
        </p>
        <h3>Two public pages, one person</h3>
        <p>
          A working-group member asked for their name to be left off the team page, and it was. The same person had
          written the draft funding strategy, which sat elsewhere on the site under their name. Each page was fine on
          its own. Read together, they identified exactly the person who had asked not to be. The fix was to put the
          relationship on the page as a plain conflict-of-interest disclosure rather than leave it as a puzzle anyone
          could solve.
        </p>
        <p>
          A near relative: a research page described “the town’s other licensed venue” as a likely objector to a liquor
          licence. There is one other licensed venue. The page now says any party with standing can object — which is
          the law — and points at nobody.
        </p>
      </section>

      {/* ============================= 3 ============================= */}
      <section class="bp-movement" aria-labelledby="s3-h">
        <p class="bp-movement-label">3</p>
        <h2 id="s3-h" class="bp-movement-title">The website lied without saying anything false.</h2>
        <p>
          Nothing on the site was false when it was written. That turned out not to be enough. The offer failed on 13
          August; the homepage kept asking people to pledge for five more days. Every sentence on it had been true in
          July. The page as a whole was asking for money for a thing that wasn’t going to happen. On 18 August the
          outcome and the next step — a co-operative formation meeting on 23 August — went up together, so there was
          never a version of the site where the bad news existed without the next thing to do. A day later a sweep of
          the footer, the structured data and thirteen briefing pages found more of the same: text that spoke as if the
          bid were live or the co-op already existed. Neither was true.
        </p>
        <ol class="bp-timeline" aria-label="What happened, in order">
          {
            spine.map((s) => (
              <li class={s.grey ? 'bp-timeline-item bp-timeline-item--grey' : 'bp-timeline-item'}>
                <span class="bp-timeline-date">{s.date}</span>
                <span class="bp-timeline-text">{s.label}</span>
              </li>
            ))
          }
        </ol>
        <p>The same shape turned up in smaller places.</p>
        <h3>Open and closed at once</h3>
        <p>
          One page told a visitor the community survey was still open and, further down, that it had closed. Both were
          true — of different things. The form was open; the findings were a snapshot of responses up to 23 July. The
          page was split in two: a live survey, and a findings page whose numbers don’t change when someone fills in the
          form.
        </p>
        <h3>What was reviewed and what was served</h3>
        <p>
          The archive — 56 documents, frozen so they stay as they were on the day they were written — had two checks on
          it. One proved each document carried a reviewer’s sign-off. One proved its text contained no banned phrasing.
          Both were green. The published archive still contained bytes that didn’t match what had been reviewed, because
          nothing checked the relationship between the two. The sign-off was on the file; the file had changed
          underneath it.
        </p>
        <div
          class="bp-gates"
          role="img"
          aria-label="Four panels: two green checks; the same two with a blank third row for served-equals-reviewed; the third row failing on a fingerprint mismatch; and finally the two bound together"
        >
          <div class="bp-gate-frame">
            <span class="bp-gate-num">before</span>
            <code class="bp-gate-row bp-gate-row--pass">reviewer sign-off ✓</code>
            <code class="bp-gate-row bp-gate-row--pass">no banned language ✓</code>
          </div>
          <div class="bp-gate-frame">
            <span class="bp-gate-num">the missing check</span>
            <code class="bp-gate-row bp-gate-row--pass">reviewer sign-off ✓</code>
            <code class="bp-gate-row bp-gate-row--pass">no banned language ✓</code>
            <code class="bp-gate-row bp-gate-row--blank">served = reviewed ?</code>
          </div>
          <div class="bp-gate-frame">
            <span class="bp-gate-num">what it found</span>
            <code class="bp-gate-row bp-gate-row--pass">reviewer sign-off ✓</code>
            <code class="bp-gate-row bp-gate-row--pass">no banned language ✓</code>
            <code class="bp-gate-row bp-gate-row--fail">✗ fingerprint mismatch</code>
          </div>
          <div class="bp-gate-frame">
            <span class="bp-gate-num">now</span>
            <code class="bp-gate-row bp-gate-row--bound">●━━━━━━━━● review and bytes bound together</code>
          </div>
        </div>
        <p>
          The archive now carries a fingerprint for every document and one for the whole set, and a check that fails if
          a fingerprint has moved or if the review record says “ready” while items are still pending. (The review record
          had itself been saying “quarantined” for days after that stopped being true.) That’s the pattern in all of
          these: each part true, the relationship between the parts wrong, and no check on any single part will tell
          you.
        </p>
      </section>

      {/* ============================= 4 ============================= */}
      <section class="bp-movement" aria-labelledby="s4-h">
        <p class="bp-movement-label">4</p>
        <h2 id="s4-h" class="bp-movement-title">Some of our clever ideas were wrong.</h2>
        <h3>The radar chart</h3>
        <p>
          Early on there was a second way of drawing the conditions data: a radar, eleven spokes, one polygon for the
          pledgers and one for everyone else. In the first version the spoke lengths were placed by eye. It looked great
          — two visibly different shapes, two visibly different kinds of person. When every spoke was bound to the
          actual percentage, same rule for both polygons, the two shapes nearly sat on top of each other. The honest
          chart was less interesting than the sketch. It didn’t ship.
        </p>
        <p>
          The field at the top of this page, and the dumbbell chart above, are what did. Every mark on them is computed
          from the published counts when the page is built. Less dramatic — and what the {nFin} people actually said.
        </p>
        <h3>The funnel</h3>
        <p>
          The obvious story to tell with four questionnaires is a journey: survey, then interest, then pledge. The
          calendar forbids it. The financial survey closed and the pledge form opened on the same day, 28 June. Everyone
          who did both did the survey first because that was the only order available, not because anyone was
          “converted”. The build now rejects words like funnel, stage and journey wherever those two questionnaires are
          compared.
        </p>
        <div
          class="bp-calendar"
          role="img"
          aria-label="Two fielding windows on a shared time axis, touching at 28 June 2026; a would-be funnel arrow is drawn and crossed out"
        >
          <div class="bp-calendar-track">
            <div class="bp-calendar-bar bp-calendar-bar--financial">financial survey (closes 28 Jun)</div>
          </div>
          <div class="bp-calendar-track">
            <div class="bp-calendar-bar bp-calendar-bar--pledges">pledges (open 28 Jun)</div>
          </div>
          <div class="bp-calendar-funnel" aria-hidden="true">then → funnel → stage → journey → converted</div>
        </div>
      </section>

      {/* ============================= CLOSE ============================= */}
      <section class="bp-movement bp-coda" aria-labelledby="coda-h">
        <h2 id="coda-h" class="bp-movement-title bp-visually-hidden">What was left</h2>
        <p>We didn’t get the pub.</p>
        <p>
          But the work is still useful: the research is preserved, the community data can be published without exposing
          the people who supplied it, and the next group — starting with the co-operative meeting on 23 August — doesn’t
          have to start from zero.
        </p>
        <p>Sometimes that’s what a failed project leaves you with.</p>
        <p class="bp-links">
          <a href="https://bottom.pub/what-cygnet-told-us/">What Cygnet told us, on bottom.pub →</a>
          <br />
          <a href="/case-studies/bottom-pub-co-op/"
            >The first case study: a website that is not allowed to accidentally lie →</a
          >
        </p>
      </section>

      {/* ============================= MACHINERY ============================= */}
      <section class="bp-movement bp-machinery" aria-labelledby="mach-h">
        <h2 id="mach-h" class="bp-movement-title">Want the machinery?</h2>
        <p class="bp-methodology">
          Technical notes, chart encodings, the full tables and the archive manifest. Nothing above depends on reading
          this.
        </p>

        <details class="bp-details">
          <summary>Technical notes</summary>
          <ul class="bp-notes">
            <li>
              <strong>Corpus.</strong> 543 rows across four instruments (community survey, financial survey, EOI, pledges),
              each with its own denominator ({nFin} / {nEoi} / {nCommunity}) and never pooled. Contact-form enquiries
              were deliberately excluded — a different reasonable-use expectation from a questionnaire. Five confirmed
              test rows are flagged, not deleted, and filtered by every script that touches the corpus.
            </li>
            <li>
              <strong>Identity.</strong> Cross-instrument linkage is by exact email only, and is a lower bound: a respondent
              who pledged under a different address counts as “no linked pledge”. A name-only candidate graph exists as a
              sensitivity check and is never used for anything published. The placeholder-name overmerge is regression-locked
              in the de-identification tests.
            </li>
            <li>
              <strong>Disclosure.</strong> Suppression happens in exactly one function on the way to anything tracked, published
              or charted; nothing downstream of it sees respondent text. Floor is five. For the EOI skills map, two sub-five
              categories are named without a count (a fixed form option or free-text catch-all points at nobody); three withhold
              even the label because each maps onto a role already attached to a publicly named working-group member.
            </li>
            <li>
              <strong>Free text.</strong> 356 proper nouns reviewed by hand, 310 kept (87.1%). A token shared between two
              respondents is not treated as safe for either. Answers over 400 characters are a review trigger, not a redaction
              rule.
            </li>
            <li>
              <strong>Archive.</strong> 56 artefacts, SHA-256 per artefact plus a digest over the set, frozen in a release
              manifest. The build fails on content edited, artefact added, artefact removed, or manifest hand-edited; a <code
                >--check</code
              > pass cross-validates the review attestation against the manifest and refuses <code
                >publication_state: ready</code
              > with pending items or a moved digest. Regenerating the manifest is a human decision, never a build step. Corrections
              found after the freeze go in a supersession file shown above the frozen document; the frozen bytes don’t change.
            </li>
            <li>
              <strong>Frozen vs live.</strong> The findings page is a snapshot (3 Jun–23 Jul 2026); the survey form is a separate
              route. A live row count never mutates a published denominator.
            </li>
            <li>
              <strong>Language guard.</strong> A build check bans lifecycle words (then, funnel, stage, journey, converted)
              across any instrument pair whose fielding windows didn’t overlap.
            </li>
            <li>
              <strong>Edge.</strong> The trailing-slash failure came from a <code>format: 'preserve'</code> build behind a
              host that 308-redirects the canonical directory URL; fixed by moving to a directory route. The required verify
              check on the repository has an empty bypass-actor list, confirmed against the live API: admin can’t override
              it.
            </li>
            <li>
              <strong>Reproduction.</strong> Every count on this page was re-derived by an independent script from the flagged
              corpus and matched the analysis exactly; the published derivative pins those values as test literals because
              the private corpus is never present in CI.
            </li>
            <li>
              <strong>Still open.</strong> What worried the people who pledged anyway; whether offered skills line up with
              the operational burden the project named; which themes recur across instruments. Not analysed, not claimed.
            </li>
          </ul>
        </details>

        <details class="bp-details">
          <summary>The conditions field, numbered, with its encoding</summary>
          <svg class="bp-a3e" viewBox="0 0 700 500" role="img" aria-label={heroAlt}>
            <line
              x1={A3E_FRAME.cx}
              y1={A3E_FRAME.yTop - 20}
              x2={A3E_FRAME.cx}
              y2={A3E_FRAME.yBot + 20}
              class="bp-a3e-axis"></line>
            {
              a3eNodes.map((n) => (
                <>
                  <line
                    x1={a3ePole.pledge.x}
                    y1={a3ePole.pledge.y}
                    x2={n.x}
                    y2={n.y}
                    class="bp-a3e-thread bp-a3e-thread--pledge"
                    stroke-width={a3ThreadWidth(n.p90)}
                  />
                  <line
                    x1={a3ePole.noLink.x}
                    y1={a3ePole.noLink.y}
                    x2={n.x}
                    y2={n.y}
                    class="bp-a3e-thread bp-a3e-thread--nolink"
                    stroke-width={a3ThreadWidth(n.p55)}
                  />
                </>
              ))
            }
            {
              a3eNodes.map((n) => (
                <>
                  <circle cx={n.x} cy={n.y} r={7} class="bp-a3e-node" />
                  <text x={n.x} y={n.y + 4} text-anchor="middle" class="bp-a3e-idx">
                    {n.idx}
                  </text>
                </>
              ))
            }
          </svg>
          <table class="bp-table">
            <caption>Conditions, with the pair behind each numbered node.</caption>
            <thead
              ><tr
                ><th scope="col">#</th><th scope="col">Condition</th><th scope="col">Pledge-linked (n={nPledge})</th><th
                  scope="col">No linked pledge (n={nNoPledge})</th
                ><th scope="col">Δpp</th></tr
              ></thead
            >
            <tbody>
              {
                conditions.map((p, i) => (
                  <tr class={p.slug === 'grant-cofunding' ? 'bp-row-hot' : ''}>
                    <td>{i + 1}</td>
                    <td>{p.label}</td>
                    <td>{fmt(p.p90)}%</td>
                    <td>{fmt(p.p55)}%</td>
                    <td>
                      {p.delta >= 0 ? '+' : ''}
                      {fmt(p.delta)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <table class="bp-table">
            <caption>Encoding</caption>
            <tbody>
              <tr><td>x</td><td>Δpp = p90 − p55, mapped Δ/16 × half-width about the centre line</td></tr>
              <tr
                ><td>y</td><td>pooled prevalence (pledged+not_pledged)/{nFin}, linear from max (top) to min (bottom)</td
                ></tr
              >
              <tr><td>thread stroke</td><td>cohort% / 18</td></tr>
              <tr><td>node radius</td><td>constant</td></tr>
            </tbody>
          </table>
          <p class="bp-methodology">
            An alternate lean-ratio transform of the x-axis was tested; the grant co-funding outlier and the overall
            shape survived it. Percentage points were kept because the units are native.
          </p>
        </details>

        <details class="bp-details">
          <summary>All twenty options — full table</summary>
          <table class="bp-table">
            <thead
              ><tr
                ><th scope="col">Group</th><th scope="col">Option</th><th scope="col">Pledge-linked</th><th scope="col"
                  >No linked pledge</th
                ></tr
              ></thead
            >
            <tbody>
              {
                [...conditions, ...infoNeeds].map((p) => (
                  <tr>
                    <td>{p.group === 'conditions' ? 'Condition' : 'Information need'}</td>
                    <td>{p.label}</td>
                    <td>
                      {fmt(p.p90)}% ({p.pledged}/{nPledge})
                    </td>
                    <td>
                      {fmt(p.p55)}% ({p.not_pledged}/{nNoPledge})
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </details>

        <details class="bp-details">
          <summary>Skills offered — table, and how the map is drawn</summary>
          <table class="bp-table">
            <thead><tr><th scope="col">Skill area</th><th scope="col">Recorded offers</th></tr></thead>
            <tbody>
              {
                cohort.eoi_skills.published.map((s) => (
                  <tr>
                    <>
                      <td>{s.label}</td>
                      <td>{s.count}</td>
                    </>
                  </tr>
                ))
              }
              {
                cohort.eoi_skills.zero.map((s) => (
                  <tr>
                    <>
                      <td>{s.label}</td>
                      <td>0</td>
                    </>
                  </tr>
                ))
              }
              <tr><td>Administration</td><td>fewer than 5</td></tr>
              <tr><td>Other</td><td>fewer than 5</td></tr>
              <tr><td>(three areas, labels withheld)</td><td>fewer than 5 each</td></tr>
            </tbody>
          </table>
          <p class="bp-methodology">
            Radius r(count) = 172 − (count/9) × 108, so abundant categories fall toward the core. Rings at 0, 3, 6, 9.
            Angular position is evenly spaced by descending count and carries no data; dots within a cluster use
            golden-angle packing purely to avoid overlap.
          </p>
        </details>

        <details class="bp-details">
          <summary>Archive manifest — 56 artefacts</summary>
          <div
            class="bp-manifest-strip"
            role="img"
            aria-label={`56 artefact hashes from the release manifest, digest ${manifest.manifest_digest}`}
          >
            {
              Object.entries(manifest.artefacts).map(([name, hash]) => (
                <span class="bp-manifest-cell" title={name}>
                  {(hash as string).slice(0, 8)}
                </span>
              ))
            }
          </div>
          <table class="bp-table">
            <caption>Every artefact in the frozen public archive, with its SHA-256 prefix.</caption>
            <thead><tr><th scope="col">Artefact</th><th scope="col">SHA-256 (first 16 chars)</th></tr></thead>
            <tbody>
              {
                Object.entries(manifest.artefacts).map(([name, hash]) => (
                  <tr>
                    <>
                      <td>{name}</td>
                      <td>
                        <code>{(hash as string).slice(0, 16)}…</code>
                      </td>
                    </>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="bp-endmark">
            Manifest digest <code>{manifest.manifest_digest}</code>
            <br />Counts reproduced {cohort.meta.reproduced ?? '2026-08-20'}.
          </p>
        </details>
      </section>
    </main>
  </div>
</BaseLayout>

