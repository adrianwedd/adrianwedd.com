---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { slug } from '../../lib/utils';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  // bottom-pub-project has its own bespoke page (bottom-pub-project.astro) —
  // the prose template here can't carry its charts, so its collection entry
  // (used only for the /case-studies/ index card) is excluded from this
  // catch-all.
  return caseStudies
    .filter((c) => !c.data.draft && slug(c.id) !== 'bottom-pub-project')
    .map((c) => ({
      params: { slug: slug(c.id) },
      props: { caseStudy: c },
    }));
}

const { caseStudy } = Astro.props;
const { Content } = await render(caseStudy);
const caseStudySlug = slug(caseStudy.id);
const ogImage = `/og/case-studies/${caseStudySlug}.png`;

// Astro 7 scopes the Astro global to the frontmatter; capture what the
// template's JSON-LD needs.
const site = Astro.site;
const pathname = Astro.url.pathname;
---

<BaseLayout
  title={caseStudy.data.title}
  description={caseStudy.data.description}
  image={ogImage}
  type="article"
  siteNameInTitle={false}
  publishedDate={caseStudy.data.date.toISOString()}
  tags={caseStudy.data.tags}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: caseStudy.data.title,
      description: caseStudy.data.description,
      url: new URL(pathname, site).href,
      image: new URL(ogImage, site).href,
      datePublished: caseStudy.data.date.toISOString(),
      keywords: caseStudy.data.tags,
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pathname, site).href },
    })}
  />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Case studies', href: '/case-studies/' },
        { label: caseStudy.data.title },
      ]}
    />
    <p class="text-accent text-sm font-medium">{caseStudy.data.category}</p>
    <h1 class="text-text mt-2">{caseStudy.data.title}</h1>
    <div
      class="prose prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-semibold prose-headings:text-text prose-p:mb-4 prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:my-4 prose-blockquote:border-accent prose-blockquote:text-text-muted prose-strong:text-text prose-code:text-text prose-pre:border prose-pre:border-border prose-pre:bg-surface-alt prose-ol:my-4 prose-ul:my-4 prose-li:text-text mt-8 max-w-none"
    >
      <Content />
    </div>
    <div class="mt-12">
      <a href="/local/" class="text-accent hover:underline">See the local services &rarr;</a>
    </div>
  </article>
</BaseLayout>
