---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../../lib/utils';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

const tagCounts = new Map<string, number>();
posts.forEach((p) => {
  p.data.tags.forEach((tag: string) => {
    const t = tagSlug(tag);
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  });
});

const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="Blog Topics & Tags"
  description="Browse AI safety, economics, engineering, and more. Filter by topic to find what interests you."
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: 'Tags' }]} />
    <h1 class="text-text">Tags</h1>
    <p class="text-text-muted mt-4">{sortedTags.length} tags across {posts.length} posts</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        sortedTags.map(([tag, count]) => (
          <a
            href={`/blog/tag/${tag}/`}
            class="hover:bg-accent/15 group bg-surface-raised hover:text-accent flex items-center gap-2 rounded-full px-4 py-2 no-underline transition-colors"
          >
            <span class="text-text group-hover:text-accent text-sm transition-colors">{tag}</span>
            <span class="bg-surface text-text-muted rounded-full px-2 py-0.5 text-xs">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
