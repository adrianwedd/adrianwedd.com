---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TableOfContents from '../../components/islands/TableOfContents';
import ShareButton from '../../components/islands/ShareButton';
import RelatedContent from '../../components/RelatedContent.astro';
import NotebookAssets from '../../components/NotebookAssets.astro';
import SeriesCTA from '../../components/SeriesCTA.astro';
import AudioPlayer from '../../components/islands/AudioPlayer';
import { getCollection, render } from 'astro:content';
import { slug, tagSlug, youtubeId, ogSafeImage, heroAltText, isPublicPath } from '../../lib/utils';
import { getImageDimensions } from '../../lib/image-dimensions';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: slug(post.id) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Series support — defined before prev/next so series posts navigate in
// series order (Part 1 → 2 → 3) rather than the global date-sorted feed.
const seriesPosts = post.data.series
  ? allPosts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
const inSeries = seriesPosts.length > 1 && seriesIndex !== -1;

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = inSeries
  ? seriesIndex > 0
    ? seriesPosts[seriesIndex - 1]
    : null
  : currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : null;
const nextPost = inSeries
  ? seriesIndex < seriesPosts.length - 1
    ? seriesPosts[seriesIndex + 1]
    : null
  : currentIndex > 0
    ? allPosts[currentIndex - 1]
    : null;

// Reading time estimate
const words = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

// OG image: prefer the post's hero infographic, but swap .webp -> .jpg
// because FB / X / LinkedIn / iMessage do not reliably render WebP og:image
// scrapes. The .jpg twin is generated alongside the .webp at build/asset
// time. Fall back to the auto-generated text-card OG PNG when no heroImage.
const postSlug = slug(post.id);
// A portrait hero (our NotebookLM infographics are 1536x2752) is unusable as an
// OG image: twitter:card=summary_large_image wants ~1.91:1 and centre-crops the
// rest into mush. Prefer the generated landscape text card in that case.
const ogTextCard = `/og/blog/${postSlug}.png`;
const heroOg = post.data.heroImage ? ogSafeImage(post.data.heroImage) : null;
const heroOgDimensions = heroOg ? getImageDimensions(heroOg) : null;
// Use the hero only when its dimensions are *known* and landscape. Unknown
// dimensions (missing .jpg twin, unreadable header) fall back to the text card,
// matching scripts/generate-og-images.mjs, which generates a card in exactly the
// same cases. Both sides read the same ogSafeImage() path and default the same
// way — but they use different image readers (sharp there, image-dimensions
// here), so agreement is not guaranteed by construction. scripts/check-og-
// images.mjs is what actually makes this safe; it runs on every PR.
const heroOgIsLandscape = !!heroOgDimensions && heroOgDimensions.width >= heroOgDimensions.height;
const ogImage = heroOg && heroOgIsLandscape ? heroOg : ogTextCard;
// Read the actual image dimensions at build time (covers infographics, text
// cards, and any future OG image shape without filename-based heuristics).
// Falls back to standard 1200x630 if the file is missing or unreadable.
const ogDimensions = getImageDimensions(ogImage);
const ogImageWidth = ogDimensions?.width ?? 1200;
const ogImageHeight = ogDimensions?.height ?? 630;

// Hero <Picture> intrinsic dimensions: read the real file so the browser
// reserves the correct aspect ratio (infographic heroes are portrait
// 1536x2752 — hardcoding 1200x630 caused layout shift once the image loaded).
const heroDimensions = post.data.heroImage ? getImageDimensions(post.data.heroImage) : null;
const heroWidth = heroDimensions?.width ?? 1200;
const heroHeight = heroDimensions?.height ?? 630;

const heroAlt = heroAltText({
  heroAlt: post.data.heroAlt,
  heroImage: post.data.heroImage,
  title: post.data.title,
  kind: 'article',
});

// Projects in the same series
const allProjects = await getCollection('projects');
const seriesProjectsList = post.data.series
  ? allProjects
      .filter((p) => !p.data.draft && p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];

// Match to a project by slug (blog slug minus trailing "-post")
const candidateProjectSlug = postSlug.replace(/-post$/, '');
const matchedProject = allProjects.find((p) => !p.data.draft && slug(p.id) === candidateProjectSlug);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  imageAlt={(ogImage === ogTextCard ? `${post.data.title} — adrianwedd.com` : heroAlt) || undefined}
  type="article"
  publishedDate={post.data.date.toISOString()}
  tags={post.data.tags}
  preloadImage={typeof post.data.heroImage === 'string' ? post.data.heroImage : undefined}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: post.data.date.toISOString(),
      ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
      wordCount: words,
      keywords: post.data.tags,
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, Astro.site).href },
    })}
  />
  {
    (() => {
      const ytId = youtubeId(post.data.youtubeUrl);
      if (!post.data.videoUrl && !ytId) return null;
      return (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'VideoObject',
            name: post.data.title,
            description: post.data.description,
            ...(post.data.videoUrl && { contentUrl: new URL(post.data.videoUrl, Astro.site).href }),
            ...(ytId && {
              embedUrl: `https://www.youtube.com/embed/${ytId}`,
              url: post.data.youtubeUrl,
            }),
            // The video's own publication date, not the post's — a drip-scheduled
            // post dated ahead of its upload used to emit a FUTURE uploadDate.
            uploadDate: (post.data.videoUploadDate ?? post.data.date).toISOString(),
            thumbnailUrl: post.data.heroImage
              ? new URL(ogSafeImage(post.data.heroImage), Astro.site).href
              : new URL('/og-default.png', Astro.site).href,
          })}
        />
      );
    })()
  }
  {
    post.data.faq && post.data.faq.length > 0 && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: post.data.faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: {
              '@type': 'Answer',
              text: item.a,
            },
          })),
        })}
      />
    )
  }
  {/* Reading progress bar */}
  <div
    id="reading-progress"
    class="bg-accent fixed top-16 left-0 z-40 h-0.5 transition-[width] duration-100"
    style="width: 0%"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
  </div>
  <div
    id="reading-remaining"
    class="border-border bg-surface-alt text-text-muted fixed top-[4.25rem] right-4 z-40 rounded-full border px-2.5 py-0.5 text-xs opacity-0 transition-opacity duration-300"
    aria-live="off"
  >
  </div>

  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.title }]}
    />
    <header class="mb-10">
      <div class="text-text-muted mb-4 flex items-center gap-3 text-sm">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={post.data.updatedDate.toISOString()}>
                  {post.data.updatedDate.toLocaleDateString('en-AU', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime} min read</span>
        {
          post.data.explicit && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="border-accent/40 text-accent rounded-full border px-2 py-0.5 text-xs font-medium tracking-wide uppercase">
                Explicit
              </span>
            </>
          )
        }
        {
          matchedProject?.data.url && (
            <>
              <span aria-hidden="true">&middot;</span>
              <a
                href={matchedProject.data.url}
                class="text-text-muted hover:text-accent text-xs transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit site &nearr;
              </a>
            </>
          )
        }
        {
          matchedProject?.data.repo && (
            <>
              <span aria-hidden="true">&middot;</span>
              <a
                href={
                  matchedProject.data.repo.startsWith('http')
                    ? matchedProject.data.repo
                    : `https://github.com/adrianwedd/${matchedProject.data.repo}`
                }
                class="text-text-muted hover:text-accent text-xs transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                Source &nearr;
              </a>
            </>
          )
        }
      </div>
      <h1 class="text-text">{post.data.title}</h1>
      <p class="text-text-muted mt-4 text-lg leading-relaxed">{post.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {
          post.data.tags.map((tag: string) => (
            <a
              href={`/blog/tag/${tagSlug(tag)}/`}
              class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent rounded-full px-2.5 py-0.5 text-xs no-underline transition-colors"
            >
              {tag}
            </a>
          ))
        }
        <span class="ml-auto">
          <ShareButton title={post.data.title} url={`/blog/${slug(post.id)}/`} client:idle />
        </span>
      </div>
      {
        post.data.audioUrl && (
          <div class="mt-8 mb-6">
            <p class="text-text-muted mb-2 text-sm">
              Listen while you read{post.data.audioDuration && ` · ${post.data.audioDuration}`}
            </p>
            <AudioPlayer src={post.data.audioUrl} title={`${post.data.title} — Audio Overview`} client:visible />
          </div>
        )
      }
      {
        /* Lyria Chronicles: the track video IS the content, so it leads — */
        /* rendered at the top with the cover as its poster, in place of the */
        /* hero image. Other posts (and Lyria doc-only entries with no */
        /* videoUrl) keep the image hero. Explicit entries are the exception: */
        /* we never lead the page with explicit content, so the cover image */
        /* heroes and the video is demoted to the assets block at the bottom, */
        /* below the in-body content warning. */
        post.data.series === 'The Lyria Chronicles' && post.data.videoUrl && !post.data.explicit ? (
          <video
            controls
            preload="metadata"
            playsinline
            poster={post.data.heroImage}
            src={post.data.videoUrl}
            class="border-border bg-surface-alt mt-8 aspect-video w-full rounded-lg border"
          />
        ) : post.data.heroImage ? (
          <Picture
            src={post.data.heroImage}
            width={heroWidth}
            height={heroHeight}
            {...(isPublicPath(post.data.heroImage)
              ? {}
              : { widths: [640, 1200, 1920], formats: ['avif', 'webp'] as const })}
            alt={heroAlt}
            class="border-border mt-8 w-full rounded-lg border"
            loading="eager"
            fetchpriority="high"
          />
        ) : null
      }
    </header>

    {
      seriesPosts.length > 1 && (
        <nav class="border-border bg-surface-alt mb-8 rounded-lg border p-4" aria-label="Series navigation">
          <p class="text-text-muted mb-2 text-xs font-medium">
            Part {seriesPosts.findIndex((p) => p.id === post.id) + 1} of {seriesPosts.length} in{' '}
            <span class="text-accent">{post.data.series}</span>
          </p>
          <ol class="space-y-1">
            {seriesPosts.map((p, i) => (
              <li class="text-sm">
                {p.id === post.id ? (
                  <span class="text-accent font-medium">
                    {i + 1}. {p.data.title}
                  </span>
                ) : (
                  <a
                    href={`/blog/${slug(p.id)}/`}
                    class="text-text-muted hover:text-accent no-underline transition-colors"
                  >
                    {i + 1}. {p.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      seriesProjectsList.length > 0 && (
        <div class="border-border bg-surface-alt mb-8 rounded-lg border p-4">
          <p class="text-text-muted mb-2 text-xs font-medium">
            Projects in <span class="text-accent">{post.data.series}</span>
          </p>
          <ol class="space-y-1">
            {seriesProjectsList.map((p, i) => (
              <li class="text-sm">
                <a
                  href={`/projects/${slug(p.id)}/`}
                  class="text-text-muted hover:text-accent no-underline transition-colors"
                >
                  {i + 1}. {p.data.title}
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <TableOfContents contentSelector=".prose" client:idle />

    <div
      class="prose prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-semibold prose-headings:text-text prose-p:mb-4 prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:my-4 prose-blockquote:border-accent prose-blockquote:text-text-muted prose-strong:text-text prose-code:rounded prose-code:bg-surface-alt prose-code:px-1 prose-code:py-0.5 prose-code:text-text-accent prose-pre:my-4 prose-pre:border prose-pre:border-border prose-pre:bg-surface-alt prose-ol:my-4 prose-ul:my-4 prose-li:text-text max-w-none"
    >
      <Content />
    </div>

    <NotebookAssets
      videoUrl={post.data.series === 'The Lyria Chronicles' && !post.data.explicit ? undefined : post.data.videoUrl}
      infographic={post.data.infographic}
      mindmap={post.data.mindmap}
      quiz={post.data.quiz}
      flashcards={post.data.flashcards}
      dataTable={post.data.dataTable}
      slides={post.data.slides}
      title={post.data.title}
    />

    {post.data.series === 'The Lyria Chronicles' && <SeriesCTA />}

    <RelatedContent currentTags={post.data.tags} currentId={post.id} currentDate={post.data.date} contentType="blog" />

    {/* Prev/Next navigation */}
    <nav
      class="border-border mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2"
      aria-label={inSeries ? 'Previous and next in series' : 'Previous and next posts'}
    >
      {
        prevPost ? (
          <a
            href={`/blog/${slug(prevPost.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors"
          >
            <span class="text-text-muted text-xs">
              <span aria-hidden="true">&larr;</span> {inSeries ? 'Previous in series' : 'Previous'}
            </span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextPost && (
          <a
            href={`/blog/${slug(nextPost.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors sm:text-right"
          >
            <span class="text-text-muted text-xs">
              {inSeries ? 'Next in series' : 'Next'} <span aria-hidden="true">&rarr;</span>
            </span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {nextPost.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>

  <script is:inline>
    (function () {
      function initBlogScripts() {
        // Code block copy buttons — DOM setup per element, click via delegation
        document.querySelectorAll('.prose pre').forEach(function (pre) {
          if (pre.dataset.copyInit) return;
          pre.dataset.copyInit = '1';

          var wrapper = document.createElement('div');
          wrapper.className = 'relative group/code';
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          var btn = document.createElement('button');
          btn.className =
            'code-copy-btn absolute right-2 top-2 rounded border border-border bg-surface-alt px-2 py-1 text-xs text-text-muted opacity-0 transition-all hover:border-accent hover:text-accent group-hover/code:opacity-100';
          btn.textContent = 'Copy';
          btn.setAttribute('aria-label', 'Copy code to clipboard');
          wrapper.appendChild(btn);
        });

        // Reading progress — single scroll listener, persists across VT swaps
        var root = document.documentElement;
        if (!root.dataset.scrollProgressInit) {
          root.dataset.scrollProgressInit = '1';
          window.addEventListener(
            'scroll',
            function () {
              var bar = document.getElementById('reading-progress');
              var remaining = document.getElementById('reading-remaining');
              var article = document.querySelector('article');
              if (!bar || !article) return;
              var totalReadMin = Math.max(1, Math.ceil((article.textContent || '').split(/\s+/).length / 200));
              var rect = article.getBoundingClientRect();
              var total = article.scrollHeight - window.innerHeight;
              var scrolled = -rect.top;
              var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
              bar.style.width = pct + '%';
              bar.setAttribute('aria-valuenow', String(Math.round(pct)));
              if (remaining) {
                var minLeft = Math.max(0, Math.ceil(totalReadMin * (1 - pct / 100)));
                if (pct > 5 && pct < 98) {
                  remaining.textContent = minLeft <= 1 ? '< 1 min left' : minLeft + ' min left';
                  remaining.style.opacity = '1';
                } else {
                  remaining.style.opacity = '0';
                }
              }
            },
            { passive: true },
          );
        }
      }

      initBlogScripts();
      var root = document.documentElement;
      if (!root.dataset.blogScriptInit) {
        root.dataset.blogScriptInit = '1';
        document.addEventListener('astro:after-swap', initBlogScripts);
      }

      // Code copy — delegated click handler (own sentinel, independent of scroll progress)
      if (!root.dataset.codeCopyInit) {
        root.dataset.codeCopyInit = '1';
        document.addEventListener('click', function (e) {
          if (!e.target || typeof e.target.closest !== 'function') return;
          var btn = e.target.closest('.code-copy-btn');
          if (!btn) return;
          var wrapper = btn.closest('.group\\/code');
          var pre = wrapper ? wrapper.querySelector('pre') : null;
          if (!pre) return;
          var code = pre.querySelector('code');
          navigator.clipboard
            .writeText(code ? code.textContent || '' : pre.textContent || '')
            .then(function () {
              btn.textContent = 'Copied!';
              setTimeout(function () {
                btn.textContent = 'Copy';
              }, 2000);
            })
            .catch(function () {
              btn.textContent = 'Failed';
              setTimeout(function () {
                btn.textContent = 'Copy';
              }, 2000);
            });
        });
      }
    })();
  </script>
</BaseLayout>
