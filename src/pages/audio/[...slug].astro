---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ShareButton from '../../components/islands/ShareButton';
import RelatedContent from '../../components/RelatedContent.astro';
import NotebookAssets from '../../components/NotebookAssets.astro';
import AudioPlayer from '../../components/islands/AudioPlayer';
import { getCollection, render } from 'astro:content';
import { slug, ogSafeImage, mediaMimeType } from '../../lib/utils';
import { episodeCover, containerOverride } from '../../lib/media-facts';

export async function getStaticPaths() {
  const episodes = (await getCollection('audio')).filter((e) => !e.data.draft);
  return episodes.map((episode) => ({
    params: { slug: slug(episode.id) },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);

// FB / X / LinkedIn / iMessage don't reliably render WebP og:image scrapes;
// the .jpg twin is generated alongside the .webp at content-build time. Fall
// back to the site-wide default OG card when the episode has no heroImage.
// Prefer the episode's own committed cover art over the heroImage, and the
// generic card only as a last resort — Google requires a video's thumbnail be
// unique to that video, so og-default.png does not qualify.
const cover = episodeCover(episode.data.audioUrl ?? episode.data.videoUrl);
const ogImage = cover ?? (episode.data.heroImage ? ogSafeImage(episode.data.heroImage) : '/og-default.png');

// Resolved once: the schema allows an entry with neither URL, and several
// JSON-LD properties below must be omitted entirely in that case.
const mediaUrl = episode.data.audioUrl ?? episode.data.videoUrl ?? '';
const isVideo = !episode.data.audioUrl && !!episode.data.videoUrl;

const allEpisodes = (await getCollection('audio'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = allEpisodes.findIndex((e) => e.id === episode.id);
const prevEpisode = currentIndex < allEpisodes.length - 1 ? allEpisodes[currentIndex + 1] : null;
const nextEpisode = currentIndex > 0 ? allEpisodes[currentIndex - 1] : null;
---

<BaseLayout
  title={episode.data.title}
  description={episode.data.description}
  image={ogImage}
  type="article"
  siteNameInTitle={false}
  publishedDate={episode.data.date.toISOString()}
  tags={episode.data.tags}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': episode.data.audioUrl ? 'AudioObject' : 'VideoObject',
      name: episode.data.title,
      description: episode.data.description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      datePublished: episode.data.date.toISOString(),
      ...(episode.data.duration
        ? {
            duration: (() => {
              const parts = episode.data.duration.split(':').map(Number);
              if (parts.length === 3) return `PT${parts[0]}H${parts[1]}M${parts[2]}S`;
              if (parts.length === 2) return `PT${parts[0]}M${parts[1]}S`;
              return `PT${parts[0]}M`;
            })(),
          }
        : {}),
      // An entry with neither URL would make `new URL('', site)` resolve to the
      // site root, asserting the homepage as this episode's media file. Omit
      // the property instead of claiming something false.
      ...(mediaUrl && { contentUrl: new URL(mediaUrl, Astro.site).href }),
      ...(mediaUrl && {
        encodingFormat:
          containerOverride(mediaUrl) ?? mediaMimeType(mediaUrl, episode.data.audioUrl ? 'audio' : 'video'),
      }),
      // Google requires `name`, `thumbnailUrl` and `uploadDate` on VideoObject
      // — `datePublished` is not an accepted substitute. Without these the
      // video is ineligible for video rich results.
      // https://developers.google.com/search/docs/appearance/structured-data/video
      ...(isVideo && {
        uploadDate: episode.data.date.toISOString(),
        thumbnailUrl: new URL(ogImage, Astro.site).href,
      }),
      keywords: episode.data.tags,
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
    })}
  />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Audio', href: '/audio/' }, { label: episode.data.title }]}
    />
    <header class="mb-8">
      <div class="text-text-muted mb-4 flex items-center gap-3 text-sm">
        <time datetime={episode.data.date.toISOString()}>
          {episode.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {
          episode.data.duration && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{episode.data.duration}</span>
            </>
          )
        }
      </div>
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-text">{episode.data.title}</h1>
        <span class="mt-2 shrink-0">
          <ShareButton title={episode.data.title} url={`/audio/${slug(episode.id)}/`} client:idle />
        </span>
      </div>
      <p class="text-text-muted mt-4 text-lg leading-relaxed">{episode.data.description}</p>

      {
        (episode.data.relatedProject || episode.data.relatedPost) && (
          <div class="border-border bg-surface-alt mt-6 rounded-lg border p-4">
            <p class="text-text-muted text-sm">
              {episode.data.relatedProject && (
                <>
                  Generated for project:{' '}
                  <a href={`/projects/${episode.data.relatedProject}/`} class="text-accent font-medium hover:underline">
                    {episode.data.relatedProject
                      .split('-')
                      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
                      .join(' ')}
                  </a>
                </>
              )}
              {episode.data.relatedPost && (
                <>
                  Companion to article:{' '}
                  <a href={`/blog/${slug(episode.data.relatedPost)}/`} class="text-accent font-medium hover:underline">
                    {slug(episode.data.relatedPost)
                      .split('-')
                      .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
                      .join(' ')}
                  </a>
                </>
              )}
            </p>
          </div>
        )
      }
    </header>

    {
      episode.data.audioUrl && (
        <div class="mb-10">
          <AudioPlayer client:load src={episode.data.audioUrl} title={episode.data.title} />
        </div>
      )
    }

    <div
      class="prose prose-headings:font-semibold prose-headings:text-text prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-strong:text-text prose-code:text-text-accent prose-li:text-text max-w-none"
    >
      <Content />
    </div>

    {
      episode.data.transcript && (
        <details class="border-border mt-10 rounded-lg border">
          <summary class="text-text hover:text-accent cursor-pointer px-4 py-3 text-sm font-medium transition-colors">
            Transcript
            <span class="text-text-muted ml-2 text-xs font-normal">
              ({episode.data.transcript.split(/\s+/).length.toLocaleString()} words)
            </span>
          </summary>
          <div class="relative px-4 pb-4">
            <button
              type="button"
              class="transcript-copy border-border bg-surface-alt text-text-muted hover:border-accent hover:text-accent absolute top-0 right-4 rounded border px-2 py-1 text-xs transition-colors"
              aria-label="Copy transcript"
            >
              Copy
            </button>
            <div class="transcript-text text-text-muted pt-1 text-sm leading-relaxed whitespace-pre-wrap">
              {episode.data.transcript}
            </div>
          </div>
        </details>
      )
    }

    <NotebookAssets
      videoUrl={episode.data.videoUrl}
      infographic={episode.data.infographic}
      mindmap={episode.data.mindmap}
      quiz={episode.data.quiz}
      flashcards={episode.data.flashcards}
      dataTable={episode.data.dataTable}
      slides={episode.data.slides}
      title={episode.data.title}
    />

    <RelatedContent
      currentTags={episode.data.tags}
      currentId={episode.id}
      currentDate={episode.data.date}
      contentType="audio"
    />

    <nav class="border-border mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2" aria-label="Previous and next episodes">
      {
        prevEpisode ? (
          <a
            href={`/audio/${slug(prevEpisode.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors"
          >
            <span class="text-text-muted text-xs">&larr; Previous</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {prevEpisode.data.title}
            </span>
          </a>
        ) : (
          <a href="/audio/" class="text-text-muted hover:text-accent flex items-center text-sm transition-colors">
            &larr; All episodes
          </a>
        )
      }
      {
        nextEpisode && (
          <a
            href={`/audio/${slug(nextEpisode.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors sm:text-right"
          >
            <span class="text-text-muted text-xs">Next &rarr;</span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {nextEpisode.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!root.dataset.transcriptCopyInit) {
        root.dataset.transcriptCopyInit = '1';
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('.transcript-copy');
          if (!btn) return;
          var transcriptText = document.querySelector('.transcript-text');
          if (!transcriptText) return;
          navigator.clipboard
            .writeText(transcriptText.textContent || '')
            .then(function () {
              btn.textContent = 'Copied!';
              setTimeout(function () {
                btn.textContent = 'Copy';
              }, 2000);
            })
            .catch(function () {
              btn.textContent = 'Failed';
              setTimeout(function () {
                btn.textContent = 'Copy';
              }, 2000);
            });
        });
      }
    })();
  </script>
</BaseLayout>
