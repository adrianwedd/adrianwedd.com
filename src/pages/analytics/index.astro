---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnalyticsDashboard from '../../components/islands/AnalyticsDashboard';
---

<BaseLayout
  title="Analytics"
  description="Public traffic data—what gets read, where readers come from. Aggregate only. Transparency by default."
  heroAnimation="stream"
>
  <section class="relative flex min-h-[50dvh] items-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="text-text">Analytics</h1>
      <p class="text-text-muted mt-2">Public traffic data. Transparency by default.</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <p class="text-text-muted text-lg">
        Traffic data made public. Aggregate only—no individual tracking, no session reconstruction. Refreshed at build
        time, so it updates whenever the site deploys. Transparency by default.
      </p>
    </header>

    <AnalyticsDashboard client:idle />
  </div>
</BaseLayout>
