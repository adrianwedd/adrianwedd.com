---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCanvas from '../../components/HeroCanvas.astro';
import AnalyticsDashboard from '../../components/islands/AnalyticsDashboard';
---

<BaseLayout
  title="Analytics"
  description="Public traffic data—what gets read, where readers come from. Aggregate only. Transparency by default."
  noindex
>
  <section class="relative flex min-h-[50dvh] items-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="text-text">Analytics</h1>
      <p class="mt-2 text-text-muted">Public traffic data. Transparency by default.</p>
    </div>
    <HeroCanvas animation="stream" />
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <p class="text-lg text-text-muted">
        Traffic data made public. Aggregate only—no individual tracking, no session reconstruction. Updates daily at
        build time. Transparency by default.
      </p>
    </header>

    <AnalyticsDashboard client:load />
  </div>
</BaseLayout>
