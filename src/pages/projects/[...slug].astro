---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TableOfContents from '../../components/islands/TableOfContents';
import ShareButton from '../../components/islands/ShareButton';
import RelatedContent from '../../components/RelatedContent.astro';
import NotebookAssets from '../../components/NotebookAssets.astro';
import AudioPlayer from '../../components/islands/AudioPlayer';
import { getCollection, render } from 'astro:content';
import { slug, youtubeId, ogSafeImage, heroAltText, tagSlug, isPublicPath } from '../../lib/utils';
import { getImageDimensions } from '../../lib/image-dimensions';
import ProjectCTA from '../../components/ProjectCTA.astro';
import { Picture } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => !project.data.draft)
    .map((project) => ({
      params: { slug: slug(project.id) },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const projectSlug = slug(project.id);
// OG image: prefer the project's hero infographic, swap .webp -> .jpg
// (FB / X / LinkedIn / iMessage don't reliably render WebP og:image).
// The .jpg twin is generated alongside the .webp.
// A portrait hero (the NotebookLM infographics are 1536x2752) is unusable as an
// OG image: twitter:card=summary_large_image wants ~1.91:1 and centre-crops the
// rest into mush. Prefer the generated landscape text card in that case.
const ogTextCard = `/og/projects/${projectSlug}.png`;
const heroOg = project.data.heroImage ? ogSafeImage(project.data.heroImage) : null;
const heroOgDimensions = heroOg ? getImageDimensions(heroOg) : null;
// Use the hero only when its dimensions are *known* and landscape. Unknown
// dimensions (missing .jpg twin, unreadable header) fall back to the text card,
// matching scripts/generate-og-images.mjs, which generates a card in exactly the
// same cases. Both sides read the same ogSafeImage() path and default the same
// way — but they use different image readers (sharp there, image-dimensions
// here), so agreement is not guaranteed by construction. scripts/check-og-
// images.mjs is what actually makes this safe; it runs on every PR.
const heroOgIsLandscape = !!heroOgDimensions && heroOgDimensions.width >= heroOgDimensions.height;
const ogImage = heroOg && heroOgIsLandscape ? heroOg : ogTextCard;
// Read actual image dimensions at build time — covers infographics, text
// cards, and any future OG image shape without filename-based heuristics.
const ogDimensions = getImageDimensions(ogImage);
const ogImageWidth = ogDimensions?.width ?? 1200;
const ogImageHeight = ogDimensions?.height ?? 630;

// Hero <Picture> intrinsic dimensions: read the real file so the browser
// reserves the correct aspect ratio (infographic heroes are portrait
// 1536x2752 — hardcoding 1200x630 caused layout shift once the image loaded).
const heroDimensions = project.data.heroImage ? getImageDimensions(project.data.heroImage) : null;
const heroWidth = heroDimensions?.width ?? 1200;
const heroHeight = heroDimensions?.height ?? 630;

const heroAlt = heroAltText({
  heroAlt: project.data.heroAlt,
  heroImage: project.data.heroImage,
  title: project.data.title,
  kind: 'project',
});
const allAudio = await getCollection('audio');
const relatedEpisodes = allAudio.filter((ep) => !ep.data.draft && ep.data.relatedProject === projectSlug);

const statusColors: Record<string, string> = {
  active: 'border-status-active-border text-status-active',
  complete: 'border-accent/30 text-accent',
  archived: 'border-border text-text-muted',
  experiment: 'border-status-experiment-border text-status-experiment',
};

const allProjects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Series support — defined before prev/next so series projects navigate in
// series order rather than the global date-sorted feed.
const seriesProjects = project.data.series
  ? allProjects
      .filter((p) => p.data.series === project.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesProjects.findIndex((p) => p.id === project.id);
const inSeries = seriesProjects.length > 1 && seriesIndex !== -1;

// Prev/next navigation
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prevProject = inSeries
  ? seriesIndex > 0
    ? seriesProjects[seriesIndex - 1]
    : null
  : currentIndex < allProjects.length - 1
    ? allProjects[currentIndex + 1]
    : null;
const nextProject = inSeries
  ? seriesIndex < seriesProjects.length - 1
    ? seriesProjects[seriesIndex + 1]
    : null
  : currentIndex > 0
    ? allProjects[currentIndex - 1]
    : null;

// Blog posts in the same series
const allBlogPosts = project.data.series
  ? (await getCollection('blog'))
      .filter((p) => !p.data.draft && p.data.series === project.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];

// Astro 7 scopes the Astro global to the frontmatter; capture what the
// template's JSON-LD needs.
const site = Astro.site;
const pathname = Astro.url.pathname;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={ogImage}
  imageWidth={ogImageWidth}
  imageHeight={ogImageHeight}
  imageAlt={(ogImage === ogTextCard ? `${project.data.title} — adrianwedd.com` : heroAlt) || undefined}
  type="website"
  siteNameInTitle={false}
  tags={project.data.tags}
  preloadImage={typeof project.data.heroImage === 'string' ? project.data.heroImage : undefined}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      // Always CreativeWork. These pages are write-ups ABOUT projects, not
      // listings for distributed applications. SoftwareApplication requires
      // `offers.price` plus one of `aggregateRating`/`review` (verified against
      // Google's software-app doc, 2026-07-20) — and the honest fix is not to
      // invent a rating for a personal site, it's to stop claiming to be an app.
      // The old type-by-field-presence rule also mislabelled any project whose
      // `url` pointed at an external *article* as a DeveloperApplication.
      '@type': 'CreativeWork',
      name: project.data.title,
      description: project.data.description,
      url: new URL(pathname, site).href,
      datePublished: project.data.date.toISOString(),
      ...(project.data.updatedDate ? { dateModified: project.data.updatedDate.toISOString() } : {}),
      keywords: project.data.tags,
      // External project URL and repo both go in `sameAs`, NOT `url`. Previously
      // the spread here was `{ url: project.data.url }`, which silently overrode
      // the canonical adrianwedd.com URL above — telling Google the entity lived
      // at the external site and splitting page authority.
      // `codeRepository` is a SoftwareSourceCode property and isn't defined on
      // CreativeWork, so the repo link belongs in sameAs too.
      ...(() => {
        const sameAs = [
          ...(project.data.url ? [project.data.url] : []),
          ...(project.data.repo
            ? [
                project.data.repo.startsWith('http')
                  ? project.data.repo
                  : `https://github.com/adrianwedd/${project.data.repo}`,
              ]
            : []),
        ];
        return sameAs.length ? { sameAs } : {};
      })(),
      ...(project.data.heroImage ? { image: new URL(ogSafeImage(project.data.heroImage), site).href } : {}),
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(pathname, site).href },
    })}
  />
  {
    (() => {
      const ytId = youtubeId(project.data.youtubeUrl);
      if (!project.data.videoUrl && !ytId) return null;
      return (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'VideoObject',
            name: project.data.title,
            description: project.data.description,
            ...(project.data.videoUrl && { contentUrl: new URL(project.data.videoUrl, site).href }),
            ...(ytId && {
              embedUrl: `https://www.youtube.com/embed/${ytId}`,
              url: project.data.youtubeUrl,
            }),
            // The video's own publication date, not the project's — see blog template.
            uploadDate: (project.data.videoUploadDate ?? project.data.date).toISOString(),
            thumbnailUrl: project.data.heroImage
              ? new URL(ogSafeImage(project.data.heroImage), site).href
              : new URL('/og-default.png', site).href,
          })}
        />
      );
    })()
  }
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8" data-pagefind-body>
    <Breadcrumb
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects/' }, { label: project.data.title }]}
    />
    <header class="mb-10">
      <div class="text-text-muted mb-4 flex items-center gap-3 text-sm">
        <span
          class:list={[
            'rounded-full border px-2 py-0.5 text-xs',
            statusColors[project.data.status] || 'border-border text-text-muted',
          ]}
        >
          {project.data.status}
        </span>
        {
          project.data.updatedDate ? (
            <span>
              Updated{' '}
              <time datetime={project.data.updatedDate.toISOString()}>
                {project.data.updatedDate.toLocaleDateString('en-AU', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </span>
          ) : (
            <time datetime={project.data.date.toISOString()}>
              {project.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          )
        }
        {
          project.data.url && (
            <a
              href={project.data.url}
              class="text-text-muted hover:text-accent text-xs transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit site &nearr;
            </a>
          )
        }
        {
          project.data.repo && (
            <a
              href={
                project.data.repo.startsWith('http')
                  ? project.data.repo
                  : `https://github.com/adrianwedd/${project.data.repo}`
              }
              class="text-text-muted hover:text-accent text-xs transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              Source &nearr;
            </a>
          )
        }
      </div>
      <h1 class="text-text">{project.data.title}</h1>
      <p class="text-text-muted mt-4 text-lg leading-relaxed">{project.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {
          project.data.tags.map((tag: string) => (
            <a
              href={`/projects/tag/${tagSlug(tag)}/`}
              class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent rounded-full px-2.5 py-0.5 text-xs no-underline transition-colors"
            >
              {tag}
            </a>
          ))
        }
        <span class="ml-auto">
          <ShareButton title={project.data.title} url={`/projects/${slug(project.id)}/`} client:idle />
        </span>
      </div>
      {
        project.data.audioUrl && (
          <div class="mt-8 mb-6">
            <p class="text-text-muted mb-2 text-sm">
              Listen while you read{project.data.audioDuration && ` · ${project.data.audioDuration}`}
            </p>
            <AudioPlayer src={project.data.audioUrl} title={`${project.data.title} — Audio Overview`} client:visible />
          </div>
        )
      }
      {
        project.data.heroImage && (
          <Picture
            src={project.data.heroImage}
            width={heroWidth}
            height={heroHeight}
            {...(isPublicPath(project.data.heroImage)
              ? {}
              : { widths: [640, 1200, 1920], formats: ['avif', 'webp'] as const })}
            alt={heroAlt}
            class="border-border mb-10 w-full rounded-lg border"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </header>

    {
      relatedEpisodes.length > 0 && (
        <div class="mb-10">
          <p class="text-text-muted mb-3 text-sm font-medium">Related episodes</p>
          <div class="space-y-2">
            {relatedEpisodes.map((ep) => (
              <a
                href={`/audio/${slug(ep.id)}/`}
                class="hover:border-accent/50 group border-border bg-surface-alt flex items-center gap-3 rounded-lg border p-3 no-underline transition-colors"
              >
                <svg class="text-accent h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                </svg>
                <div class="min-w-0">
                  <span class="text-text group-hover:text-accent block truncate text-sm transition-colors">
                    {ep.data.title}
                  </span>
                  {ep.data.duration && <span class="text-text-muted text-xs">{ep.data.duration}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      seriesProjects.length > 1 && (
        <nav class="border-border bg-surface-alt mb-8 rounded-lg border p-4" aria-label="Series navigation">
          <p class="text-text-muted mb-2 text-xs font-medium">
            Part {seriesProjects.findIndex((p) => p.id === project.id) + 1} of {seriesProjects.length} in{' '}
            <span class="text-accent">{project.data.series}</span>
          </p>
          <ol class="space-y-1">
            {seriesProjects.map((p, i) => (
              <li class="text-sm">
                {p.id === project.id ? (
                  <span class="text-accent font-medium">
                    {i + 1}. {p.data.title}
                  </span>
                ) : (
                  <a
                    href={`/projects/${slug(p.id)}/`}
                    class="text-text-muted hover:text-accent no-underline transition-colors"
                  >
                    {i + 1}. {p.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      allBlogPosts.length > 0 && (
        <div class="border-border bg-surface-alt mb-8 rounded-lg border p-4">
          <p class="text-text-muted mb-2 text-xs font-medium">
            Blog posts in <span class="text-accent">{project.data.series}</span>
          </p>
          <ol class="space-y-1">
            {allBlogPosts.map((p, i) => (
              <li class="text-sm">
                <a
                  href={`/blog/${slug(p.id)}/`}
                  class="text-text-muted hover:text-accent no-underline transition-colors"
                >
                  {i + 1}. {p.data.title}
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <TableOfContents contentSelector=".prose" client:idle />

    <div
      class="prose prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-semibold prose-headings:text-text prose-p:mb-4 prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:my-4 prose-blockquote:border-accent prose-blockquote:text-text-muted prose-strong:text-text prose-code:rounded prose-code:bg-surface-alt prose-code:px-1 prose-code:py-0.5 prose-code:text-text-accent prose-pre:my-4 prose-pre:border prose-pre:border-border prose-pre:bg-surface-alt prose-ol:my-4 prose-ul:my-4 prose-li:text-text max-w-none"
    >
      <Content />
    </div>

    {/* CTA — prominent links to live site / source. Shared with blog posts. */}
    <ProjectCTA url={project.data.url} repo={project.data.repo} />

    <NotebookAssets
      videoUrl={project.data.videoUrl}
      infographic={project.data.infographic}
      mindmap={project.data.mindmap}
      quiz={project.data.quiz}
      flashcards={project.data.flashcards}
      dataTable={project.data.dataTable}
      slides={project.data.slides}
      title={project.data.title}
    />

    <RelatedContent
      currentTags={project.data.tags}
      currentId={project.id}
      currentDate={project.data.date}
      contentType="projects"
    />

    <nav
      class="border-border mt-16 grid gap-4 border-t pt-8 sm:grid-cols-2"
      aria-label={inSeries ? 'Previous and next in series' : 'Previous and next projects'}
    >
      {
        prevProject ? (
          <a
            href={`/projects/${slug(prevProject.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors"
          >
            <span class="text-text-muted text-xs">
              <span aria-hidden="true">&larr;</span> {inSeries ? 'Previous in series' : 'Previous'}
            </span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {prevProject.data.title}
            </span>
          </a>
        ) : (
          <a href="/projects/" class="text-text-muted hover:text-accent flex items-center text-sm transition-colors">
            <span aria-hidden="true">&larr;</span> All projects
          </a>
        )
      }
      {
        nextProject && (
          <a
            href={`/projects/${slug(nextProject.id)}/`}
            class="hover:border-accent/50 group border-border rounded-lg border p-4 no-underline transition-colors sm:text-right"
          >
            <span class="text-text-muted text-xs">
              {inSeries ? 'Next in series' : 'Next'} <span aria-hidden="true">&rarr;</span>
            </span>
            <span class="text-text group-hover:text-accent mt-1 block text-sm font-medium transition-colors">
              {nextProject.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
