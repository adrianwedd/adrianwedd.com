---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slug, tagSlug } from '../../../lib/utils';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const projects = allProjects.filter((p) => !p.data.draft);
  const tags = [...new Set(projects.flatMap((p) => p.data.tags.map(tagSlug)))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      projects: projects
        .filter((p) => p.data.tags.some((t) => tagSlug(t) === tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, projects } = Astro.props;

const allProjectsForTags = await getCollection('projects');
const allTags = [
  ...new Set(allProjectsForTags.filter((p) => !p.data.draft).flatMap((p) => p.data.tags.map(tagSlug))),
].sort();

const statusColors: Record<string, string> = {
  active: 'text-status-active',
  complete: 'text-accent',
  archived: 'text-text-muted',
  experiment: 'text-status-experiment',
};
---

<BaseLayout title={`Projects tagged "${tag}"`} description={`Projects tagged with ${tag}.`} noindex>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-text">Tag: {tag}</h1>
    <p class="text-text-muted mt-2">{projects.length} project{projects.length !== 1 ? 's' : ''}</p>

    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter by tag">
      <a
        href="/projects/"
        class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent rounded-full px-3 py-1 text-xs no-underline transition-colors"
      >
        All
      </a>
      {
        allTags.map((t) => (
          <a
            href={`/projects/tag/${t}/`}
            class:list={[
              'rounded-full px-3 py-1 text-xs no-underline',
              t === tag
                ? 'bg-accent/15 text-accent font-medium'
                : 'hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent transition-colors',
            ]}
          >
            {t}
          </a>
        ))
      }
    </nav>

    <div class="mt-10 space-y-8">
      {
        projects.map((project) => (
          <article>
            <a
              href={`/projects/${slug(project.id)}/`}
              class="card-hover hover:border-accent/50 group border-border bg-surface-alt shadow-subtle hover:shadow-card block rounded-xl border p-6 no-underline transition-all"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="text-text group-hover:text-accent text-xl font-semibold transition-colors">
                    {project.data.title}
                  </h2>
                  <p class="text-text-muted mt-1 text-sm leading-relaxed">{project.data.description}</p>
                </div>
                <div class="flex flex-col items-end gap-1">
                  <time class="text-text-muted text-xs whitespace-nowrap" datetime={project.data.date.toISOString()}>
                    {project.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                  {project.data.status && (
                    <span class={`text-xs ${statusColors[project.data.status] || 'text-text-muted'}`}>
                      {project.data.status}
                    </span>
                  )}
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
