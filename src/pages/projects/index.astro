---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slug } from '../../lib/utils';
import ScrollReveal from '../../components/ScrollReveal.astro';
import fs from 'node:fs';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const allStatuses = [...new Set(projects.map((p) => p.data.status))].sort();

const statusLabels: Record<string, string> = {
  active: 'Active',
  complete: 'Complete',
  archived: 'Archived',
  experiment: 'Experiment',
};

const statusColors: Record<string, string> = {
  active: 'border-status-active-border text-status-active',
  complete: 'border-accent/30 text-accent',
  archived: 'border-border text-text-muted',
  experiment: 'border-status-experiment-border text-status-experiment',
};

// Load auto-discovered repos from cached data
interface GitHubRepo {
  name: string;
  description: string;
  language: string;
  topics: string[];
  url: string;
  homepage: string;
  stars: number;
  forks: number;
  updated_at: string;
  fork: boolean;
  archived: boolean;
}

let discoveredRepos: GitHubRepo[] = [];
try {
  const reposPath = new URL('../../data/repos.json', import.meta.url);
  const raw = fs.readFileSync(reposPath, 'utf-8');
  const allRepos: GitHubRepo[] = JSON.parse(raw);

  // Exclude: forks, archived, repos that already have project pages, empty repos
  const existingSlugs = new Set(allProjects.map((p) => slug(p.id).toLowerCase()));
  discoveredRepos = allRepos
    .filter((r) => !r.fork && !r.archived && r.description && !existingSlugs.has(r.name.toLowerCase()))
    .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime())
    .slice(0, 12);
} catch {
  // No repos.json yet — sync-repos.sh hasn't run
}
---

<BaseLayout
  title="Projects"
  description="Thirty-odd things built in public — AI safety tools, autonomous agents, community infrastructure, and instruments that shouldn't work but do."
  heroAnimation="blueprint"
>
  <section class="relative flex min-h-[100dvh] items-center px-4 sm:px-6 lg:px-8">
    <div class="relative z-10 mx-auto max-w-3xl">
      <h1 class="text-text">
        Thirty-odd things built in public.<br />
        <span class="text-text-muted"
          >AI safety tools, autonomous agents, community infrastructure, and instruments that shouldn't work but do.</span
        >
      </h1>
      <p class="text-text-muted mt-6 max-w-prose">
        The range is deliberate. Most real problems don't stay inside one domain, and the capacity to work across them
        came from not specialising artificially.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    {/* Status filter */}
    <div class="mt-8 flex flex-wrap gap-2" id="status-filters" role="group" aria-label="Filter by status">
      <button
        type="button"
        data-status=""
        class="status-filter bg-accent/15 text-accent cursor-pointer rounded-full px-3 py-1 text-xs font-medium transition-colors"
        aria-pressed="true"
      >
        All
      </button>
      {
        allStatuses.map((status) => (
          <button
            type="button"
            data-status={status}
            class="status-filter hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent cursor-pointer rounded-full px-3 py-1 text-xs transition-colors"
            aria-pressed="false"
          >
            {statusLabels[status] || status}
          </button>
        ))
      }
    </div>

    {/* Status legend */}
    <details class="mt-2">
      <summary class="text-text-muted hover:text-accent cursor-pointer text-xs">What do these mean?</summary>
      <div class="text-text-muted mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-xs sm:grid-cols-4">
        <p><span class="text-status-active">Active</span> — in development</p>
        <p><span class="text-accent">Complete</span> — finished, stable</p>
        <p><span class="text-text-muted">Archived</span> — no longer maintained</p>
        <p><span class="text-status-experiment">Experiment</span> — exploratory, may not ship</p>
      </div>
    </details>

    {/* Tag filter */}
    {
      allTags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2" id="tag-filters" role="group" aria-label="Filter by tag">
          <button
            type="button"
            data-tag=""
            class="tag-filter bg-accent/15 text-accent cursor-pointer rounded-full px-3 py-1 text-xs font-medium transition-colors"
            aria-pressed="true"
          >
            All tags
          </button>
          {allTags.map((tag, i) => (
            <button
              type="button"
              data-tag={tag}
              class:list={[
                'tag-filter hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent cursor-pointer rounded-full px-3 py-1 text-xs transition-colors',
                i >= 10 && 'project-tag-overflow hidden',
              ]}
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
          {allTags.length > 10 && (
            <button
              type="button"
              id="project-tags-toggle"
              aria-expanded="false"
              class="hover:bg-accent/15 bg-surface-raised text-text-muted hover:text-accent cursor-pointer rounded-full px-3 py-1 text-xs transition-colors"
            >
              +{allTags.length - 10} more
            </button>
          )}
        </div>
      )
    }

    {/* Sort control */}
    <div class="mt-4 flex items-center gap-2">
      <label for="sort-select" class="text-text-muted text-xs">Sort:</label>
      <select
        id="sort-select"
        class="border-border bg-surface-alt text-text-muted focus:border-accent rounded border px-2 py-1 text-xs focus:outline-none"
      >
        <option value="featured">Featured first</option>
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="alpha">A–Z</option>
      </select>
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2" id="project-grid">
      {
        projects.map((project) => (
          <article
            data-tags={JSON.stringify(project.data.tags)}
            data-status={project.data.status}
            data-featured={project.data.featured ? 'true' : ''}
            data-date={project.data.date.toISOString()}
            data-title={project.data.title}
            class="project-card transition-opacity duration-200"
          >
            <ScrollReveal>
              <a
                href={`/projects/${slug(project.id)}/`}
                class="card-hover hover:border-accent/50 group border-border bg-surface-alt shadow-subtle hover:shadow-card block h-full rounded-xl border p-6 no-underline transition-all"
              >
                <div class="flex items-start justify-between gap-3">
                  <h2 class="text-text group-hover:text-accent text-lg font-semibold transition-colors">
                    {project.data.title}
                  </h2>
                  <span
                    class:list={[
                      'rounded-full border px-2 py-0.5 text-xs whitespace-nowrap',
                      statusColors[project.data.status] || 'border-border text-text-muted',
                    ]}
                  >
                    {statusLabels[project.data.status] || project.data.status}
                  </span>
                </div>
                <p class="text-text-muted mt-2 text-sm leading-relaxed">{project.data.description}</p>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  {project.data.tags.slice(0, 4).map((tag: string) => (
                    <span class="bg-surface-raised text-text-muted rounded-full px-2.5 py-0.5 text-xs">{tag}</span>
                  ))}
                  <time
                    class="text-text-muted ml-auto text-xs whitespace-nowrap"
                    datetime={project.data.date.toISOString()}
                  >
                    {project.data.date.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' })}
                  </time>
                </div>
              </a>
            </ScrollReveal>
          </article>
        ))
      }
    </div>

    <p id="no-results" class="text-text-muted mt-10 hidden text-center">No projects match these filters.</p>

    {/* Auto-discovered repos from GitHub */}
    {
      discoveredRepos.length > 0 && (
        <section class="border-border mt-16 border-t pt-10">
          <h2 class="text-text text-lg font-semibold">More on GitHub</h2>
          <p class="text-text-muted mt-1 text-sm">Other public repos, auto-discovered from GitHub.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {discoveredRepos.map((repo) => (
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:border-accent/50 group border-border bg-surface-alt hover:shadow-card block rounded-lg border p-4 no-underline transition-all"
              >
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-text group-hover:text-accent font-mono text-sm font-medium transition-colors">
                    {repo.name}
                  </h3>
                  {repo.language && (
                    <span class="bg-surface-raised text-text-muted shrink-0 rounded-full px-2.5 py-0.5 text-xs">
                      {repo.language}
                    </span>
                  )}
                </div>
                <p class="text-text-muted mt-1 line-clamp-2 text-xs leading-relaxed">{repo.description}</p>
                {repo.stars > 0 && <span class="text-text-muted mt-2 inline-block text-xs">★ {repo.stars}</span>}
              </a>
            ))}
          </div>
          <p class="text-text-muted mt-4 text-sm">
            <a
              href="https://github.com/adrianwedd?tab=repositories"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline"
            >
              View all repositories →
            </a>
          </p>
        </section>
      )
    }
  </section>

  <script is:inline>
    (function () {
      var activeStatus = '';
      var activeTag = '';
      var tagOverflowExpanded = false;

      function getCards() {
        return Array.from(document.querySelectorAll('.project-card'));
      }

      function setActiveButton(containerId, cls, value, attr) {
        var container = document.getElementById(containerId);
        if (!container) return;
        container.querySelectorAll('.' + cls).forEach(function (b) {
          var match = (b.dataset[attr] || '') === value;
          b.classList.toggle('border-accent', match);
          b.classList.toggle('bg-accent/10', match);
          b.classList.toggle('text-accent', match);
          b.classList.toggle('font-medium', match);
          b.classList.toggle('border-border', !match);
          b.classList.toggle('text-text-muted', !match);
          b.setAttribute('aria-pressed', match ? 'true' : 'false');
        });
      }

      function updateURL() {
        var sortSelect = document.getElementById('sort-select');
        var p = new URLSearchParams();
        if (activeStatus) p.set('status', activeStatus);
        if (activeTag) p.set('tag', activeTag);
        if (sortSelect && sortSelect.value !== 'featured') p.set('sort', sortSelect.value);
        var qs = p.toString();
        history.replaceState(null, '', qs ? '?' + qs : window.location.pathname);
      }

      function applyFilters() {
        var cards = getCards();
        var noResults = document.getElementById('no-results');
        var visible = 0;
        cards.forEach(function (card) {
          var matchStatus = !activeStatus || card.dataset.status === activeStatus;
          var tags = [];
          try {
            tags = JSON.parse(card.dataset.tags || '[]');
          } catch (e) {}
          var matchTag = !activeTag || tags.indexOf(activeTag) !== -1;
          var show = matchStatus && matchTag;
          card.style.opacity = show ? '1' : '0';
          setTimeout(
            function () {
              card.style.display = show ? '' : 'none';
            },
            show ? 0 : 200,
          );
          if (show) visible++;
        });
        if (noResults) noResults.classList.toggle('hidden', visible > 0);
        updateURL();
      }

      function applySort() {
        var grid = document.getElementById('project-grid');
        var sortSelect = document.getElementById('sort-select');
        var cards = getCards();
        if (!grid || !sortSelect) return;
        var sorted = cards.slice().sort(function (a, b) {
          var sort = sortSelect.value;
          if (sort === 'featured') {
            var af = a.dataset.featured ? 1 : 0;
            var bf = b.dataset.featured ? 1 : 0;
            if (af !== bf) return bf - af;
            return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime();
          }
          if (sort === 'newest') return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime();
          if (sort === 'oldest') return new Date(a.dataset.date).getTime() - new Date(b.dataset.date).getTime();
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        });
        sorted.forEach(function (card) {
          grid.appendChild(card);
        });
        updateURL();
      }

      function initProjectFilters() {
        var sortSelect = document.getElementById('sort-select');
        if (!document.getElementById('project-grid')) return;

        // Read URL params
        var params = new URLSearchParams(window.location.search);
        activeStatus = params.get('status') || '';
        activeTag = params.get('tag') || '';
        if (params.get('sort') && sortSelect) sortSelect.value = params.get('sort');

        setActiveButton('status-filters', 'status-filter', activeStatus, 'status');
        setActiveButton('tag-filters', 'tag-filter', activeTag, 'tag');
        applySort();
        applyFilters();
      }

      if (!document.documentElement.dataset.projectFilterInit) {
        document.documentElement.dataset.projectFilterInit = '1';

        document.addEventListener('click', function (e) {
          var target = e.target;
          if (!target || typeof target.closest !== 'function') return;

          var statusBtn = target.closest('#status-filters .status-filter');
          if (statusBtn && document.getElementById('project-grid')) {
            activeStatus = statusBtn.dataset.status || '';
            setActiveButton('status-filters', 'status-filter', activeStatus, 'status');
            applyFilters();
            return;
          }

          var tagBtn = target.closest('#tag-filters .tag-filter');
          if (tagBtn && document.getElementById('project-grid')) {
            activeTag = tagBtn.dataset.tag || '';
            setActiveButton('tag-filters', 'tag-filter', activeTag, 'tag');
            applyFilters();
            return;
          }

          if (target.closest('#project-tags-toggle')) {
            tagOverflowExpanded = !tagOverflowExpanded;
            document.querySelectorAll('.project-tag-overflow').forEach(function (el) {
              el.classList.toggle('hidden', !tagOverflowExpanded);
            });
            var toggle = document.getElementById('project-tags-toggle');
            if (toggle) {
              toggle.textContent = tagOverflowExpanded ? 'Show less' : toggle.dataset.label || '';
              toggle.setAttribute('aria-expanded', String(tagOverflowExpanded));
            }
            return;
          }
        });

        document.addEventListener('change', function (e) {
          if (e.target && e.target.id === 'sort-select' && document.getElementById('project-grid')) {
            applySort();
            applyFilters();
          }
        });

        document.addEventListener('astro:after-swap', function () {
          tagOverflowExpanded = false;
          var toggle = document.getElementById('project-tags-toggle');
          if (toggle && !toggle.dataset.label) toggle.dataset.label = toggle.textContent || '';
          initProjectFilters();
        });
      }

      // Store label for toggle
      var tagToggle = document.getElementById('project-tags-toggle');
      if (tagToggle && !tagToggle.dataset.label) tagToggle.dataset.label = tagToggle.textContent || '';

      initProjectFilters();
    })();
  </script>
</BaseLayout>
