---
import BaseLayout from '../layouts/BaseLayout.astro';
import Personalisation from '../components/islands/Personalisation.tsx';
import { getCollection } from 'astro:content';
import { slug } from '../lib/utils';
import ScrollReveal from '../components/ScrollReveal.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Adrian Wedd"
  description="Digital systems builder for practical business infrastructure, AI safety, systems architecture, and security-aware delivery. Based in Tasmania."
  heroAnimation="terrain"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Adrian Wedd',
      url: 'https://adrianwedd.com',
      description:
        'Digital systems builder for practical business infrastructure, AI safety, systems architecture, and security-aware delivery. Based in Tasmania.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://adrianwedd.com/search/?s={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        sameAs: ['https://github.com/adrianwedd', 'https://www.linkedin.com/in/adrianwedd/'],
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'AI Consulting & Development',
              url: 'https://adrianwedd.com/services/',
            },
          },
        ],
      },
    })}
  />
  {/* Hero */}
  <section
    class="hero-glow relative flex min-h-[100dvh] items-center px-4 sm:px-6 lg:px-8"
    aria-label="Introduction"
    data-pagefind-body
  >
    <div class="relative z-10 mx-auto max-w-6xl">
      <Personalisation client:idle />
      <h1 class="animate-in text-text">Adrian Wedd</h1>
      <p
        class="animate-in text-text-muted mt-4 max-w-prose text-xl leading-relaxed sm:text-2xl"
        style="animation-delay: 0.1s"
      >
        I build things that work for people who need them — and I break things on purpose to make sure they actually do.
      </p>
      <p class="animate-in text-text-muted mt-6 max-w-prose text-base leading-relaxed" style="animation-delay: 0.2s">
        Greenpeace Actions to government cybersecurity to AI safety. Same methodology every time: enumerate failure
        modes before you move.
      </p>
      <div class="animate-in mt-8 flex flex-wrap gap-4" style="animation-delay: 0.3s">
        <a
          href="/services/"
          class="btn-primary bg-accent text-surface inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium no-underline hover:opacity-90"
        >
          Work with me
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/projects/"
          class="btn-secondary border-border text-text-muted hover:border-accent hover:text-accent inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium no-underline"
        >
          View Projects
        </a>
      </div>
    </div>
  </section>

  {/* Flagship projects — text-only grid */}
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8" aria-label="Flagship projects">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-text-muted text-sm font-medium tracking-wider uppercase">Current Work</h2>
      <a href="/projects/" class="text-text-muted hover:text-accent text-sm transition-colors">All projects &rarr;</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href="/projects/spark/"
        class="hover:border-accent/50 group border-border bg-surface-alt hover:shadow-card rounded-xl border p-5 no-underline transition-all"
      >
        <span
          class="border-status-active-border text-status-active mb-2 inline-block rounded-full border px-2 py-0.5 text-xs"
          >Active</span
        >
        <h3 class="text-text group-hover:text-accent text-base font-semibold transition-colors">SPARK</h3>
        <p class="text-text-muted mt-2 text-sm leading-relaxed">
          Non-coercive AI robot companion for neurodivergent children.
        </p>
      </a>
      <a
        href="/projects/failure-first/"
        class="hover:border-accent/50 group border-border bg-surface-alt hover:shadow-card rounded-xl border p-5 no-underline transition-all"
      >
        <span
          class="border-status-active-border text-status-active mb-2 inline-block rounded-full border px-2 py-0.5 text-xs"
          >Active</span
        >
        <h3 class="text-text group-hover:text-accent text-base font-semibold transition-colors">Failure First</h3>
        <p class="text-text-muted mt-2 text-sm leading-relaxed">
          Adversarial evaluation framework. 120+ models, 18,000+ prompts.
        </p>
      </a>
      <a
        href="/projects/this-wasnt-in-the-brochure/"
        class="hover:border-accent/50 group border-border bg-surface-alt hover:shadow-card rounded-xl border p-5 no-underline transition-all"
      >
        <span
          class="border-status-active-border text-status-active mb-2 inline-block rounded-full border px-2 py-0.5 text-xs"
          >Active</span
        >
        <h3 class="text-text group-hover:text-accent text-base font-semibold transition-colors">
          This Wasn't in the Brochure
        </h3>
        <p class="text-text-muted mt-2 text-sm leading-relaxed">
          Neurodivergent co-parenting guide — the brain you actually have.
        </p>
      </a>
      <a
        href="/projects/afterwords/"
        class="hover:border-accent/50 group border-border bg-surface-alt hover:shadow-card rounded-xl border p-5 no-underline transition-all"
      >
        <span
          class="border-status-active-border text-status-active mb-2 inline-block rounded-full border px-2 py-0.5 text-xs"
          >Active</span
        >
        <h3 class="text-text group-hover:text-accent text-base font-semibold transition-colors">Afterwords</h3>
        <p class="text-text-muted mt-2 text-sm leading-relaxed">
          Local voice output for Claude Code — 17 cloned voices, zero cloud.
        </p>
      </a>
    </div>
  </section>

  {/* Consulting CTA */}
  <section aria-label="Consulting availability" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="border-accent/30 bg-surface-alt rounded-xl border p-8 sm:flex sm:items-center sm:justify-between">
      <div>
        <h2 class="text-text text-lg font-semibold">Have a problem worth solving?</h2>
        <p class="text-text-muted mt-2 max-w-prose text-sm">
          Tell me what's broken or what you're trying to build. I'll tell you whether I'm useful.
        </p>
      </div>
      <div class="mt-6 flex flex-shrink-0 flex-wrap gap-3 sm:mt-0 sm:ml-8">
        <a
          href="/services/"
          class="btn-primary bg-accent text-surface inline-block rounded-lg px-5 py-2.5 text-sm font-medium no-underline hover:opacity-90"
        >
          See services
        </a>
        <a
          href="/contact/"
          class="btn-secondary border-border text-text hover:border-accent hover:text-accent inline-block rounded-lg border px-5 py-2.5 text-sm font-medium no-underline"
        >
          Book a free call
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider mx-auto max-w-6xl"></div>

  {/* Recent posts */}
  {
    recentPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="mb-8 flex items-baseline justify-between">
            <h2 class="text-text">Recent Writing</h2>
            <a href="/blog/" class="text-text-muted hover:text-accent text-sm transition-colors">
              All posts &rarr;
            </a>
          </div>
        </ScrollReveal>
        <div class="space-y-6">
          {recentPosts.map((post) => (
            <ScrollReveal>
              <a
                href={`/blog/${slug(post.id)}/`}
                class="card-hover hover:border-accent/50 group border-border bg-surface-alt shadow-subtle hover:shadow-card block rounded-xl border p-6 no-underline transition-all"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-text group-hover:text-accent text-lg font-semibold transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-text-muted mt-1 text-sm leading-relaxed">{post.data.description}</p>
                  </div>
                  <time class="text-text-muted text-xs whitespace-nowrap" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
