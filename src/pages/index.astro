---
import BaseLayout from '../layouts/BaseLayout.astro';
import Personalisation from '../components/islands/Personalisation.tsx';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { slug } from '../lib/utils';
import ScrollReveal from '../components/ScrollReveal.astro';
import { getPlaceholder } from '../lib/placeholder';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allGalleries = await getCollection('gallery');
const recentGalleries = allGalleries
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allEpisodes = await getCollection('audio');
const recentEpisodes = allEpisodes
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const galleryPlaceholders = new Map<string, string>();
for (const collection of recentGalleries) {
  if (collection.data.coverImage) {
    const ph = await getPlaceholder(collection.data.coverImage);
    if (ph) galleryPlaceholders.set(collection.data.coverImage, ph);
  }
}

const projectPlaceholders = new Map<string, string>();
for (const project of featuredProjects) {
  if (project.data.heroImage) {
    const ph = await getPlaceholder(project.data.heroImage);
    if (ph) projectPlaceholders.set(project.data.heroImage, ph);
  }
}
---

<BaseLayout
  title="Adrian Wedd"
  description="Systems builder, AI safety researcher, adversarial thinker. Nearly 45 years across the stack. Based in Tasmania."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Adrian Wedd',
      url: 'https://adrianwedd.com',
      description: 'Systems builder, AI safety researcher, adversarial thinker. Nearly 45 years across the stack. Based in Tasmania.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://adrianwedd.com/search/?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        sameAs: [
          'https://github.com/adrianwedd',
          'https://www.linkedin.com/in/adrianwedd/',
        ],
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'AI Consulting & Development',
              url: 'https://adrianwedd.com/services/',
            },
          },
        ],
      },
    })}
  />
  {/* Hero */}
  <section class="hero-glow mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <Personalisation client:load />
    <h1 class="animate-in text-text">Adrian Wedd</h1>
    <p
      class="animate-in mt-4 max-w-prose text-xl leading-relaxed text-text-muted sm:text-2xl"
      style="animation-delay: 0.1s"
    >
      I build systems, break them deliberately, and use what I learn to make the next ones harder to break.
    </p>
    <p class="animate-in mt-6 max-w-prose text-base leading-relaxed text-text-muted" style="animation-delay: 0.2s">
      AI safety researcher, systems architect, adversarial thinker. Nearly 45 years across the stack. This is the
      workshop — finished work, active research, and raw thinking, all in one place.
    </p>
    <div class="animate-in mt-8 flex flex-wrap gap-4" style="animation-delay: 0.3s">
      <a
        href="/projects/"
        class="btn-primary inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-surface no-underline hover:opacity-90"
      >
        View Projects
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a
        href="/blog/"
        class="btn-secondary inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-text-muted no-underline hover:border-accent hover:text-accent"
      >
        Read Blog
      </a>
    </div>
  </section>

  {/* Hero carousel — flagship projects */}
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8" aria-label="Flagship projects">
    <div id="hero-carousel" class="relative overflow-hidden rounded-xl border border-border bg-surface-alt shadow-subtle">
      <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out">
        {/* SPARK */}
        <div class="carousel-slide w-full flex-shrink-0">
          <a href="/projects/spark/" class="group block no-underline sm:flex sm:items-stretch">
            <div class="aspect-[16/9] overflow-hidden sm:aspect-auto sm:w-1/2">
              <Picture
                src="/notebook-assets/spark/infographic.webp"
                width={600}
                height={400}
                formats={['webp']}
                alt="SPARK robot companion"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="eager"
              />
            </div>
            <div class="flex flex-col justify-center p-6 sm:w-1/2 sm:p-8">
              <span class="mb-2 inline-block w-fit rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active">Active</span>
              <h3 class="text-xl font-semibold text-text transition-colors group-hover:text-accent sm:text-2xl">SPARK</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">A non-coercive AI robot companion for neurodivergent children. Raspberry Pi 5, Claude Haiku, declarative presence.</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
                Explore
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </span>
            </div>
          </a>
        </div>

        {/* This Wasn't in the Brochure */}
        <div class="carousel-slide w-full flex-shrink-0">
          <a href="/projects/this-wasnt-in-the-brochure/" class="group block no-underline sm:flex sm:items-stretch">
            <div class="aspect-[16/9] overflow-hidden sm:aspect-auto sm:w-1/2">
              <Picture
                src="/notebook-assets/this-wasnt-in-the-brochure/infographic.webp"
                width={600}
                height={400}
                formats={['webp']}
                alt="This Wasn't in the Brochure"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col justify-center p-6 sm:w-1/2 sm:p-8">
              <span class="mb-2 inline-block w-fit rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active">Active</span>
              <h3 class="text-xl font-semibold text-text transition-colors group-hover:text-accent sm:text-2xl">This Wasn't in the Brochure</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">A neurodivergent co-parenting guide — what happens when the life you planned meets the brain you actually have.</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
                Explore
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </span>
            </div>
          </a>
        </div>

        {/* Failure First */}
        <div class="carousel-slide w-full flex-shrink-0">
          <a href="/projects/failure-first/" class="group block no-underline sm:flex sm:items-stretch">
            <div class="aspect-[16/9] overflow-hidden sm:aspect-auto sm:w-1/2">
              <Picture
                src="/notebook-assets/failure-first/infographic.webp"
                width={600}
                height={400}
                formats={['webp']}
                alt="Failure First adversarial evaluation"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col justify-center p-6 sm:w-1/2 sm:p-8">
              <span class="mb-2 inline-block w-fit rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active">Active</span>
              <h3 class="text-xl font-semibold text-text transition-colors group-hover:text-accent sm:text-2xl">Failure First</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">Adversarial evaluation framework for embodied AI. 120+ models, 18,000+ prompts, four headline findings.</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
                Explore
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </span>
            </div>
          </a>
        </div>
      </div>

      {/* Live region for screen readers */}
      <div id="carousel-live" class="sr-only" aria-live="polite" aria-atomic="true">Slide 1 of 3</div>

      {/* Navigation dots */}
      <div class="flex items-center justify-center gap-2 py-4">
        <button type="button" class="carousel-dot h-2 w-6 rounded-full bg-accent transition-all" data-slide="0" aria-label="Slide 1: SPARK" aria-current="true"></button>
        <button type="button" class="carousel-dot h-2 w-2 rounded-full bg-border transition-all hover:bg-accent/50" data-slide="1" aria-label="Slide 2: This Wasn't in the Brochure"></button>
        <button type="button" class="carousel-dot h-2 w-2 rounded-full bg-border transition-all hover:bg-accent/50" data-slide="2" aria-label="Slide 3: Failure First"></button>
      </div>

      {/* Prev/Next buttons */}
      <button type="button" id="carousel-prev" class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 p-2 text-text-muted backdrop-blur-sm transition-colors hover:border-accent hover:text-accent" aria-label="Previous slide">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button type="button" id="carousel-next" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 p-2 text-text-muted backdrop-blur-sm transition-colors hover:border-accent hover:text-accent" aria-label="Next slide">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </section>

  <script is:inline>
  (function () {
    var currentSlide = 0;
    var totalSlides = 3;
    var autoplayInterval = null;

    function goToSlide(n) {
      currentSlide = ((n % totalSlides) + totalSlides) % totalSlides;
      var track = document.getElementById('carousel-track');
      if (track) track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
      document.querySelectorAll('.carousel-dot').forEach(function (dot) {
        var isActive = Number(dot.dataset.slide) === currentSlide;
        dot.classList.toggle('bg-accent', isActive);
        dot.classList.toggle('w-6', isActive);
        dot.classList.toggle('bg-border', !isActive);
        dot.classList.toggle('w-2', !isActive);
        if (isActive) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      var liveRegion = document.getElementById('carousel-live');
      if (liveRegion) liveRegion.textContent = 'Slide ' + (currentSlide + 1) + ' of ' + totalSlides;
    }

    function startAutoplay() {
      stopAutoplay();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      autoplayInterval = setInterval(function () { goToSlide(currentSlide + 1); }, 6000);
    }

    function stopAutoplay() {
      if (autoplayInterval) { clearInterval(autoplayInterval); autoplayInterval = null; }
    }

    function initCarousel() {
      stopAutoplay();
      if (!document.getElementById('hero-carousel')) return;
      totalSlides = document.querySelectorAll('.carousel-slide').length;
      currentSlide = 0;
      goToSlide(0);
      startAutoplay();
    }

    if (!document.documentElement.dataset.carouselInit) {
      document.documentElement.dataset.carouselInit = '1';

      document.addEventListener('click', function (e) {
        var target = e.target;
        if (!target || typeof target.closest !== 'function') return;

        if (target.closest('#carousel-prev')) {
          stopAutoplay();
          goToSlide(currentSlide - 1);
          startAutoplay();
          return;
        }
        if (target.closest('#carousel-next')) {
          stopAutoplay();
          goToSlide(currentSlide + 1);
          startAutoplay();
          return;
        }
        var dot = target.closest('.carousel-dot');
        if (dot && dot.dataset.slide !== undefined) {
          stopAutoplay();
          goToSlide(Number(dot.dataset.slide));
          startAutoplay();
          return;
        }
      });

      // Pause autoplay on hover
      document.addEventListener('mouseenter', function (e) {
        if (e.target && e.target.id === 'hero-carousel') stopAutoplay();
      }, true);
      document.addEventListener('mouseleave', function (e) {
        if (e.target && e.target.id === 'hero-carousel') startAutoplay();
      }, true);

      // Keyboard navigation
      document.addEventListener('keydown', function (e) {
        if (!document.getElementById('hero-carousel')) return;
        if (e.key === 'ArrowLeft') { stopAutoplay(); goToSlide(currentSlide - 1); startAutoplay(); }
        if (e.key === 'ArrowRight') { stopAutoplay(); goToSlide(currentSlide + 1); startAutoplay(); }
      });

      // Touch swipe support
      var touchStartX = 0;
      document.addEventListener('touchstart', function (e) {
        var carousel = e.target.closest && e.target.closest('#hero-carousel');
        if (carousel) touchStartX = e.touches[0].clientX;
      }, { passive: true });
      document.addEventListener('touchend', function (e) {
        var carousel = e.target.closest && e.target.closest('#hero-carousel');
        if (!carousel) return;
        var diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          stopAutoplay();
          goToSlide(currentSlide + (diff > 0 ? 1 : -1));
          startAutoplay();
        }
      });

      document.addEventListener('astro:after-swap', initCarousel);
    }

    initCarousel();
  })();
  </script>

  <div class="section-divider mx-auto max-w-6xl"></div>

  {/* Featured projects */}
  {
    featuredProjects.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="mb-8 flex items-baseline justify-between">
            <h2 class="text-text">Featured Work</h2>
            <a href="/projects/" class="text-sm text-text-muted transition-colors hover:text-accent">
              All projects &rarr;
            </a>
          </div>
        </ScrollReveal>
        <div class="grid gap-6 sm:grid-cols-2">
          {featuredProjects.map((project, i) => (
            <ScrollReveal stagger={i * 100}>
              <a
                href={`/projects/${slug(project.id)}/`}
                class="card-hover hover:border-accent/50 group block overflow-hidden rounded-xl border border-border bg-surface-alt no-underline shadow-subtle transition-all hover:shadow-card"
              >
                {project.data.heroImage && (
                  <div
                    class="blur-up"
                    style={projectPlaceholders.get(project.data.heroImage) ? `background-image: url(${projectPlaceholders.get(project.data.heroImage)})` : undefined}
                  >
                    <Picture
                      src={project.data.heroImage}
                      width={600}
                      height={160}
                      widths={[320, 600, 900]}
                      formats={['avif', 'webp']}
                      alt={`${project.data.title} hero image`}
                      class="h-40 w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="p-6">
                  <h3 class="text-lg font-semibold text-text transition-colors group-hover:text-accent">
                    {project.data.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-text-muted">{project.data.description}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {project.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="rounded-full bg-surface-raised px-2.5 py-0.5 text-xs text-text-muted">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/projects/" class="text-sm text-text-muted transition-colors hover:text-accent">
            All projects &rarr;
          </a>
        </div>
      </section>
    )
  }

  {/* Consulting CTA */}
  <section
    aria-label="Consulting availability"
    class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8"
  >
    <div class="rounded-xl border border-accent/30 bg-surface-alt p-8 sm:flex sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold text-text">Available for consulting &amp; builds</h2>
        <p class="mt-2 max-w-prose text-sm text-text-muted">
          AI integration, security evaluation, and web development. Fixed-scope projects, monthly retainers, day-rate consulting.
        </p>
      </div>
      <div class="mt-6 flex flex-shrink-0 flex-wrap gap-3 sm:ml-8 sm:mt-0">
        <a
          href="/services/"
          class="btn-primary inline-block rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-surface no-underline hover:opacity-90"
        >
          See services
        </a>
        <a
          href="/contact/"
          class="btn-secondary inline-block rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-text no-underline hover:border-accent hover:text-accent"
        >
          Book a free call
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider mx-auto max-w-6xl"></div>

  {/* Recent posts */}
  {
    recentPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="mb-8 flex items-baseline justify-between">
            <h2 class="text-text">Recent Writing</h2>
            <a href="/blog/" class="text-sm text-text-muted transition-colors hover:text-accent">
              All posts &rarr;
            </a>
          </div>
        </ScrollReveal>
        <div class="space-y-6">
          {recentPosts.map((post) => (
            <ScrollReveal>
              <a
                href={`/blog/${slug(post.id)}/`}
                class="card-hover hover:border-accent/50 group block rounded-xl border border-border bg-surface-alt p-6 no-underline shadow-subtle transition-all hover:shadow-card"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-semibold text-text transition-colors group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-text-muted">{post.data.description}</p>
                  </div>
                  <time class="whitespace-nowrap text-xs text-text-muted" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )
  }

  {/* Gallery preview */}
  {
    recentGalleries.length > 0 && (
      <>
        <div class="section-divider mx-auto max-w-6xl" />
        <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
          <ScrollReveal>
            <div class="mb-8 flex items-baseline justify-between">
              <h2 class="text-text">Gallery</h2>
              <a href="/gallery/" class="text-sm text-text-muted transition-colors hover:text-accent">
                All collections &rarr;
              </a>
            </div>
          </ScrollReveal>
          <div class="grid gap-6 sm:grid-cols-3">
            {recentGalleries.map((collection) => (
              <ScrollReveal>
                <a
                  href={`/gallery/${slug(collection.id)}/`}
                  class="card-hover hover:border-accent/50 group block overflow-hidden rounded-xl border border-border no-underline shadow-subtle transition-all hover:shadow-card"
                >
                  {collection.data.coverImage && (
                    <div
                      class="img-placeholder blur-up aspect-[4/3] overflow-hidden"
                      style={galleryPlaceholders.get(collection.data.coverImage) ? `background-image: url(${galleryPlaceholders.get(collection.data.coverImage)})` : undefined}
                    >
                      <Picture
                        src={collection.data.coverImage}
                        width={400}
                        height={300}
                        widths={[200, 400, 800]}
                        formats={['avif', 'webp']}
                        alt={collection.data.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <div class="p-4">
                    <h3 class="text-sm font-semibold text-text transition-colors group-hover:text-accent">
                      {collection.data.title}
                    </h3>
                    <p class="mt-1 text-xs text-text-muted">
                      {collection.data.images.length} image{collection.data.images.length !== 1 ? 's' : ''}
                    </p>
                  </div>
                </a>
              </ScrollReveal>
            ))}
          </div>
        </section>
      </>
    )
  }

  {/* Audio preview */}
  {
    recentEpisodes.length > 0 && (
      <>
        <div class="section-divider mx-auto max-w-6xl" />
        <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
          <ScrollReveal>
            <div class="mb-8 flex items-baseline justify-between">
              <h2 class="text-text">Audio</h2>
              <a href="/audio/" class="text-sm text-text-muted transition-colors hover:text-accent">
                All episodes &rarr;
              </a>
            </div>
          </ScrollReveal>
          <div class="space-y-4">
            {recentEpisodes.map((episode) => (
              <ScrollReveal>
                <a
                  href={`/audio/${slug(episode.id)}/`}
                  class="card-hover hover:border-accent/50 group block rounded-xl border border-border bg-surface-alt p-5 no-underline shadow-subtle transition-all hover:shadow-card"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">
                        {episode.data.title}
                      </h3>
                      <p class="mt-1 text-sm leading-relaxed text-text-muted line-clamp-2">{episode.data.description}</p>
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                      <time class="whitespace-nowrap text-xs text-text-muted" datetime={episode.data.date.toISOString()}>
                        {episode.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </time>
                      {episode.data.duration && (
                        <span class="text-xs text-text-muted">{episode.data.duration}</span>
                      )}
                    </div>
                  </div>
                </a>
              </ScrollReveal>
            ))}
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
