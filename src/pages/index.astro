---
import BaseLayout from '../layouts/BaseLayout.astro';
import Personalisation from '../components/islands/Personalisation.tsx';
import { getCollection } from 'astro:content';
import { slug } from '../lib/utils';
import ScrollReveal from '../components/ScrollReveal.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Adrian Wedd"
  description="Digital systems builder for practical business infrastructure, AI safety, systems architecture, and security-aware delivery. Based in Tasmania."
  heroAnimation="terrain"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Adrian Wedd',
      url: 'https://adrianwedd.com',
      description: 'Digital systems builder for practical business infrastructure, AI safety, systems architecture, and security-aware delivery. Based in Tasmania.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://adrianwedd.com/search/?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        sameAs: ['https://github.com/adrianwedd', 'https://www.linkedin.com/in/adrianwedd/'],
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'AI Consulting & Development',
              url: 'https://adrianwedd.com/services/',
            },
          },
        ],
      },
    })}
  />
  {/* Hero */}
  <section class="hero-glow relative flex min-h-[100dvh] items-center px-4 sm:px-6 lg:px-8" aria-label="Introduction">
    <div class="relative z-10 mx-auto max-w-6xl">
      <Personalisation client:idle />
      <h1 class="animate-in text-text">Adrian Wedd</h1>
      <p
        class="animate-in mt-4 max-w-prose text-xl leading-relaxed text-text-muted sm:text-2xl"
        style="animation-delay: 0.1s"
      >
        I build things that work for people who need them — and I break things on purpose to make sure they actually do.
      </p>
      <p class="animate-in mt-6 max-w-prose text-base leading-relaxed text-text-muted" style="animation-delay: 0.2s">
        Greenpeace Actions to government cybersecurity to AI safety. Same methodology every time: enumerate failure
        modes before you move.
      </p>
      <div class="animate-in mt-8 flex flex-wrap gap-4" style="animation-delay: 0.3s">
        <a
          href="/services/"
          class="btn-primary inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-surface no-underline hover:opacity-90"
        >
          Work with me
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/projects/"
          class="btn-secondary inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-text-muted no-underline hover:border-accent hover:text-accent"
        >
          View Projects
        </a>
      </div>
    </div>
  </section>

  {/* Flagship projects — text-only grid */}
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8" aria-label="Flagship projects">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-sm font-medium uppercase tracking-wider text-text-muted">Current Work</h2>
      <a href="/projects/" class="text-sm text-text-muted transition-colors hover:text-accent">All projects &rarr;</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href="/projects/spark/"
        class="hover:border-accent/50 group rounded-xl border border-border bg-surface-alt p-5 no-underline transition-all hover:shadow-card"
      >
        <span
          class="mb-2 inline-block rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active"
          >Active</span
        >
        <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">SPARK</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Non-coercive AI robot companion for neurodivergent children.
        </p>
      </a>
      <a
        href="/projects/failure-first/"
        class="hover:border-accent/50 group rounded-xl border border-border bg-surface-alt p-5 no-underline transition-all hover:shadow-card"
      >
        <span
          class="mb-2 inline-block rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active"
          >Active</span
        >
        <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">Failure First</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Adversarial evaluation framework. 120+ models, 18,000+ prompts.
        </p>
      </a>
      <a
        href="/projects/this-wasnt-in-the-brochure/"
        class="hover:border-accent/50 group rounded-xl border border-border bg-surface-alt p-5 no-underline transition-all hover:shadow-card"
      >
        <span
          class="mb-2 inline-block rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active"
          >Active</span
        >
        <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">
          This Wasn't in the Brochure
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Neurodivergent co-parenting guide — the brain you actually have.
        </p>
      </a>
      <a
        href="/projects/afterwords/"
        class="hover:border-accent/50 group rounded-xl border border-border bg-surface-alt p-5 no-underline transition-all hover:shadow-card"
      >
        <span
          class="mb-2 inline-block rounded-full border border-status-active-border px-2 py-0.5 text-xs text-status-active"
          >Active</span
        >
        <h3 class="text-base font-semibold text-text transition-colors group-hover:text-accent">Afterwords</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Local voice output for Claude Code — 17 cloned voices, zero cloud.
        </p>
      </a>
    </div>
  </section>

  {/* Consulting CTA */}
  <section aria-label="Consulting availability" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="border-accent/30 rounded-xl border bg-surface-alt p-8 sm:flex sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold text-text">Have a problem worth solving?</h2>
        <p class="mt-2 max-w-prose text-sm text-text-muted">
          Tell me what's broken or what you're trying to build. I'll tell you whether I'm useful.
        </p>
      </div>
      <div class="mt-6 flex flex-shrink-0 flex-wrap gap-3 sm:ml-8 sm:mt-0">
        <a
          href="/services/"
          class="btn-primary inline-block rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-surface no-underline hover:opacity-90"
        >
          See services
        </a>
        <a
          href="/contact/"
          class="btn-secondary inline-block rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-text no-underline hover:border-accent hover:text-accent"
        >
          Book a free call
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider mx-auto max-w-6xl"></div>

  {/* Recent posts */}
  {
    recentPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        <ScrollReveal>
          <div class="mb-8 flex items-baseline justify-between">
            <h2 class="text-text">Recent Writing</h2>
            <a href="/blog/" class="text-sm text-text-muted transition-colors hover:text-accent">
              All posts &rarr;
            </a>
          </div>
        </ScrollReveal>
        <div class="space-y-6">
          {recentPosts.map((post) => (
            <ScrollReveal>
              <a
                href={`/blog/${slug(post.id)}/`}
                class="card-hover hover:border-accent/50 group block rounded-xl border border-border bg-surface-alt p-6 no-underline shadow-subtle transition-all hover:shadow-card"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-semibold text-text transition-colors group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-text-muted">{post.data.description}</p>
                  </div>
                  <time class="whitespace-nowrap text-xs text-text-muted" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
