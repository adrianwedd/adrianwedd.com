---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { slug } from '../../lib/utils';

export async function getStaticPaths() {
  const fixes = await getCollection('fixes');
  return fixes
    .filter((fix) => !fix.data.draft)
    .map((fix) => ({
      params: { slug: slug(fix.id) },
      props: { fix },
    }));
}

const { fix } = Astro.props;
const { Content } = await render(fix);
const fixSlug = slug(fix.id);
const ogImage = `/og/fixes/${fixSlug}.png`;
---

<BaseLayout title={fix.data.title} description={fix.data.description} image={ogImage} type="article" publishedDate={fix.data.date.toISOString()} tags={fix.data.tags}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: fix.data.title,
      description: fix.data.description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      image: new URL(ogImage, Astro.site).href,
      datePublished: fix.data.date.toISOString(),
      keywords: fix.data.tags,
      author: {
        '@type': 'Person',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Adrian Wedd',
        url: 'https://adrianwedd.com',
        logo: { '@type': 'ImageObject', url: 'https://adrianwedd.com/favicon.svg' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, Astro.site).href },
    })}
  />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Tune-ups', href: '/fixes/' }, { label: fix.data.title }]} />
    <p class="text-sm font-medium text-accent">{fix.data.category} tune-up</p>
    <h1 class="mt-2 text-text">{fix.data.title}</h1>
    <div class="prose prose-headings:mb-4 prose-headings:mt-8 prose-headings:font-semibold prose-headings:text-text prose-p:mb-4 prose-p:leading-relaxed prose-p:text-text prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:my-4 prose-blockquote:border-accent prose-blockquote:text-text-muted prose-strong:text-text prose-code:text-text prose-pre:border prose-pre:border-border prose-pre:bg-surface-alt prose-ol:my-4 prose-ul:my-4 prose-li:text-text mt-8 max-w-none">
      <Content />
    </div>
    <div class="mt-12">
      <a href="/local/" class="text-accent hover:underline">See the local services &rarr;</a>
    </div>
  </article>
</BaseLayout>
