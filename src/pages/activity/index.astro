---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GitHubActivity from '../../components/islands/GitHubActivity';
---

<BaseLayout
  title="Activity"
  description="Live development activity — commits, pull requests, and issues across all repositories."
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Activity' }]} />

    <h1 class="text-text">Activity</h1>
    <p class="mt-2 text-sm text-text-muted">
      Live from GitHub. Commits, pull requests, issues, and repository activity across all public repos.
    </p>

    <div class="mt-10">
      <GitHubActivity client:load />
    </div>

    <nav class="mt-16 border-t border-border pt-8" aria-label="Related pages">
      <div class="flex gap-6">
        <a href="/now/" class="text-sm text-text-muted transition-colors hover:text-accent">&larr; Now</a>
        <a href="/projects/" class="text-sm text-text-muted transition-colors hover:text-accent">Projects &rarr;</a>
      </div>
    </nav>
  </section>
</BaseLayout>
