---
/**
 * ContentCarousel — dynamic image carousel for content collections.
 * Renders all items with heroImage as slides (image left, text right).
 *
 * Props:
 *   items: { href: string; title: string; description: string; heroImage: string; date: Date; tags?: string[] }[]
 *   id: string — unique carousel ID (must be unique per page)
 *   label: string — aria-label for the section
 */
import { Picture } from 'astro:assets';

interface CarouselItem {
  href: string;
  title: string;
  description: string;
  heroImage: string;
  date: Date;
  tags?: string[];
}

interface Props {
  items: CarouselItem[];
  id: string;
  label: string;
}

const { items, id, label } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mx-auto max-w-4xl px-4 pb-12 sm:px-6 lg:px-8" aria-label={label}>
      <div
        class="content-carousel border-border bg-surface-alt shadow-subtle relative overflow-hidden rounded-xl border"
        data-carousel={id}
      >
        <div class="cc-track flex transition-transform duration-500 ease-in-out">
          {items.map((item, i) => (
            <div class="cc-slide w-full flex-shrink-0">
              <a href={item.href} class="group block no-underline sm:flex sm:items-stretch">
                <div class="aspect-[16/9] overflow-hidden sm:aspect-[4/3] sm:w-1/2">
                  <Picture
                    src={item.heroImage}
                    width={600}
                    height={400}
                    formats={['webp']}
                    alt={item.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                <div class="flex flex-col justify-center p-5 sm:w-1/2 sm:p-6">
                  <h3 class="text-text group-hover:text-accent text-lg font-semibold transition-colors sm:text-xl">
                    {item.title}
                  </h3>
                  <p class="text-text-muted mt-2 line-clamp-3 text-sm leading-relaxed">{item.description}</p>
                  {item.tags && item.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1">
                      {item.tags.slice(0, 3).map((tag: string) => (
                        <span class="bg-surface-raised text-text-muted rounded-full px-2.5 py-0.5 text-xs">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="text-accent mt-3 inline-flex items-center gap-1 text-sm font-medium">
                    Read
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </span>
                </div>
              </a>
            </div>
          ))}
        </div>

        <div class="cc-live sr-only" aria-live="polite" aria-atomic="true">
          Slide 1 of {items.length}
        </div>

        {items.length > 1 && (
          <>
            <div class="flex items-center justify-center gap-1.5 py-3">
              {items.map((_, i) => (
                <button
                  type="button"
                  class:list={[
                    'cc-dot rounded-full transition-all',
                    i === 0 ? 'bg-accent h-2 w-5' : 'hover:bg-accent/50 bg-border h-2 w-2',
                  ]}
                  data-slide={i}
                  aria-label={`Slide ${i + 1}: ${items[i].title}`}
                  {...(i === 0 ? { 'aria-current': 'true' } : {})}
                />
              ))}
            </div>

            <button
              type="button"
              class="cc-prev bg-surface/80 border-border text-text-muted hover:border-accent hover:text-accent absolute top-1/2 left-2 -translate-y-1/2 rounded-full border p-1.5 backdrop-blur-sm transition-colors"
              aria-label="Previous slide"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              type="button"
              class="cc-next bg-surface/80 border-border text-text-muted hover:border-accent hover:text-accent absolute top-1/2 right-2 -translate-y-1/2 rounded-full border p-1.5 backdrop-blur-sm transition-colors"
              aria-label="Next slide"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>
    </section>
  )
}

<script is:inline>
  (function () {
    if (document.documentElement.dataset.ccInit) return;
    document.documentElement.dataset.ccInit = '1';

    var carousels = {};

    function getState(el) {
      var key = el.dataset.carousel;
      if (!carousels[key]) carousels[key] = { current: 0, autoplay: null };
      return carousels[key];
    }

    function go(el, n) {
      var state = getState(el);
      var slides = el.querySelectorAll('.cc-slide');
      var total = slides.length;
      if (!total) return;
      state.current = ((n % total) + total) % total;
      var track = el.querySelector('.cc-track');
      if (track) track.style.transform = 'translateX(-' + state.current * 100 + '%)';
      el.querySelectorAll('.cc-dot').forEach(function (dot) {
        var active = Number(dot.dataset.slide) === state.current;
        dot.classList.toggle('bg-accent', active);
        dot.classList.toggle('w-5', active);
        dot.classList.toggle('bg-border', !active);
        dot.classList.toggle('w-2', !active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      var live = el.querySelector('.cc-live');
      if (live) live.textContent = 'Slide ' + (state.current + 1) + ' of ' + total;
    }

    function startAutoplay(el) {
      stopAutoplay(el);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var state = getState(el);
      state.autoplay = setInterval(function () {
        go(el, state.current + 1);
      }, 6000);
    }

    function stopAutoplay(el) {
      var state = getState(el);
      if (state.autoplay) {
        clearInterval(state.autoplay);
        state.autoplay = null;
      }
    }

    function initAll() {
      document.querySelectorAll('[data-carousel]').forEach(function (el) {
        var state = getState(el);
        stopAutoplay(el);
        state.current = 0;
        go(el, 0);
        startAutoplay(el);
      });
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || typeof t.closest !== 'function') return;

      var prev = t.closest('.cc-prev');
      if (prev) {
        var carousel = prev.closest('[data-carousel]');
        if (carousel) {
          stopAutoplay(carousel);
          go(carousel, getState(carousel).current - 1);
          startAutoplay(carousel);
        }
        return;
      }

      var next = t.closest('.cc-next');
      if (next) {
        var carousel = next.closest('[data-carousel]');
        if (carousel) {
          stopAutoplay(carousel);
          go(carousel, getState(carousel).current + 1);
          startAutoplay(carousel);
        }
        return;
      }

      var dot = t.closest('.cc-dot');
      if (dot) {
        var carousel = dot.closest('[data-carousel]');
        if (carousel && dot.dataset.slide !== undefined) {
          stopAutoplay(carousel);
          go(carousel, Number(dot.dataset.slide));
          startAutoplay(carousel);
        }
      }
    });

    document.addEventListener(
      'mouseenter',
      function (e) {
        if (e.target && e.target.closest && e.target.closest('[data-carousel]'))
          stopAutoplay(e.target.closest('[data-carousel]'));
      },
      true,
    );
    document.addEventListener(
      'mouseleave',
      function (e) {
        if (e.target && e.target.closest && e.target.closest('[data-carousel]'))
          startAutoplay(e.target.closest('[data-carousel]'));
      },
      true,
    );

    var touchX = 0;
    document.addEventListener(
      'touchstart',
      function (e) {
        var c = e.target.closest && e.target.closest('[data-carousel]');
        if (c) touchX = e.touches[0].clientX;
      },
      { passive: true },
    );
    document.addEventListener('touchend', function (e) {
      var c = e.target.closest && e.target.closest('[data-carousel]');
      if (!c) return;
      var d = touchX - e.changedTouches[0].clientX;
      if (Math.abs(d) > 50) {
        stopAutoplay(c);
        go(c, getState(c).current + (d > 0 ? 1 : -1));
        startAutoplay(c);
      }
    });

    document.addEventListener('astro:after-swap', function () {
      carousels = {};
      initAll();
    });

    initAll();
  })();
</script>
