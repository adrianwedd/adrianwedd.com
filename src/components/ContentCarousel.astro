---
/**
 * ContentCarousel — dynamic image carousel for content collections.
 * Renders all items with heroImage as slides (image left, text right).
 * Reuses the same carousel pattern as the homepage hero.
 *
 * Props:
 *   items: { href: string; title: string; description: string; heroImage: string; date: Date; tags?: string[] }[]
 *   id: string — unique carousel ID (must be unique per page)
 *   label: string — aria-label for the section
 */
import { Picture } from 'astro:assets';

interface CarouselItem {
  href: string;
  title: string;
  description: string;
  heroImage: string;
  date: Date;
  tags?: string[];
}

interface Props {
  items: CarouselItem[];
  id: string;
  label: string;
}

const { items, id, label } = Astro.props;
const trackId = `${id}-track`;
const liveId = `${id}-live`;
const prevId = `${id}-prev`;
const nextId = `${id}-next`;
---

{items.length > 0 && (
  <section class="mx-auto max-w-4xl px-4 pb-12 sm:px-6 lg:px-8" aria-label={label}>
    <div id={id} class="content-carousel relative overflow-hidden rounded-xl border border-border bg-surface-alt shadow-subtle">
      <div id={trackId} class="carousel-track flex transition-transform duration-500 ease-in-out">
        {items.map((item, i) => (
          <div class="carousel-slide w-full flex-shrink-0">
            <a href={item.href} class="group block no-underline sm:flex sm:items-stretch">
              <div class="aspect-[16/9] overflow-hidden sm:aspect-auto sm:w-1/2">
                <Picture
                  src={item.heroImage}
                  width={600}
                  height={400}
                  formats={['webp']}
                  alt={item.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="flex flex-col justify-center p-5 sm:w-1/2 sm:p-6">
                <h3 class="text-lg font-semibold text-text transition-colors group-hover:text-accent sm:text-xl">
                  {item.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-text-muted">{item.description}</p>
                {item.tags && item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1">
                    {item.tags.slice(0, 3).map((tag: string) => (
                      <span class="rounded-full border border-border px-2 py-0.5 text-xs text-text-muted">{tag}</span>
                    ))}
                  </div>
                )}
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent">
                  Read
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                </span>
              </div>
            </a>
          </div>
        ))}
      </div>

      <div id={liveId} class="sr-only" aria-live="polite" aria-atomic="true">Slide 1 of {items.length}</div>

      {items.length > 1 && (
        <>
          <div class="flex items-center justify-center gap-1.5 py-3">
            {items.map((_, i) => (
              <button
                type="button"
                class:list={[
                  'carousel-dot rounded-full transition-all',
                  i === 0 ? 'h-2 w-5 bg-accent' : 'h-2 w-2 bg-border hover:bg-accent/50',
                ]}
                data-slide={i}
                aria-label={`Slide ${i + 1}: ${items[i].title}`}
                {...(i === 0 ? { 'aria-current': 'true' } : {})}
              />
            ))}
          </div>

          <button type="button" id={prevId} class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 p-1.5 text-text-muted backdrop-blur-sm transition-colors hover:border-accent hover:text-accent" aria-label="Previous slide">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" id={nextId} class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 rounded-full border border-border bg-surface/80 p-1.5 text-text-muted backdrop-blur-sm transition-colors hover:border-accent hover:text-accent" aria-label="Next slide">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </>
      )}
    </div>
  </section>
)}

<script is:inline define:vars={{ id, trackId, liveId, prevId, nextId }}>
(function () {
  var current = 0;
  var total = 0;
  var autoplay = null;
  var sentinel = id + 'Init';

  function go(n) {
    total = document.querySelectorAll('#' + id + ' .carousel-slide').length;
    if (!total) return;
    current = ((n % total) + total) % total;
    var track = document.getElementById(trackId);
    if (track) track.style.transform = 'translateX(-' + (current * 100) + '%)';
    document.querySelectorAll('#' + id + ' .carousel-dot').forEach(function (dot) {
      var active = Number(dot.dataset.slide) === current;
      dot.classList.toggle('bg-accent', active);
      dot.classList.toggle('w-5', active);
      dot.classList.toggle('bg-border', !active);
      dot.classList.toggle('w-2', !active);
      if (active) dot.setAttribute('aria-current', 'true');
      else dot.removeAttribute('aria-current');
    });
    var live = document.getElementById(liveId);
    if (live) live.textContent = 'Slide ' + (current + 1) + ' of ' + total;
  }

  function start() { stop(); if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) autoplay = setInterval(function () { go(current + 1); }, 6000); }
  function stop() { if (autoplay) { clearInterval(autoplay); autoplay = null; } }

  function init() {
    stop();
    if (!document.getElementById(id)) return;
    total = document.querySelectorAll('#' + id + ' .carousel-slide').length;
    current = 0;
    go(0);
    start();
  }

  if (!document.documentElement.dataset[sentinel]) {
    document.documentElement.dataset[sentinel] = '1';

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || typeof t.closest !== 'function') return;
      if (t.closest('#' + prevId)) { stop(); go(current - 1); start(); return; }
      if (t.closest('#' + nextId)) { stop(); go(current + 1); start(); return; }
      var dot = t.closest('#' + id + ' .carousel-dot');
      if (dot && dot.dataset.slide !== undefined) { stop(); go(Number(dot.dataset.slide)); start(); }
    });

    document.addEventListener('mouseenter', function (e) { if (e.target && e.target.id === id) stop(); }, true);
    document.addEventListener('mouseleave', function (e) { if (e.target && e.target.id === id) start(); }, true);

    var touchX = 0;
    document.addEventListener('touchstart', function (e) { var c = e.target.closest && e.target.closest('#' + id); if (c) touchX = e.touches[0].clientX; }, { passive: true });
    document.addEventListener('touchend', function (e) { var c = e.target.closest && e.target.closest('#' + id); if (!c) return; var d = touchX - e.changedTouches[0].clientX; if (Math.abs(d) > 50) { stop(); go(current + (d > 0 ? 1 : -1)); start(); } });

    document.addEventListener('astro:after-swap', init);
  }

  init();
})();
</script>
