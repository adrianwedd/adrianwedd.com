---
/**
 * Shared outbound CTA for a project, used by both the project detail page and
 * blog posts that resolve to a project.
 *
 * The external site is always the primary action — the real thing outranks our
 * page about the thing. `repo` is secondary. `projectHref` is a tertiary link
 * back to our own project page and is only passed from the blog template, where
 * the project page is genuinely elsewhere; on the project page itself it would
 * link to the current URL.
 *
 * Extracted from the hand-rolled block in projects/[...slug].astro so blog and
 * project pages stop diverging: before this, the same `url` field rendered as an
 * accent button on a project page and as 12px muted text in the blog metabar.
 */
interface Props {
  url?: string;
  repo?: string;
  projectHref?: string;
  projectLabel?: string;
  class?: string;
}

const { url, repo, projectHref, projectLabel = 'Project page', class: className = '' } = Astro.props;

const repoHref = repo ? (repo.startsWith('http') ? repo : `https://github.com/adrianwedd/${repo}`) : undefined;
---

{
  (url || repoHref || projectHref) && (
    <div class={`mt-10 flex flex-wrap gap-3 ${className}`.trim()}>
      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary bg-accent text-surface shadow-subtle hover:bg-accent-hover hover:shadow-card inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium no-underline"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
            />
          </svg>
          Visit project
        </a>
      )}
      {repoHref && (
        <a
          href={repoHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary border-border text-text-muted shadow-subtle hover:border-accent hover:text-accent hover:shadow-card inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium no-underline"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          View source
        </a>
      )}
      {projectHref && (
        <a
          href={projectHref}
          class="btn-secondary border-border text-text-muted hover:border-accent hover:text-accent inline-flex items-center gap-2 rounded-lg border px-5 py-2.5 text-sm font-medium no-underline"
        >
          {projectLabel}
        </a>
      )}
    </div>
  )
}
