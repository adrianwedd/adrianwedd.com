---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-alt/50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 text-sm text-text-muted sm:grid-cols-3">
      <nav aria-label="Site pages">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-text">Site</p>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="/projects/" class="transition-colors hover:text-text">Projects</a>
          <a href="/blog/" class="transition-colors hover:text-text">Blog</a>
          <a href="/gallery/" class="transition-colors hover:text-text">Gallery</a>
          <a href="/audio/" class="transition-colors hover:text-text">Audio</a>
          <a href="/new/" class="transition-colors hover:text-text">What's New</a>
          <a href="/activity/" class="transition-colors hover:text-text">Activity</a>
          <a href="/services/" class="transition-colors hover:text-text">Services</a>
          <a href="/search/" class="transition-colors hover:text-text">Search</a>
        </div>
      </nav>
      <nav aria-label="About and meta">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-text">Meta</p>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="/about/" class="transition-colors hover:text-text">About</a>
          <a href="/now/" class="transition-colors hover:text-text">Now</a>
          <a href="/contact/" class="transition-colors hover:text-text">Contact</a>
          <a href="/colophon/" class="transition-colors hover:text-text">Colophon</a>
          <a href="/analytics/" class="transition-colors hover:text-text">Analytics</a>
        </div>
      </nav>
      <nav aria-label="External links">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-text">Elsewhere</p>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="https://github.com/adrianwedd" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">GitHub</a>
          <a href="https://linkedin.com/in/adrianwedd" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">LinkedIn</a>
          <a href="https://www.facebook.com/AdrianWeddDotCom" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">Facebook</a>
          <a href="/rss.xml" class="transition-colors hover:text-text">RSS</a>
          <a href="/audio/feed.xml" class="transition-colors hover:text-text">Podcast</a>
        </div>
      </nav>
    </div>
    <p class="mt-8 border-t border-border pt-6 text-xs text-text-muted">
      The methodology is public. The work is in progress. Do it properly or don't bother.
    </p>
    <div class="mt-4 flex items-center justify-between text-xs text-text-muted font-mono tracking-wide">
      <p>&copy; {year} Adrian Wedd</p>
      <button
        type="button"
        class="footer-back-to-top transition-colors hover:text-accent"
        aria-label="Back to top"
      >
        Back to top &uarr;
      </button>
    </div>
  </div>
</footer>
<script is:inline>
  (function () {
    if (!document.documentElement.dataset.footerTopInit) {
      document.documentElement.dataset.footerTopInit = '1';
      document.addEventListener('click', function (e) {
        if (e.target.closest('.footer-back-to-top')) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }
  })();
</script>
