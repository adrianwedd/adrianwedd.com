---
// Minimal consent banner — single line, unobtrusive.
// No tracking before consent. Respects Do Not Track.
// "Manage" expands granular options inline.
---

<div
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-[100] hidden"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="bg-surface/95 border-t border-border shadow-card backdrop-blur-sm">
    <!-- Compact bar -->
    <div id="consent-compact" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <p class="text-xs text-text-muted">
        This site uses cookies for analytics (Google Analytics, LinkedIn Insight), advertising (Google AdSense), and personalisation (visit count,
        stored locally). No tracking before consent. <a
          href="/privacy/"
          class="underline transition-colors hover:text-accent">Full privacy details</a
        >
      </p>
      <div class="flex shrink-0 items-center gap-2">
        <button
          id="consent-manage"
          type="button"
          class="text-xs text-text-muted transition-colors hover:text-text"
          aria-expanded="false"
          aria-controls="consent-expanded"
        >
          Manage
        </button>
        <button id="consent-reject" type="button" class="text-xs text-text-muted transition-colors hover:text-text">
          Decline
        </button>
        <button
          id="consent-accept-all"
          type="button"
          class="rounded-md bg-accent px-3 py-1 text-xs font-medium text-surface transition-colors hover:bg-accent-hover"
        >
          OK
        </button>
      </div>
    </div>

    <!-- Expanded options (hidden by default) -->
    <div id="consent-expanded" class="mx-auto hidden max-w-6xl px-4 pb-3">
      <p class="mb-3 max-w-2xl text-xs text-text-muted">
        <strong class="text-text">Analytics:</strong> Google Analytics 4 tracks aggregate traffic—what gets read, where readers
        come from. No individual session reconstruction.
        <strong class="ml-3 text-text">Personalisation:</strong> Visit counter stored in your browser's localStorage. Never
        leaves your device.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="consent-analytics" class="h-3.5 w-3.5 accent-accent" />
          <span class="text-text-muted">Analytics</span>
        </label>
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="consent-personalisation" class="h-3.5 w-3.5 accent-accent" />
          <span class="text-text-muted">Personalisation</span>
        </label>
        <button
          id="consent-accept-selected"
          type="button"
          class="rounded-md border border-border px-3 py-1 text-xs text-text-muted transition-colors hover:border-accent hover:text-accent"
        >
          Save
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var CONSENT_KEY = 'adrianwedd_consent';

    function getConsent() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function setConsent(state) {
      localStorage.setItem(CONSENT_KEY, JSON.stringify(state));
      document.cookie =
        'consent=' +
        (state.analytics ? 'a' : '') +
        (state.personalisation ? 'p' : '') +
        '; path=/; max-age=31536000; SameSite=Lax';
      window.dispatchEvent(new CustomEvent('consent-updated', { detail: state }));
    }

    function save(analytics, personalisation) {
      setConsent({ analytics: analytics, personalisation: personalisation, timestamp: Date.now() });
      var banner = document.getElementById('consent-banner');
      if (banner) banner.classList.add('hidden');
    }

    function initConsent() {
      var banner = document.getElementById('consent-banner');
      if (!banner) return;

      var existing = getConsent();
      if (!existing) {
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1') {
          save(false, false);
        } else {
          banner.classList.remove('hidden');
        }
      }
    }

    // Event delegation — survives DOM swaps
    var root = document.documentElement;
    if (!root.dataset.consentInit) {
      root.dataset.consentInit = '1';
      document.addEventListener('click', function (e) {
        var target = e.target.closest ? e.target.closest('[id]') : null;
        if (!target) return;
        var id = target.id;
        if (id === 'consent-accept-all') {
          save(true, true);
        } else if (id === 'consent-reject') {
          save(false, false);
        } else if (id === 'consent-manage') {
          var expanded = document.getElementById('consent-expanded');
          if (expanded) {
            expanded.classList.toggle('hidden');
            target.setAttribute('aria-expanded', String(!expanded.classList.contains('hidden')));
          }
        } else if (id === 'consent-accept-selected') {
          var analytics = document.getElementById('consent-analytics');
          var personalisation = document.getElementById('consent-personalisation');
          save(analytics ? analytics.checked : false, personalisation ? personalisation.checked : false);
        }
      });
    }

    initConsent();
    if (!document.documentElement.dataset.consentSwapInit) {
      document.documentElement.dataset.consentSwapInit = '1';
      document.addEventListener('astro:after-swap', initConsent);
    }
  })();
</script>
