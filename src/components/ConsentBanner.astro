---
// Minimal consent banner — single line, unobtrusive.
// No tracking before consent. Respects Do Not Track.
// "Manage" expands granular options inline.
---

<div
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-[100] hidden"
  role="region"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="bg-surface/95 border-border shadow-card border-t backdrop-blur-sm">
    <!-- Compact bar -->
    <div id="consent-compact" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <p class="text-text-muted text-xs">
        This site uses cookies for analytics (Google Analytics), advertising (Google AdSense, LinkedIn Insight), and
        personalisation (visit count, stored locally). No tracking before consent. <a
          href="/privacy/"
          class="hover:text-accent underline transition-colors">Full privacy details</a
        >
      </p>
      <div class="flex shrink-0 items-center gap-2">
        <button
          id="consent-manage"
          type="button"
          class="text-text-muted hover:text-text min-h-11 px-2 text-xs transition-colors"
          aria-expanded="false"
          aria-controls="consent-expanded"
        >
          Manage
        </button>
        <button
          id="consent-reject"
          type="button"
          class="text-text-muted hover:text-text min-h-11 px-2 text-xs transition-colors"
        >
          Decline
        </button>
        <button
          id="consent-accept-all"
          type="button"
          class="bg-accent text-surface hover:bg-accent-hover min-h-11 rounded-md px-4 text-xs font-medium transition-colors"
        >
          OK
        </button>
      </div>
    </div>

    <!-- Expanded options (hidden by default) -->
    <div id="consent-expanded" class="mx-auto hidden max-w-6xl px-4 pb-3">
      <p class="text-text-muted mb-3 max-w-2xl text-xs">
        <strong class="text-text">Analytics:</strong> Google Analytics 4 tracks aggregate traffic—what gets read, where readers
        come from. No individual session reconstruction.
        <strong class="text-text ml-3">Advertising:</strong> Loads Google AdSense and the LinkedIn Insight Tag—both set third-party
        cookies used for ads and ad measurement.
        <strong class="text-text ml-3">Personalisation:</strong> Visit counter stored in your browser's localStorage. Never
        leaves your device.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="consent-analytics" class="accent-accent h-3.5 w-3.5" />
          <span class="text-text-muted">Analytics</span>
        </label>
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="consent-advertising" class="accent-accent h-3.5 w-3.5" />
          <span class="text-text-muted">Advertising</span>
        </label>
        <label class="flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="consent-personalisation" class="accent-accent h-3.5 w-3.5" />
          <span class="text-text-muted">Personalisation</span>
        </label>
        <button
          id="consent-accept-selected"
          type="button"
          class="border-border text-text-muted hover:border-accent hover:text-accent min-h-11 rounded-md border px-4 text-xs transition-colors"
        >
          Save
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var CONSENT_KEY = 'adrianwedd_consent';

    function getConsent() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function setConsent(state) {
      localStorage.setItem(CONSENT_KEY, JSON.stringify(state));
      document.cookie =
        'consent=' +
        (state.analytics ? 'a' : '') +
        (state.advertising ? 'd' : '') +
        (state.personalisation ? 'p' : '') +
        '; path=/; max-age=31536000; SameSite=Lax';
      window.dispatchEvent(new CustomEvent('consent-updated', { detail: state }));
    }

    function save(analytics, advertising, personalisation) {
      setConsent({
        analytics: analytics,
        advertising: advertising,
        personalisation: personalisation,
        timestamp: Date.now(),
      });
      var banner = document.getElementById('consent-banner');
      if (banner) banner.classList.add('hidden');
    }

    function initConsent() {
      var banner = document.getElementById('consent-banner');
      if (!banner) return;

      var existing = getConsent();
      if (!existing) {
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1') {
          save(false, false, false);
        } else {
          banner.classList.remove('hidden');
        }
      }
    }

    // Event delegation — survives DOM swaps
    var root = document.documentElement;
    if (!root.dataset.consentInit) {
      root.dataset.consentInit = '1';
      document.addEventListener('click', function (e) {
        var target = e.target.closest ? e.target.closest('[id]') : null;
        if (!target) return;
        var id = target.id;
        if (id === 'consent-accept-all') {
          save(true, true, true);
        } else if (id === 'consent-reject') {
          save(false, false, false);
        } else if (id === 'consent-manage') {
          var expanded = document.getElementById('consent-expanded');
          if (expanded) {
            expanded.classList.toggle('hidden');
            target.setAttribute('aria-expanded', String(!expanded.classList.contains('hidden')));
          }
        } else if (id === 'consent-accept-selected') {
          var analytics = document.getElementById('consent-analytics');
          var advertising = document.getElementById('consent-advertising');
          var personalisation = document.getElementById('consent-personalisation');
          save(
            analytics ? analytics.checked : false,
            advertising ? advertising.checked : false,
            personalisation ? personalisation.checked : false,
          );
        }
      });
    }

    initConsent();
    if (!document.documentElement.dataset.consentSwapInit) {
      document.documentElement.dataset.consentSwapInit = '1';
      document.addEventListener('astro:after-swap', initConsent);
    }
  })();
</script>
