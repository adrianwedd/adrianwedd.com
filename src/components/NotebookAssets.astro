---
import { Picture } from 'astro:assets';
import MindMap from './islands/MindMap.tsx';
import Quiz from './islands/Quiz.tsx';
import Flashcards from './islands/Flashcards.tsx';
import DataTable from './islands/DataTable.tsx';

interface Props {
  videoUrl?: string;
  infographic?: string;
  mindmap?: string;
  quiz?: string;
  flashcards?: string;
  dataTable?: string;
  slides?: string;
  title?: string;
}

const { videoUrl, infographic, mindmap, quiz, flashcards, dataTable, slides, title = 'Notebook asset' } = Astro.props;

const hasAssets = videoUrl || infographic || mindmap || quiz || flashcards || dataTable || slides;
---

{
  hasAssets && (
    <section class="border-border mt-12 space-y-8 border-t pt-8" aria-label="Notebook assets">
      <h2 class="text-text text-lg font-semibold">Explore</h2>

      {videoUrl && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Video summary</h3>
          <video
            controls
            preload="metadata"
            class="border-border bg-surface-alt w-full rounded-lg border"
            aria-label={`Video overview of ${title}`}
          >
            <source src={videoUrl} type="video/mp4" />
          </video>
        </div>
      )}

      {infographic && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Infographic</h3>
          <a href={infographic} target="_blank" rel="noopener noreferrer" class="block">
            <Picture
              src={infographic}
              width={768}
              height={1376}
              widths={[384, 768, 1152]}
              formats={['avif', 'webp']}
              alt={`Infographic for ${title}`}
              class="hover:border-accent/50 border-border w-full cursor-zoom-in rounded-lg border transition-colors"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      )}

      {mindmap && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Mind map</h3>
          <MindMap src={mindmap} client:idle />
        </div>
      )}

      {quiz && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Quiz</h3>
          <Quiz src={quiz} client:idle />
        </div>
      )}

      {flashcards && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Flashcards</h3>
          <Flashcards src={flashcards} client:idle />
        </div>
      )}

      {dataTable && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Data</h3>
          <DataTable src={dataTable} client:idle />
        </div>
      )}

      {slides && (
        <div>
          <h3 class="text-text-muted mb-3 text-sm font-medium">Slides</h3>
          <a
            href={slides}
            download
            class="hover:border-accent/50 border-border text-text-muted hover:text-accent inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm no-underline transition-colors"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
            Download slide deck (PDF)
          </a>
        </div>
      )}
    </section>
  )
}
