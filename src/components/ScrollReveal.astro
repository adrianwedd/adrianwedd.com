---
interface Props {
  class?: string;
  as?: string;
  stagger?: number;
}

const { class: className = '', as: Tag = 'div', stagger } = Astro.props as any;
---

<Tag class:list={['scroll-reveal', className]} {...stagger ? { style: `transition-delay: ${stagger}ms` } : {}}>
  <slot />
</Tag>

<script is:inline>
  (function () {
    var observer;

    function initScrollReveal() {
      if (observer) observer.disconnect();
      observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.scroll-reveal:not(.revealed)').forEach(function (el) {
        observer.observe(el);
      });
    }

    initScrollReveal();
    var root = document.documentElement;
    if (!root.dataset.scrollRevealInit) {
      root.dataset.scrollRevealInit = '1';
      document.addEventListener('astro:after-swap', initScrollReveal);
    }
  })();
</script>
