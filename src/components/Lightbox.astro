---
import { getImageDimensions } from '../lib/image-dimensions';

interface Props {
  images: Array<{ src: string; alt: string; caption?: string }>;
}

const { images } = Astro.props;

// Read intrinsic dimensions at build time so the lightbox can reserve a
// correctly-shaped box before the full-res bytes arrive — prevents the
// in-modal layout jump (CLS) when each image loads. (#472 E3)
const imagesWithDims = images.map((img) => {
  const dims = img.src.startsWith('/') ? getImageDimensions(img.src) : null;
  return { ...img, w: dims?.width ?? null, h: dims?.height ?? null };
});
---

<div
  id="lightbox"
  class="bg-surface/95 fixed inset-0 z-[200] hidden backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  data-images={JSON.stringify(imagesWithDims)}
>
  <div class="flex h-full items-center justify-center p-4 sm:p-8">
    <button
      id="lightbox-close"
      type="button"
      class="text-text-muted hover:bg-surface-alt hover:text-text absolute top-4 right-4 z-10 rounded-lg p-2 transition-colors"
      aria-label="Close lightbox"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button
      id="lightbox-prev"
      type="button"
      class="text-text-muted hover:bg-surface-alt hover:text-text absolute top-1/2 left-4 z-10 -translate-y-1/2 rounded-lg p-2 transition-colors"
      aria-label="Previous image"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      id="lightbox-next"
      type="button"
      class="text-text-muted hover:bg-surface-alt hover:text-text absolute top-1/2 right-4 z-10 -translate-y-1/2 rounded-lg p-2 transition-colors"
      aria-label="Next image"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <figure class="flex max-h-full max-w-full flex-col items-center">
      <img
        id="lightbox-img"
        src=""
        alt="Gallery image"
        class="max-h-[80vh] max-w-full rounded-lg object-contain"
        style="height:auto"
      />
      <figcaption id="lightbox-caption" class="text-text-muted mt-3 text-center text-sm"></figcaption>
      <a
        id="lightbox-detail"
        href="#"
        class="text-text-muted hover:text-accent mt-2 text-xs no-underline transition-colors">View details &rarr;</a
      >
    </figure>
  </div>
</div>

<script is:inline>
  (function () {
    // Read images from data attribute — re-reads on each VT swap
    var lightboxEl = document.getElementById('lightbox');
    if (!lightboxEl) return;
    var images = JSON.parse(lightboxEl.dataset.images || '[]');
    window.__lightboxImages = images;
    var currentIndex = 0;
    var triggerElement = null;

    function getLightbox() {
      return document.getElementById('lightbox');
    }
    function getImg() {
      return document.getElementById('lightbox-img');
    }
    function getCaption() {
      return document.getElementById('lightbox-caption');
    }
    function getCloseBtn() {
      return document.getElementById('lightbox-close');
    }
    function getPrevBtn() {
      return document.getElementById('lightbox-prev');
    }
    function getNextBtn() {
      return document.getElementById('lightbox-next');
    }

    function show(index, trigger) {
      currentIndex = index;
      triggerElement = trigger || document.activeElement;
      var image = window.__lightboxImages[index];
      var img = getImg();
      var caption = getCaption();
      var lightbox = getLightbox();
      var closeBtn = getCloseBtn();
      if (img) {
        // Set intrinsic dimensions before the src so the browser reserves a
        // correctly-shaped box and the image doesn't jump on load (CLS).
        if (image.w && image.h) {
          img.width = image.w;
          img.height = image.h;
          img.style.aspectRatio = image.w + ' / ' + image.h;
        } else {
          img.removeAttribute('width');
          img.removeAttribute('height');
          img.style.aspectRatio = '';
        }
        img.src = image.src;
        img.alt = image.alt;
      }
      if (caption) {
        caption.textContent = image.caption || '';
      }
      var detailLink = document.getElementById('lightbox-detail');
      if (detailLink && window.__lightboxHrefs && window.__lightboxHrefs[index]) {
        detailLink.href = window.__lightboxHrefs[index];
      }
      if (lightbox) {
        lightbox.classList.remove('hidden');
      }
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function hide() {
      var lightbox = getLightbox();
      if (lightbox) lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      if (triggerElement && triggerElement.focus) triggerElement.focus();
      triggerElement = null;
    }

    function prev() {
      show((currentIndex - 1 + window.__lightboxImages.length) % window.__lightboxImages.length);
    }
    function next() {
      show((currentIndex + 1) % window.__lightboxImages.length);
    }

    // Build trigger hrefs from current DOM (refreshed on each VT swap)
    window.__lightboxHrefs = [];
    document.querySelectorAll('.gallery-trigger').forEach(function (btn) {
      window.__lightboxHrefs.push(btn.getAttribute('href') || '#');
    });

    // Event delegation for all lightbox interactions — guarded to avoid accumulation
    var root = document.documentElement;
    if (!root.dataset.lightboxInit) {
      root.dataset.lightboxInit = '1';

      document.addEventListener('click', function (e) {
        // Gallery trigger clicks (delegated — works after VT swap)
        var trigger = e.target.closest ? e.target.closest('.gallery-trigger') : null;
        if (trigger) {
          e.preventDefault();
          show(parseInt(trigger.dataset.index), trigger);
          return;
        }
        var target = e.target.closest ? e.target.closest('[id]') : null;
        if (!target) return;
        if (target.id === 'lightbox-close') {
          hide();
          return;
        }
        if (target.id === 'lightbox-prev') {
          prev();
          return;
        }
        if (target.id === 'lightbox-next') {
          next();
          return;
        }
        // Backdrop click
        var lightbox = getLightbox();
        if (lightbox && (e.target === lightbox || e.target.parentElement === lightbox)) hide();
      });

      document.addEventListener('keydown', function (e) {
        var lightbox = getLightbox();
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') {
          hide();
          return;
        }
        if (e.key === 'ArrowLeft') {
          prev();
          return;
        }
        if (e.key === 'ArrowRight') {
          next();
          return;
        }
        if (e.key === 'Tab') {
          var focusable = [
            getCloseBtn(),
            getPrevBtn(),
            getNextBtn(),
            document.getElementById('lightbox-detail'),
          ].filter(Boolean);
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          // Focus can land outside the trap set (image click, backdrop click)
          // — pull it back in rather than letting Tab escape to the page.
          if (focusable.indexOf(document.activeElement) === -1) {
            e.preventDefault();
            (e.shiftKey ? last : first).focus();
          } else if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  })();
</script>
