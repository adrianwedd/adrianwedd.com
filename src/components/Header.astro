---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/projects/', label: 'Projects' },
  { href: '/activity/', label: 'Activity' },
  { href: '/blog/', label: 'Blog' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/audio/', label: 'Audio' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
  { href: '/search/', label: 'Search' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md" style="background: color-mix(in srgb, var(--color-surface) 80%, transparent)">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a href="/" class="text-lg font-semibold text-text no-underline transition-colors hover:text-accent">
      Adrian Wedd
    </a>

    {/* Desktop nav */}
    <div class="hidden items-center gap-1 md:flex">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            data-astro-prefetch
            class:list={[
              'rounded-lg px-3 py-2 text-sm no-underline transition-colors',
              currentPath.startsWith(href)
                ? 'bg-surface-alt font-medium text-accent'
                : 'text-text-muted hover:bg-surface-alt hover:text-text',
            ]}
            aria-current={currentPath.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>

    {/* Mobile: theme toggle + hamburger */}
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        class="mobile-menu-btn rounded-lg p-2 text-text-muted transition-colors hover:bg-surface-alt hover:text-text"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        aria-label="Open menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path class="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"
          ></path>
          <path class="menu-icon-close hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* Mobile menu */}
  <div
    id="mobile-nav-menu"
    class="mobile-menu hidden border-t border-border bg-surface md:hidden"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <div class="space-y-1 px-4 py-3">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            data-astro-prefetch
            class:list={[
              'block rounded-lg px-3 py-2 text-sm no-underline transition-colors',
              currentPath.startsWith(href)
                ? 'bg-surface-alt font-medium text-accent'
                : 'text-text-muted hover:bg-surface-alt hover:text-text',
            ]}
            aria-current={currentPath.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function initHeader() {
      var root = document.documentElement;
      if (root.dataset.headerInit) return;
      root.dataset.headerInit = '1';

      // Use event delegation on document for mobile menu — avoids
      // per-element listeners that accumulate across View Transitions
      document.addEventListener('click', function (e) {
        var btn = document.querySelector('.mobile-menu-btn');
        var menu = document.querySelector('.mobile-menu');
        var iconOpen = document.querySelector('.menu-icon-open');
        var iconClose = document.querySelector('.menu-icon-close');
        if (!btn || !menu || !iconOpen || !iconClose) return;

        // Hamburger button click
        if (e.target.closest && e.target.closest('.mobile-menu-btn')) {
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          btn.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
          menu.classList.toggle('hidden');
          iconOpen.classList.toggle('hidden');
          iconClose.classList.toggle('hidden');
          return;
        }

        // Mobile nav link click — close menu
        if (e.target.closest && e.target.closest('.mobile-menu a[href]')) {
          if (!menu.classList.contains('hidden')) {
            btn.click();
          }
        }
      });

      document.addEventListener('keydown', function (e) {
        var btn = document.querySelector('.mobile-menu-btn');
        var menu = document.querySelector('.mobile-menu');
        if (!btn || !menu) return;
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          btn.click();
          btn.focus();
          return;
        }
        if (e.key === 'Tab' && !menu.classList.contains('hidden')) {
          var focusable = menu.querySelectorAll('a[href], button');
          if (focusable.length === 0) return;
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      window.addEventListener('scroll', function () {
        var header = document.querySelector('header');
        if (header) header.classList.toggle('header-scrolled', window.scrollY > 10);
      }, { passive: true });
    }

    initHeader();
  })();
</script>
