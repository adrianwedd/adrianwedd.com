---
// GA4 integration — consent-gated, async, non-blocking.
// Only loads after user grants analytics consent.
//
// Custom events:
//   Intent: contact_intent, booking_intent, enquiry_submit, booking_complete
//   Journey: cv_view, high_intent_transition, project_outbound_click, file_download
//   Engagement: article_engaged, scroll_depth, engaged_time, audio_play, audio_progress
//   Utility: gallery_view, tag_filter, theme_switch, copy_text
//   Performance: page_timing
//
// Custom dimensions:
//   content_type, content_tags, theme, referrer_type
---

<script>
  const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
  const DEPLOYMENT_TRAFFIC_TYPE = import.meta.env.PUBLIC_ANALYTICS_TRAFFIC_TYPE || 'unclassified';
  const LI_PARTNER_ID = '8890876';
  const ATTRIBUTION_KEY = 'adrianwedd_attribution';
  const TRAFFIC_KEY = 'adrianwedd_traffic_type';
  const CAMPAIGN_FIELDS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'] as const;

  // advertising is optional: consents stored before the category existed lack it —
  // treat missing as false (no ad scripts) rather than re-prompting.
  type ConsentState = { analytics: boolean; advertising?: boolean; personalisation: boolean; timestamp: number };

  function getConsent(): ConsentState | null {
    try {
      const raw = localStorage.getItem('adrianwedd_consent');
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function gtag(...args: any[]) {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push(arguments);
  }

  type Attribution = Partial<Record<(typeof CAMPAIGN_FIELDS)[number], string>>;

  function cleanValue(value: string | null, max = 100): string {
    return (value || '')
      .replace(/[^a-zA-Z0-9._~ -]/g, '')
      .trim()
      .slice(0, max);
  }

  function safeLocation(raw: string): { domain: string; path: string } {
    try {
      const url = new URL(raw, window.location.origin);
      return { domain: url.hostname.toLowerCase(), path: url.pathname.slice(0, 200) };
    } catch {
      return { domain: 'unknown', path: '' };
    }
  }

  function captureAttribution(): Attribution {
    let stored: Attribution = {};
    try {
      stored = JSON.parse(sessionStorage.getItem(ATTRIBUTION_KEY) || '{}');
      const params = new URLSearchParams(window.location.search);
      const incoming: Attribution = {};
      for (const field of CAMPAIGN_FIELDS) {
        const value = cleanValue(params.get(field));
        if (value) incoming[field] = value;
      }
      if (Object.keys(incoming).length) {
        stored = incoming;
        sessionStorage.setItem(ATTRIBUTION_KEY, JSON.stringify(stored));
      }

      const marker = cleanValue(params.get('aw_traffic'), 30);
      if (['internal', 'ci', 'preview', 'monitor'].includes(marker)) sessionStorage.setItem(TRAFFIC_KEY, marker);
    } catch {
      // Storage may be unavailable. GA still works without custom attribution.
    }
    return stored;
  }

  function decorateCvLinks() {
    const attribution = captureAttribution();
    document
      .querySelectorAll<HTMLAnchorElement>('a[href*="cv.adrianwedd.com"], a[href*="adrianwedd.github.io/cv"]')
      .forEach((link) => {
        try {
          const url = new URL(link.href);
          for (const field of CAMPAIGN_FIELDS) {
            if (attribution[field]) url.searchParams.set(field, attribution[field] as string);
          }
          const type = trafficType();
          if (type !== 'unclassified') url.searchParams.set('aw_traffic', type);
          link.href = url.toString();
        } catch {
          // Keep the original link intact.
        }
      });
  }

  function trafficType(): string {
    try {
      return sessionStorage.getItem(TRAFFIC_KEY) || cleanValue(DEPLOYMENT_TRAFFIC_TYPE, 30) || 'unclassified';
    } catch {
      return cleanValue(DEPLOYMENT_TRAFFIC_TYPE, 30) || 'unclassified';
    }
  }

  function track(name: string, parameters: Record<string, unknown> = {}) {
    try {
      gtag('event', name, {
        ...captureAttribution(),
        traffic_type: trafficType(),
        page_location: `${window.location.origin}${window.location.pathname}`,
        page_path: window.location.pathname,
        ...parameters,
      });
    } catch {
      // Measurement must never interfere with navigation or site behaviour.
    }
  }

  function loadLinkedInInsight() {
    if (!LI_PARTNER_ID || document.getElementById('li-insight-script')) return;

    (window as any)._linkedin_partner_id = LI_PARTNER_ID;
    (window as any)._linkedin_data_partner_ids = (window as any)._linkedin_data_partner_ids || [];
    (window as any)._linkedin_data_partner_ids.push(LI_PARTNER_ID);

    if (!(window as any).lintrk) {
      (window as any).lintrk = function (a: any, b: any) {
        (window as any).lintrk.q.push([a, b]);
      };
      (window as any).lintrk.q = [];
    }

    const script = document.createElement('script');
    script.id = 'li-insight-script';
    script.async = true;
    script.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
    document.head.appendChild(script);
  }

  function loadAdSense() {
    if (document.getElementById('adsense-script')) return;

    const script = document.createElement('script');
    script.id = 'adsense-script';
    script.async = true;
    script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6275306310835906';
    script.crossOrigin = 'anonymous';
    document.head.appendChild(script);
  }

  function loadGA4() {
    if (!GA_ID || document.getElementById('ga4-script')) return;

    const script = document.createElement('script');
    script.id = 'ga4-script';
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    (window as any).gtag = gtag;

    gtag('js', new Date());
    gtag('config', GA_ID, {
      send_page_view: false, // we send manually with enriched data
      cookie_flags: 'SameSite=Lax;Secure',
    });

    // Send enriched page view
    sendPageView();
    decorateCvLinks();

    // Document/window-level listeners (sentinel-guarded, registered once)
    trackScrollDepth();
    trackReadingTime();
    readingTimeStart();
    trackOutboundClicks();
    trackCopyEvents();
    trackPageTiming();

    // Content/navigation trackers — delegated on document, registered once (VT-safe)
    trackContentClicks();
    trackAudioPlayback();
    trackCompletionEvents();
  }

  // --- Environment helpers ---

  function classifyScreen(): { type: string; bucket: string } {
    const w = window.innerWidth;
    if (w < 640) return { type: 'mobile', bucket: '<640' };
    if (w < 1024) return { type: 'tablet', bucket: '640-1023' };
    if (w < 1440) return { type: 'desktop', bucket: '1024-1439' };
    return { type: 'desktop', bucket: '1440+' };
  }

  function getConnectionType(): string {
    const nav = navigator as any;
    if (nav.connection) {
      return nav.connection.effectiveType || nav.connection.type || 'unknown';
    }
    return 'unknown';
  }

  // --- Page view with custom dimensions ---

  function sendPageView() {
    const path = window.location.pathname;
    const contentType = getContentType(path);
    const tags = getPageTags();
    const theme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
    const referrerType = classifyReferrer();

    const screen = classifyScreen();
    const connection = getConnectionType();

    track('page_view', {
      page_path: path,
      page_title: document.title,
      content_type: contentType,
      content_tags: tags.join(','),
      theme: theme,
      referrer_type: referrerType,
      // Demographics / environment
      user_language: navigator.language || '',
      user_timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
      device_type: screen.type,
      screen_bucket: screen.bucket,
      connection_type: connection,
      is_touch: 'ontouchstart' in window || navigator.maxTouchPoints > 0 ? 'true' : 'false',
    });
  }

  function getContentType(path: string): string {
    if (path === '/') return 'home';
    if (path.startsWith('/blog/tag/')) return 'tag_page';
    if (path === '/blog/' || path === '/blog') return 'blog_index';
    if (path.startsWith('/blog/')) return 'blog_post';
    if (path === '/projects/' || path === '/projects') return 'project_index';
    if (path.startsWith('/projects/')) return 'project';
    if (path === '/gallery/' || path === '/gallery') return 'gallery_index';
    if (path.startsWith('/gallery/')) return 'gallery';
    if (path === '/audio/' || path === '/audio') return 'audio_index';
    if (path.startsWith('/audio/')) return 'audio';
    if (path === '/services/' || path === '/services') return 'services';
    if (path === '/contact/' || path === '/contact') return 'contact';
    if (path.startsWith('/about')) return 'about';
    return 'other';
  }

  function getPageTags(): string[] {
    const tagEls = document.querySelectorAll('[data-tag]');
    return Array.from(tagEls)
      .map((el) => (el as HTMLElement).dataset.tag || '')
      .filter(Boolean);
  }

  function classifyReferrer(): string {
    const ref = document.referrer;
    if (!ref) return 'direct';
    try {
      const host = new URL(ref).hostname;
      if (host.includes('google')) return 'search';
      if (host.includes('bing')) return 'search';
      if (host.includes('duckduckgo')) return 'search';
      if (host.includes('twitter') || host.includes('x.com')) return 'social';
      if (host.includes('linkedin')) return 'social';
      if (host.includes('facebook')) return 'social';
      if (host.includes('reddit')) return 'social';
      if (host.includes('github')) return 'developer';
      if (host.includes('adrianwedd')) return 'internal';
      return 'referral';
    } catch {
      return 'unknown';
    }
  }

  // --- Scroll depth ---
  // Registered once on window (sentinel-guarded). Resets milestones per page via trackScrollDepthReset().

  let scrollTracked = new Set<number>();
  let maxScrollDepth = 0;
  let articleEngagedSent = false;

  function maybeTrackArticleEngaged() {
    const contentType = getContentType(window.location.pathname);
    const seconds = (window as any).__readingMax || 0;
    if (
      !articleEngagedSent &&
      ['blog_post', 'project'].includes(contentType) &&
      maxScrollDepth >= 75 &&
      seconds >= 60
    ) {
      articleEngagedSent = true;
      track('article_engaged', { content_type: contentType, depth: maxScrollDepth, seconds });
    }
  }

  function trackScrollDepth() {
    const root = document.documentElement;
    if (root.dataset.scrollDepthInit) return;
    root.dataset.scrollDepthInit = '1';

    const milestones = [25, 50, 75, 100];

    window.addEventListener(
      'scroll',
      () => {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight <= 0) return;
        const pct = Math.round((window.scrollY / docHeight) * 100);
        maxScrollDepth = Math.max(maxScrollDepth, Math.min(pct, 100));
        for (const m of milestones) {
          if (pct >= m && !scrollTracked.has(m)) {
            scrollTracked.add(m);
            track('scroll_depth', {
              depth: m,
              content_type: getContentType(window.location.pathname),
            });
          }
        }
        maybeTrackArticleEngaged();
      },
      { passive: true },
    );
  }

  function trackScrollDepthReset() {
    scrollTracked = new Set<number>();
    maxScrollDepth = 0;
    articleEngagedSent = false;
  }

  // --- Reading time ---
  // Registered once (sentinel-guarded). Clears interval on navigation via readingTimeCleanup().

  let readingInterval: ReturnType<typeof setInterval> | null = null;

  function trackReadingTime() {
    const root = document.documentElement;
    if (root.dataset.readingTimeInit) return;
    root.dataset.readingTimeInit = '1';

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') readingTimeSend();
    });
  }

  function readingTimeStart() {
    readingTimeCleanup();
    const contentType = getContentType(window.location.pathname);
    if (!['blog_post', 'project', 'about'].includes(contentType)) return;

    const start = Date.now();
    (window as any).__readingStart = start;
    (window as any).__readingMax = 0;
    (window as any).__readingType = contentType;

    readingInterval = setInterval(() => {
      const elapsed = Math.round((Date.now() - start) / 1000);
      if (elapsed > ((window as any).__readingMax || 0)) (window as any).__readingMax = elapsed;
      maybeTrackArticleEngaged();
    }, 1000);
  }

  function readingTimeSend() {
    if (readingInterval) clearInterval(readingInterval);
    readingInterval = null;
    const max = (window as any).__readingMax || 0;
    const contentType = (window as any).__readingType || '';
    if (max >= 60) {
      track('engaged_time', {
        seconds: max,
        content_type: contentType,
        page_path: window.location.pathname,
      });
    }
    (window as any).__readingMax = 0;
  }

  function readingTimeCleanup() {
    if (readingInterval) clearInterval(readingInterval);
    readingInterval = null;
  }

  // --- Outbound clicks ---
  // Single document listener, registered once (sentinel-guarded).

  function trackOutboundClicks() {
    const root = document.documentElement;
    if (root.dataset.outboundInit) return;
    root.dataset.outboundInit = '1';

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      try {
        const url = new URL(link.href);
        if (url.hostname !== window.location.hostname) {
          const destination = safeLocation(link.href);
          track('outbound_click', {
            link_path: destination.path,
            link_domain: destination.domain,
          });
        }
      } catch {
        /* relative URLs, javascript:, etc */
      }
    });
  }

  // --- Copy events (content engagement signal) ---
  // Single document listener, registered once (sentinel-guarded).

  function trackCopyEvents() {
    const root = document.documentElement;
    if (root.dataset.copyInit) return;
    root.dataset.copyInit = '1';

    document.addEventListener('copy', () => {
      track('copy_text', {
        page_path: window.location.pathname,
        content_type: getContentType(window.location.pathname),
      });
    });
  }

  // --- Content & navigation clicks ---
  // Single delegated document listener, registered once (sentinel-guarded).
  // Event delegation means new DOM after a View Transitions swap is covered
  // without re-binding — no listener stacking on persisted/re-rendered nodes.
  // Multiple blocks can match a single click (e.g. a project link that also
  // carries data-tag) and each fires independently, matching the prior
  // per-element behaviour.

  function trackContentClicks() {
    const root = document.documentElement;
    if (root.dataset.contentClicksInit) return;
    root.dataset.contentClicksInit = '1';

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest('a[href]') as HTMLAnchorElement | null;

      if (link) {
        const href = link.getAttribute('href') || '';
        const destination = safeLocation(link.href);
        const contentType = getContentType(window.location.pathname);
        const fromContent = ['blog_post', 'project'].includes(contentType);

        if (href.startsWith('mailto:')) {
          track('contact_intent', { contact_method: 'email', source_content_type: contentType });
        } else if (href.startsWith('tel:')) {
          track('contact_intent', { contact_method: 'phone', source_content_type: contentType });
        } else if (href === '#booking-widget' || href.endsWith('/contact/#booking-widget')) {
          track('booking_intent', { source_content_type: contentType });
        }

        if (destination.domain === 'cv.adrianwedd.com' || destination.domain === 'adrianwedd.github.io') {
          track('cv_view', { destination_domain: destination.domain });
        }

        if (
          (destination.path === '/services/' || destination.path === '/contact/') &&
          (fromContent || contentType === 'other')
        ) {
          track('high_intent_transition', {
            from_content_type: contentType,
            destination_path: destination.path,
          });
        }

        if (href.toLowerCase().endsWith('.pdf') || link.hasAttribute('download')) {
          track('file_download', {
            file_path: destination.path,
            file_type: destination.path.split('.').pop() || 'unknown',
          });
        }

        if (
          destination.domain !== window.location.hostname &&
          ['blog_post', 'project'].includes(contentType) &&
          !href.startsWith('mailto:') &&
          !href.startsWith('tel:')
        ) {
          track('project_outbound_click', {
            destination_domain: destination.domain,
            destination_path: destination.path,
            source_content_type: contentType,
          });
        }
      }

      // Project clicks
      const projectLink = target.closest('a[href*="/projects/"]') as HTMLAnchorElement | null;
      if (projectLink) {
        track('project_click', {
          project_name: projectLink.textContent?.trim() || 'unknown',
          link_path: safeLocation(projectLink.href).path,
        });
      }

      // Gallery views
      const galleryTrigger = target.closest('.gallery-trigger') as HTMLElement | null;
      if (galleryTrigger) {
        track('gallery_view', {
          image_index: galleryTrigger.dataset.index,
          collection: window.location.pathname,
        });
      }

      // Tag filters
      const tagEl = target.closest('[data-tag]') as HTMLElement | null;
      if (tagEl) {
        track('tag_filter', {
          tag: tagEl.dataset.tag,
          page_path: window.location.pathname,
        });
      }

      // Theme switches — read state after the toggle fires
      if (target.closest('.theme-toggle')) {
        setTimeout(() => {
          const theme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
          track('theme_switch', { theme });
        }, 50);
      }
    });
  }

  // --- Content: audio playback ---
  // play/timeupdate don't bubble, so delegate in the capture phase on document.
  // Per-element dedupe state is keyed by the element (WeakSet/WeakMap) so it
  // survives VT swaps correctly and never double-fires on a persisted <audio>.

  function trackAudioPlayback() {
    const root = document.documentElement;
    if (root.dataset.audioPlaybackInit) return;
    root.dataset.audioPlaybackInit = '1';

    const started = new WeakSet<HTMLAudioElement>();
    const milestones = new WeakMap<HTMLAudioElement, Set<number>>();

    document.addEventListener(
      'play',
      (e) => {
        const el = e.target as HTMLAudioElement;
        if (el.tagName !== 'AUDIO' || started.has(el)) return;
        started.add(el);
        track('audio_play', {
          audio_path: safeLocation(el.src).path,
        });
      },
      true,
    );

    document.addEventListener(
      'timeupdate',
      (e) => {
        const el = e.target as HTMLAudioElement;
        if (el.tagName !== 'AUDIO' || !el.duration) return;
        let set = milestones.get(el);
        if (!set) {
          set = new Set<number>();
          milestones.set(el, set);
        }
        const pct = Math.round((el.currentTime / el.duration) * 100);
        for (const m of [25, 50, 75, 100]) {
          if (pct >= m && !set.has(m)) {
            set.add(m);
            track('audio_progress', {
              audio_path: safeLocation(el.src).path,
              progress: m,
            });
          }
        }
      },
      true,
    );
  }

  // --- Performance: page timing ---
  // Only meaningful on initial page load (window.load doesn't fire after VT swap).

  function trackPageTiming() {
    if (!('performance' in window)) return;

    const root = document.documentElement;
    if (root.dataset.pageTimingInit) return;
    root.dataset.pageTimingInit = '1';

    window.addEventListener('load', () => {
      setTimeout(() => {
        const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming;
        if (!nav) return;

        track('page_timing', {
          dns_ms: Math.round(nav.domainLookupEnd - nav.domainLookupStart),
          tcp_ms: Math.round(nav.connectEnd - nav.connectStart),
          ttfb_ms: Math.round(nav.responseStart - nav.requestStart),
          dom_interactive_ms: Math.round(nav.domInteractive - nav.startTime),
          dom_complete_ms: Math.round(nav.domComplete - nav.startTime),
          load_ms: Math.round(nav.loadEventEnd - nav.startTime),
          transfer_bytes: nav.transferSize || 0,
        });
      }, 100);
    });
  }

  // Contact scripts emit these only after their APIs confirm success. Keeping
  // analytics out of those workflows means a blocked/broken tracker cannot
  // affect submission or booking behaviour.
  function trackCompletionEvents() {
    const root = document.documentElement;
    if (root.dataset.analyticsCompletionInit) return;
    root.dataset.analyticsCompletionInit = '1';
    document.addEventListener('analytics:enquiry-success', () => track('enquiry_submit'));
    document.addEventListener('analytics:booking-success', () => track('booking_complete'));
  }

  // --- Init ---

  function initAnalytics() {
    const consent = getConsent();
    if (consent?.analytics) {
      loadGA4();
    }
    if (consent?.advertising) {
      loadLinkedInInsight();
      loadAdSense();
    }
  }

  initAnalytics();

  // Re-run page-specific state after a View Transitions DOM swap.
  // All listeners (document/window-level and the delegated content/audio
  // trackers) are sentinel-guarded and registered once — only per-page state
  // (reading time, scroll milestones, page view) needs refreshing here.
  if (!(document.documentElement as any).dataset.analyticsSwapInit) {
    (document.documentElement as any).dataset.analyticsSwapInit = '1';
    document.addEventListener('astro:after-swap', () => {
      const consent = getConsent();
      // Ad scripts are gated on advertising consent only — never on analytics.
      if (consent?.advertising) {
        loadAdSense();
      }
      if (consent?.analytics && typeof (window as any).gtag === 'function') {
        // Flush reading time for previous page, start fresh for new page
        readingTimeSend();
        readingTimeStart();

        // Reset scroll milestones for new page
        trackScrollDepthReset();

        // Send new page view
        sendPageView();
        decorateCvLinks();

        // Content/audio trackers are document-delegated and sentinel-guarded
        // (registered once in loadGA4) — no per-element re-binding needed here.
      }
    });
  } // end analyticsSwapInit sentinel

  window.addEventListener('consent-updated', ((e: CustomEvent<ConsentState>) => {
    if (e.detail.analytics) {
      loadGA4();
    }
    if (e.detail.advertising) {
      loadLinkedInInsight();
      loadAdSense();
    }
  }) as EventListener);
</script>
