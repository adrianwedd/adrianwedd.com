{
  "name": "adrianwedd-com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og-images.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "fetch-analytics": "node scripts/fetch-ga4-data.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{astro,ts,tsx,css,md,mdx}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,tsx,css,md,mdx}'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/preact": "^5.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@google-analytics/data": "^5.2.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.2",
    "preact": "^10.29.1",
    "satori": "^0.26.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": ">=5.0.0 <6.0.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^7.1.0",
    "pagefind": "^1.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
