{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    // "node" types back the `node:crypto` imports (auth.ts, cron/comments.ts);
    // the runtime side is provided by the nodejs_compat compatibility flag.
    "types": ["@cloudflare/workers-types", "node"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts"]
}
